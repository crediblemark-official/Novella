# Standalone production image for Redaksi Workspace (panel.novella.id)
FROM oven/bun:1 AS builder
WORKDIR /app

ENV HUSKY=0
ARG PUBLIC_API_BASE=https://novella.id/api
ENV PUBLIC_API_BASE=${PUBLIC_API_BASE}

COPY package.json bun.lock ./
COPY apps/frontend/package.json ./apps/frontend/
COPY apps/backend/package.json ./apps/backend/
COPY apps/katalog/package.json ./apps/katalog/
COPY apps/panel/package.json ./apps/panel/

RUN bun install --frozen-lockfile || bun install

COPY apps/panel ./apps/panel
RUN cd apps/panel && bun run build

FROM nginx:alpine AS runner
COPY --from=builder /app/apps/panel/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
