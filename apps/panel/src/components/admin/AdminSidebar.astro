---
/**
 * AdminSidebar: Docked Desktop Sidebar & Mobile Slide-Over Drawer untuk Workspace Redaksi.
 * Menggantikan tampilan tab web publik dengan navigasi aplikasi kerja (full-viewport).
 */
const navItems = [
  { id: 'orders', label: 'Pesanan', icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01' },
  { id: 'books', label: 'Katalog', icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253' },
  { id: 'authors', label: 'Penulis', icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z' },
  { id: 'testimonials', label: 'Testimoni', icon: 'M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z' },
  { id: 'brand', label: 'Brand Guideline', icon: 'M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01' },
  { id: 'settings', label: 'Pengaturan', icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z' },
];
---

<!-- Desktop Docked Sidebar -->
<aside class="hidden lg:flex lg:flex-col w-60 shrink-0 border-r border-slate-200 bg-white sticky top-0 h-screen select-none">
  <div class="h-14 px-4 border-b border-slate-200 flex items-center justify-between gap-2">
    <a href="/" class="flex items-center gap-2">
      <img src="/images/logo.png" alt="Novella.id" class="h-6 w-auto object-contain" />
      <span class="rounded bg-slate-100 border border-slate-200 px-1.5 py-0.5 font-mono text-[10px] font-bold tracking-wider text-slate-600">REDAKSI</span>
    </a>
  </div>

  <nav class="flex-1 p-3 space-y-1 overflow-y-auto" aria-label="Navigasi Workspace Redaksi">
    {navItems.map((item, idx) => (
      <button
        type="button"
        data-main-tab={item.id}
        data-tab-label={item.label}
        class={`admin-main-tab flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-xs transition-colors cursor-pointer ${idx === 0 ? 'bg-navy text-white font-bold' : 'text-slate-600 font-semibold hover:bg-slate-100 hover:text-navy'}`}
      >
        <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
        </svg>
        <span>{item.label}</span>
      </button>
    ))}
  </nav>

  <div class="p-3 border-t border-slate-200 space-y-2">
    <div class="flex items-center gap-2 px-2 py-1.5 rounded-lg bg-slate-50 border border-slate-200/70">
      <span class="h-2 w-2 rounded-full bg-emerald-500 shrink-0"></span>
      <span id="admin-identity-label" class="text-[11px] font-bold text-navy truncate">Staf Redaksi</span>
    </div>
    <div class="grid grid-cols-2 gap-1.5">
      <a href="https://novella.id/portal" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center rounded-lg border border-slate-200 bg-white py-1.5 text-[11px] font-bold text-slate-600 hover:text-navy hover:bg-slate-50 transition-colors">Portal ↗</a>
      <button type="button" data-admin-logout class="flex items-center justify-center rounded-lg border border-rose-200 bg-rose-50 py-1.5 text-[11px] font-bold text-rose-700 hover:bg-rose-100 transition-colors cursor-pointer">Keluar</button>
    </div>
  </div>
</aside>

<!-- Mobile Slide-Over Drawer -->
<div id="admin-mobile-drawer" class="fixed inset-0 z-50 hidden lg:hidden">
  <div id="admin-drawer-backdrop" class="fixed inset-0 bg-slate-900/40 backdrop-blur-[1px]"></div>
  <div class="relative flex w-64 max-w-[80vw] h-full flex-col justify-between bg-white border-r border-slate-200 shadow-xl">
    <div>
      <div class="h-14 px-4 border-b border-slate-200 flex items-center justify-between">
        <span class="font-extrabold text-sm text-navy tracking-tight">Redaksi Novella</span>
        <button id="btn-close-drawer" type="button" class="flex h-9 w-9 items-center justify-center rounded-lg text-slate-500 hover:bg-slate-100 cursor-pointer" aria-label="Tutup menu">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>
      <nav class="p-3 space-y-1">
        {navItems.map((item, idx) => (
          <button
            type="button"
            data-main-tab={item.id}
            data-tab-label={item.label}
            class={`admin-main-tab flex w-full items-center gap-2.5 rounded-lg px-3 py-2.5 text-xs transition-colors cursor-pointer ${idx === 0 ? 'bg-navy text-white font-bold' : 'text-slate-600 font-semibold hover:bg-slate-100 hover:text-navy'}`}
          >
            <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
            </svg>
            <span>{item.label}</span>
          </button>
        ))}
      </nav>
    </div>
    <div class="p-3 border-t border-slate-200 space-y-2">
      <button type="button" data-admin-logout class="w-full rounded-lg border border-rose-200 bg-rose-50 py-2 text-xs font-bold text-rose-700 hover:bg-rose-100 cursor-pointer">Keluar</button>
    </div>
  </div>
</div>
