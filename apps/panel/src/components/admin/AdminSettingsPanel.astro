---
/**
 * AdminSettingsPanel: Full-Width Edge-to-Edge 2-Kolom Hairline Settings Workspace
 */
---

<div id="panel-settings" class="admin-panel hidden w-full">
  <form id="admin-settings-form" class="grid lg:grid-cols-12 divide-y lg:divide-y-0 lg:divide-x divide-slate-200 border-b border-slate-200 bg-white">
    <!-- Kolom Kiri: Identitas & Kontak Redaksi (6 Kolom) -->
    <div class="lg:col-span-6 p-5 sm:p-6 space-y-4">
      <div class="border-b border-slate-100 pb-3">
        <h2 class="text-xs font-extrabold uppercase tracking-wider text-slate-600">Kontak & Identitas Redaksi</h2>
      </div>

      <div>
        <label for="set-admin-wa" class="block text-xs font-bold text-navy mb-1">WhatsApp Resmi CS</label>
        <input
          id="set-admin-wa"
          type="text"
          placeholder="6289629625458"
          class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 font-mono text-xs font-semibold text-navy focus:border-navy focus:outline-none"
        />
        <p class="mt-1 text-[11px] text-slate-500">Format internasional diawali 62 tanpa tanda + atau spasi.</p>
      </div>

      <div>
        <label for="set-company-tagline" class="block text-xs font-bold text-navy mb-1">Tagline Situs</label>
        <input
          id="set-company-tagline"
          type="text"
          placeholder="Ruang Tumbuh Penulis Nusantara"
          class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-navy focus:border-navy focus:outline-none"
        />
      </div>

      <div>
        <label for="set-company-address" class="block text-xs font-bold text-navy mb-1">Alamat Kantor Redaksi</label>
        <textarea
          id="set-company-address"
          rows="3"
          placeholder="Jl. Paingan, Maguwoharjo, Depok, Sleman, D.I. Yogyakarta"
          class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-navy focus:border-navy focus:outline-none"
        ></textarea>
      </div>

      <div class="border-t border-slate-100 pt-3 flex justify-end">
        <button
          type="submit"
          class="min-h-[38px] rounded-lg bg-navy px-5 py-2 text-xs font-extrabold text-white hover:bg-slate-800 active:scale-[0.98] transition-all cursor-pointer"
        >
          Simpan
        </button>
      </div>
    </div>

    <!-- Kolom Kanan: Rekening Bank Resmi (6 Kolom) -->
    <div class="lg:col-span-6 p-5 sm:p-6 space-y-4">
      <div class="border-b border-slate-100 pb-3">
        <h2 class="text-xs font-extrabold uppercase tracking-wider text-slate-600">Rekening Bank Pembayaran</h2>
      </div>

      <div id="admin-bank-list" class="divide-y divide-slate-100 border-y border-slate-200/80">
        <p class="text-xs text-slate-500 py-3">Memuat daftar rekening...</p>
      </div>

      <div class="space-y-2.5 pt-1">
        <p class="text-[11px] font-bold text-slate-600">Tambah Rekening Baru</p>
        <div class="grid gap-2 sm:grid-cols-2">
          <input id="new-bank-name" type="text" placeholder="Nama Bank (misal: BCA)" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-medium text-navy focus:border-navy focus:outline-none" />
          <input id="new-bank-number" type="text" placeholder="Nomor Rekening" class="rounded-lg border border-slate-300 bg-white px-3 py-2 font-mono text-xs font-medium text-navy focus:border-navy focus:outline-none" />
        </div>
        <div class="flex gap-2">
          <input id="new-bank-holder" type="text" placeholder="Atas Nama Pemilik Rekening" class="flex-1 min-w-0 rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-medium text-navy focus:border-navy focus:outline-none" />
          <button id="btn-add-bank-row" type="button" class="shrink-0 min-h-[36px] rounded-lg border border-slate-300 bg-slate-50 px-3.5 py-2 text-xs font-bold text-navy hover:bg-slate-100 transition-colors cursor-pointer">+ Tambah</button>
        </div>
      </div>

      <!-- QRIS Statis -->
      <div class="border-t border-slate-200 pt-5 space-y-3">
        <div class="flex items-center justify-between gap-2">
          <div>
            <h3 class="text-xs font-extrabold uppercase tracking-wider text-slate-600">QRIS Statis</h3>
            <p class="text-[11px] text-slate-500 mt-0.5">Unggah gambar QRIS resmi untuk pembayaran instan penulis.</p>
          </div>
          <button id="btn-remove-qris" type="button" class="hidden text-xs font-bold text-rose-600 hover:underline cursor-pointer">Hapus QRIS</button>
        </div>

        <input id="set-qris-url" type="hidden" value="" />
        <input id="set-qris-file" type="file" accept="image/jpeg,image/png,image/webp" class="hidden" />

        <div class="flex flex-wrap items-start gap-4">
          <div
            id="btn-upload-qris"
            role="button"
            tabindex="0"
            class="group relative flex h-32 w-32 shrink-0 items-center justify-center overflow-hidden rounded-xl border border-dashed border-slate-300 bg-slate-50 text-center cursor-pointer hover:border-navy transition-colors"
          >
            <div id="admin-qris-preview" class="flex flex-col items-center justify-center gap-1 p-2 text-slate-400">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
              </svg>
              <span class="text-[10px] font-bold">Unggah QRIS</span>
            </div>
          </div>

          <div class="flex-1 min-w-[180px] space-y-2">
            <label for="set-qris-merchant" class="block text-xs font-bold text-navy">Nama Merchant QRIS</label>
            <input
              id="set-qris-merchant"
              type="text"
              placeholder="Misal: Penerbit Novella Nusantara"
              class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-navy focus:border-navy focus:outline-none"
            />
            <p class="text-[11px] text-slate-500">Klik kotak gambar untuk unggah QRIS (PNG/JPG/WebP), lalu klik <strong>Simpan</strong>.</p>
          </div>
        </div>
      </div>
    </div>
  </form>
</div>
