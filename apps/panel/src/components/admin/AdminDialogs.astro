---
/**
 * AdminDialogs: Modal Desktop (<dialog>) & Bottom-Sheet Mobile untuk Aksi Operasional Redaksi.
 * Menggantikan window.prompt / window.confirm bawaan browser sesuai standar /my-skill.
 */
const dlgCls =
  'm-auto w-[calc(100%-2rem)] max-w-md rounded-2xl border border-slate-200 bg-white p-0 text-left shadow-2xl backdrop:bg-slate-900/45 backdrop:backdrop-blur-[2px] max-sm:fixed max-sm:inset-x-0 max-sm:bottom-0 max-sm:top-auto max-sm:m-0 max-sm:w-full max-sm:max-w-none max-sm:rounded-b-none max-sm:rounded-t-2xl';
---

<!-- 1. Dialog Input / Ubah Resi Pengiriman -->
<dialog id="dlg-tracking" class={dlgCls}>
  <form id="dlg-tracking-form" method="dialog" class="p-5 sm:p-6 space-y-4">
    <div class="mx-auto h-1 w-10 rounded-full bg-slate-200 sm:hidden"></div>
    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
      <div>
        <h3 class="text-sm font-extrabold text-navy">Resi Pengiriman</h3>
        <p id="dlg-tracking-code" class="font-mono text-[11px] font-bold text-slate-500 mt-0.5">-</p>
      </div>
      <button type="button" data-close-dialog="dlg-tracking" class="flex h-8 w-8 items-center justify-center rounded-lg text-slate-400 hover:bg-slate-100 hover:text-navy cursor-pointer" aria-label="Tutup">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <div class="space-y-3">
      <div>
        <label for="dlg-tracking-courier" class="block text-xs font-bold text-navy mb-1">Ekspedisi</label>
        <input id="dlg-tracking-courier" list="courier-presets" type="text" required placeholder="Contoh: J&T Express" class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-xs font-semibold text-navy focus:border-navy focus:outline-none" />
        <datalist id="courier-presets">
          <option value="J&T Express" />
          <option value="JNE" />
          <option value="SiCepat" />
          <option value="Pos Indonesia" />
          <option value="SPX Express" />
          <option value="Indah Cargo" />
        </datalist>
      </div>
      <div>
        <label for="dlg-tracking-number" class="block text-xs font-bold text-navy mb-1">Nomor Resi</label>
        <input id="dlg-tracking-number" type="text" required placeholder="Masukkan nomor resi" class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 font-mono text-xs font-bold tracking-wider text-navy focus:border-navy focus:outline-none" />
      </div>
    </div>

    <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100">
      <button type="button" data-close-dialog="dlg-tracking" class="min-h-[40px] rounded-xl border border-slate-200 bg-white px-4 py-2 text-xs font-bold text-slate-600 hover:bg-slate-50 cursor-pointer">Batal</button>
      <button type="submit" class="min-h-[40px] rounded-xl bg-navy px-5 py-2 text-xs font-extrabold text-white hover:bg-slate-800 active:scale-[0.98] transition-all cursor-pointer">Simpan</button>
    </div>
  </form>
</dialog>

<!-- 2. Dialog Ubah Halaman & Total Biaya Final -->
<dialog id="dlg-pricing" class={dlgCls}>
  <form id="dlg-pricing-form" method="dialog" class="p-5 sm:p-6 space-y-4">
    <div class="mx-auto h-1 w-10 rounded-full bg-slate-200 sm:hidden"></div>
    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
      <div>
        <h3 class="text-sm font-extrabold text-navy">Sesuaikan Biaya & Halaman</h3>
        <p id="dlg-pricing-code" class="font-mono text-[11px] font-bold text-slate-500 mt-0.5">-</p>
      </div>
      <button type="button" data-close-dialog="dlg-pricing" class="flex h-8 w-8 items-center justify-center rounded-lg text-slate-400 hover:bg-slate-100 hover:text-navy cursor-pointer" aria-label="Tutup">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <div class="grid grid-cols-2 gap-3">
      <div>
        <label for="dlg-pricing-pages" class="block text-xs font-bold text-navy mb-1">Jumlah Halaman</label>
        <input id="dlg-pricing-pages" type="number" min="24" max="2000" required class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 font-mono text-xs font-bold text-navy focus:border-navy focus:outline-none" />
      </div>
      <div>
        <label for="dlg-pricing-price" class="block text-xs font-bold text-navy mb-1">Biaya Final (Rp)</label>
        <input id="dlg-pricing-price" type="number" min="0" step="1000" required class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 font-mono text-xs font-bold text-navy focus:border-navy focus:outline-none" />
      </div>
    </div>

    <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100">
      <button type="button" data-close-dialog="dlg-pricing" class="min-h-[40px] rounded-xl border border-slate-200 bg-white px-4 py-2 text-xs font-bold text-slate-600 hover:bg-slate-50 cursor-pointer">Batal</button>
      <button type="submit" class="min-h-[40px] rounded-xl bg-navy px-5 py-2 text-xs font-extrabold text-white hover:bg-slate-800 active:scale-[0.98] transition-all cursor-pointer">Simpan</button>
    </div>
  </form>
</dialog>

<!-- 3. Dialog Konfirmasi Umum (Hapus / Verifikasi) -->
<dialog id="dlg-confirm" class={dlgCls}>
  <div class="p-5 sm:p-6 space-y-4">
    <div class="mx-auto h-1 w-10 rounded-full bg-slate-200 sm:hidden"></div>
    <div>
      <h3 id="dlg-confirm-title" class="text-sm font-extrabold text-navy">Konfirmasi</h3>
      <p id="dlg-confirm-msg" class="mt-1.5 text-xs leading-relaxed text-slate-600">-</p>
    </div>
    <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100">
      <button id="dlg-confirm-cancel" type="button" class="min-h-[40px] rounded-xl border border-slate-200 bg-white px-4 py-2 text-xs font-bold text-slate-600 hover:bg-slate-50 cursor-pointer">Batal</button>
      <button id="dlg-confirm-ok" type="button" class="min-h-[40px] rounded-xl bg-navy px-5 py-2 text-xs font-extrabold text-white hover:bg-slate-800 active:scale-[0.98] transition-all cursor-pointer">Ya</button>
    </div>
  </div>
</dialog>
