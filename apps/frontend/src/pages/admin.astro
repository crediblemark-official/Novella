---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Dashboard Internal Redaksi — Novella.id" activeNav="admin">
  <!-- Auth Checking Spinner (Initial State) -->
  <div id="admin-loading-screen" class="flex min-h-[calc(100vh-64px)] items-center justify-center bg-[#F1F5F9] px-4 py-12">
    <div class="text-center">
      <div class="mx-auto h-10 w-10 animate-spin rounded-full border-4 border-slate-300 border-t-orange"></div>
      <p class="mt-4 text-xs font-bold text-navy">Memverifikasi hak akses staf redaksi...</p>
    </div>
  </div>

  <!-- Admin Auth Guard (Shown when unauthenticated or unauthorized) -->
  <div id="admin-auth-guard" class="hidden min-h-[calc(100vh-64px)] items-center justify-center bg-[#F1F5F9] px-4 py-12 sm:px-6">
    <div class="w-full max-w-md rounded-3xl border border-slate-200/90 bg-white p-7 sm:p-9 shadow-lg">
      <div class="text-center">
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-navy/10 text-navy shadow-inner">
          <svg class="h-7 w-7 text-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        </div>
        <div class="mt-4 inline-flex items-center gap-1.5 rounded-full border border-orange/30 bg-orange/10 px-3 py-0.5 text-[11px] font-extrabold text-orange">
          <span>Area Khusus Staf Redaksi</span>
        </div>
        <h1 class="mt-2 text-xl font-extrabold text-navy sm:text-2xl">Masuk Portal Redaksi</h1>
        <p class="mt-1.5 text-xs leading-relaxed text-slate-500">
          Dashboard manajemen naskah dilindungi secara ketat. Masuk dengan akun redaksi Novella.id untuk memproses pesanan.
        </p>
      </div>

      <!-- Error Message Banner -->
      <div id="auth-error-banner" class="mt-5 hidden rounded-xl border border-rose-200 bg-rose-50 p-3 text-xs font-bold text-rose-700">
        Email atau kata sandi tidak valid.
      </div>

      <!-- Login Form -->
      <form id="admin-login-form" class="mt-5 space-y-4">
        <div>
          <label class="block text-xs font-bold text-navy">Email Staf Redaksi</label>
          <input
            id="admin-email"
            type="email"
            required
            value="admin@novella.id"
            placeholder="admin@novella.id"
            class="mt-1 w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-xs font-semibold text-navy focus:border-navy focus:outline-none"
          />
        </div>

        <div>
          <div class="flex items-center justify-between">
            <label class="block text-xs font-bold text-navy">Kata Sandi Redaksi</label>
          </div>
          <input
            id="admin-password"
            type="password"
            required
            value="AdminNovella2026!"
            placeholder="••••••••••••"
            class="mt-1 w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-xs font-semibold text-navy focus:border-navy focus:outline-none"
          />
        </div>

        <button
          id="btn-admin-submit"
          type="submit"
          class="w-full rounded-full bg-navy py-3 text-xs font-extrabold text-white shadow-md transition-all hover:bg-slate-800 active:scale-[0.99]"
        >
          Masuk ke Dashboard
        </button>

        <!-- Fast Demo Fill Button -->
        <button
          id="btn-fast-demo"
          type="button"
          class="w-full rounded-full border border-slate-200 bg-slate-50 py-2.5 text-xs font-bold text-slate-700 transition-colors hover:bg-slate-100"
        >
          ⚡ Masuk Cepat sebagai Redaksi Demo
        </button>
      </form>

      <!-- Demo Credentials Notice -->
      <div class="mt-6 border-t border-slate-100 pt-4 text-center">
        <p class="text-[11px] text-slate-400">
          Akun Demo Redaksi: <strong class="text-slate-600">admin@novella.id</strong> | Sandi: <strong class="text-slate-600">AdminNovella2026!</strong>
        </p>
        <a href="/" class="mt-3 inline-block text-xs font-bold text-orange hover:underline">
          &larr; Kembali ke Beranda Penulis
        </a>
      </div>
    </div>
  </div>

  <!-- Protected Admin Dashboard Content (Hidden by default until authenticated) -->
  <div id="admin-dashboard-content" class="hidden min-h-[calc(100vh-64px)] bg-[#F1F5F9] px-4 py-8 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <!-- Admin Header with Identity & Logout -->
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full bg-emerald-50 border border-emerald-200 px-3 py-1 text-xs font-bold text-emerald-800">
            <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span id="admin-identity-label">Staf Redaksi Aktif: admin@novella.id</span>
          </div>
          <h1 class="mt-2 text-2xl font-extrabold text-navy sm:text-3xl">Dashboard Manajemen Pesanan</h1>
          <p class="text-xs text-slate-500">Pantau verifikasi naskah sastra, status cetak, dan komunikasi penulis.</p>
        </div>

        <div class="flex items-center gap-2.5">
          <button
            id="btn-refresh-admin"
            type="button"
            class="inline-flex items-center gap-2 rounded-full border border-slate-300 bg-white px-4 py-2 text-xs font-bold text-navy shadow-xs hover:bg-slate-50 transition-colors"
          >
            <svg class="h-3.5 w-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            <span>Segarkan Data</span>
          </button>

          <button
            id="btn-admin-logout"
            type="button"
            class="inline-flex items-center gap-1.5 rounded-full border border-rose-200 bg-rose-50 px-3.5 py-2 text-xs font-extrabold text-rose-700 hover:bg-rose-100 transition-colors"
          >
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
            </svg>
            <span>Keluar</span>
          </button>
        </div>
      </div>

      <!-- KPI Top Bar Metrics -->
      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Total Pesanan Masuk</p>
          <p id="kpi-total-orders" class="mt-2 text-3xl font-extrabold text-navy">...</p>
          <p class="mt-1 text-[11px] text-slate-500">Seluruh pesanan naskah sastra</p>
        </div>

        <div class="rounded-2xl border border-orange/40 bg-orange/5 p-5 shadow-sm">
          <p class="text-xs font-bold uppercase tracking-wider text-orange">Menunggu Verifikasi</p>
          <p id="kpi-waiting-orders" class="mt-2 text-3xl font-extrabold text-orange">...</p>
          <p class="mt-1 text-[11px] text-slate-600">Pesanan butuh verifikasi redaksi</p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Total Nilai Pesanan Aktif</p>
          <p id="kpi-active-value" class="mt-2 text-2xl font-extrabold text-emerald-700 sm:text-3xl">...</p>
          <p class="mt-1 text-[11px] text-slate-500">Di luar pesanan ditarik penulis</p>
        </div>
      </div>

      <!-- Filter Tabs & Search Bar -->
      <div class="mt-8 flex flex-wrap items-center justify-between gap-3">
        <div class="flex flex-wrap items-center gap-1.5 text-xs font-bold">
          <button type="button" data-filter="ALL" class="admin-tab rounded-full bg-navy px-3.5 py-1.5 text-white">Semua</button>
          <button type="button" data-filter="Menunggu Verifikasi" class="admin-tab rounded-full border border-slate-200 bg-white px-3.5 py-1.5 text-slate-600 hover:bg-slate-50">Menunggu Verifikasi</button>
          <button type="button" data-filter="Diproses" class="admin-tab rounded-full border border-slate-200 bg-white px-3.5 py-1.5 text-slate-600 hover:bg-slate-50">Diproses</button>
          <button type="button" data-filter="Selesai" class="admin-tab rounded-full border border-slate-200 bg-white px-3.5 py-1.5 text-slate-600 hover:bg-slate-50">Selesai</button>
          <button type="button" data-filter="Ditarik Penulis" class="admin-tab rounded-full border border-slate-200 bg-white px-3.5 py-1.5 text-slate-600 hover:bg-slate-50">Ditarik Penulis</button>
        </div>

        <div class="w-full sm:w-64">
          <input
            id="admin-search-input"
            type="text"
            placeholder="Cari kode, judul, atau penulis..."
            class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-1.5 text-xs font-medium focus:border-navy focus:outline-none"
          />
        </div>
      </div>

      <!-- Orders Data Grid Table -->
      <div class="mt-4 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="border-b border-slate-200 bg-slate-50/75 text-[11px] font-extrabold uppercase tracking-wider text-slate-500">
              <tr>
                <th class="px-4 py-3.5">Kode</th>
                <th class="px-4 py-3.5">Penulis & Alamat</th>
                <th class="px-4 py-3.5">Judul Buku & Berkas</th>
                <th class="px-4 py-3.5">Spesifikasi & Add-on</th>
                <th class="px-4 py-3.5">Total Biaya</th>
                <th class="px-4 py-3.5">Status Pesanan</th>
                <th class="px-4 py-3.5 text-right">Aksi Cepat</th>
              </tr>
            </thead>
            <tbody id="orders-tbody" class="divide-y divide-slate-100">
              <tr>
                <td colspan="7" class="px-4 py-8 text-center text-slate-400">Memuat data pesanan...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Toast Notification -->
  <div
    id="admin-toast"
    class="fixed bottom-5 right-5 z-50 hidden rounded-xl bg-navy px-4 py-2.5 text-xs font-bold text-white shadow-lg transition-all"
  >
    Pemberitahuan
  </div>

  <script is:inline>
    const API_BASE =
      typeof window !== 'undefined' && window.location.port === '4321'
        ? 'http://localhost:3001/api'
        : '/api';
    const ADMIN_STORAGE_KEY = 'novella_admin_session';

    let allOrders = [];
    let activeFilter = 'ALL';
    let searchQuery = '';
    let currentAdminToken = localStorage.getItem(ADMIN_STORAGE_KEY) || '';

    const loadingScreen = document.getElementById('admin-loading-screen');
    const authGuard = document.getElementById('admin-auth-guard');
    const dashboardContent = document.getElementById('admin-dashboard-content');
    const loginForm = document.getElementById('admin-login-form');
    const authErrorBanner = document.getElementById('auth-error-banner');
    const identityLabel = document.getElementById('admin-identity-label');
    const logoutBtn = document.getElementById('btn-admin-logout');
    const fastDemoBtn = document.getElementById('btn-fast-demo');

    const kpiTotalOrders = document.getElementById('kpi-total-orders');
    const kpiWaitingOrders = document.getElementById('kpi-waiting-orders');
    const kpiActiveValue = document.getElementById('kpi-active-value');
    const ordersTbody = document.getElementById('orders-tbody');
    const adminTabs = document.querySelectorAll('.admin-tab');
    const searchInput = document.getElementById('admin-search-input');
    const refreshBtn = document.getElementById('btn-refresh-admin');

    function showAdminToast(msg) {
      const toast = document.getElementById('admin-toast');
      if (toast) {
        toast.textContent = msg;
        toast.classList.remove('hidden');
        setTimeout(() => toast.classList.add('hidden'), 2500);
      }
    }

    function formatRp(num) {
      return 'Rp ' + Number(num || 0).toLocaleString('id-ID');
    }

    // Check if current user is an authorized admin
    async function checkAdminAuth() {
      try {
        // 1. Verify via admin module
        const headers = { 'Content-Type': 'application/json' };
        if (currentAdminToken) {
          headers['Authorization'] = `Bearer ${currentAdminToken}`;
          headers['x-admin-token'] = currentAdminToken;
        }

        const res = await fetch(`${API_BASE}/admin/verify`, {
          headers,
          credentials: 'include',
        });

        if (res.ok) {
          const data = await res.json();
          if (data.authenticated && data.user) {
            grantAdminAccess(data.user);
            return;
          }
        }
      } catch (err) {
        console.warn('Admin check fallback:', err);
      }

      // If not authenticated as admin, show auth guard
      denyAdminAccess();
    }

    function grantAdminAccess(user) {
      if (loadingScreen) loadingScreen.classList.add('hidden');
      if (authGuard) authGuard.classList.add('hidden');
      if (dashboardContent) dashboardContent.classList.remove('hidden');

      if (identityLabel) {
        identityLabel.textContent = `Staf Redaksi: ${user.name || user.email}`;
      }

      fetchKPI();
      fetchOrders();
    }

    function denyAdminAccess(errorMessage) {
      if (loadingScreen) loadingScreen.classList.add('hidden');
      if (dashboardContent) dashboardContent.classList.add('hidden');
      if (authGuard) {
        authGuard.classList.remove('hidden');
        authGuard.classList.add('flex');
      }

      if (errorMessage && authErrorBanner) {
        authErrorBanner.textContent = errorMessage;
        authErrorBanner.classList.remove('hidden');
      }
    }

    // Admin Login Execution
    async function handleAdminLogin(email, password) {
      const submitBtn = document.getElementById('btn-admin-submit');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Memverifikasi...';
      }
      if (authErrorBanner) authErrorBanner.classList.add('hidden');

      try {
        const res = await fetch(`${API_BASE}/admin/login`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ email, password }),
        });

        const data = await res.json();
        if (res.ok && data.success) {
          currentAdminToken = data.token;
          localStorage.setItem(ADMIN_STORAGE_KEY, data.token);
          grantAdminAccess(data.user);
          showAdminToast('Berhasil masuk sebagai staf redaksi!');
        } else {
          denyAdminAccess(data.error || 'Autentikasi gagal. Periksa kembali email dan sandi redaksi.');
        }
      } catch (err) {
        denyAdminAccess('Tidak dapat terhubung ke server backend.');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Masuk ke Dashboard';
        }
      }
    }

    if (loginForm) {
      loginForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const email = document.getElementById('admin-email').value;
        const password = document.getElementById('admin-password').value;
        handleAdminLogin(email, password);
      });
    }

    if (fastDemoBtn) {
      fastDemoBtn.addEventListener('click', () => {
        document.getElementById('admin-email').value = 'admin@novella.id';
        document.getElementById('admin-password').value = 'AdminNovella2026!';
        handleAdminLogin('admin@novella.id', 'AdminNovella2026!');
      });
    }

    if (logoutBtn) {
      logoutBtn.addEventListener('click', async () => {
        try {
          await fetch(`${API_BASE}/admin/logout`, { method: 'POST', credentials: 'include' });
        } catch {}
        localStorage.removeItem(ADMIN_STORAGE_KEY);
        currentAdminToken = '';
        showAdminToast('Sesi redaksi telah diakhiri.');
        setTimeout(() => {
          location.reload();
        }, 500);
      });
    }

    async function fetchKPI() {
      try {
        const res = await fetch(`${API_BASE}/admin/kpi`);
        if (res.ok) {
          const kpi = await res.json();
          kpiTotalOrders.textContent = String(kpi.totalOrders);
          kpiWaitingOrders.textContent = String(kpi.waitingVerification);
          kpiActiveValue.textContent = formatRp(kpi.totalActiveValue);
        }
      } catch (err) {
        console.error('Failed to fetch KPI', err);
      }
    }

    async function fetchOrders() {
      try {
        const res = await fetch(`${API_BASE}/orders`);
        if (res.ok) {
          allOrders = await res.json();
          renderOrdersTable();
        }
      } catch (err) {
        ordersTbody.innerHTML = `
          <tr>
            <td colspan="7" class="px-4 py-8 text-center text-rose-500 font-bold">
              Gagal memuat data dari server backend. Pastikan server Elysia berjalan.
            </td>
          </tr>
        `;
      }
    }

    function renderOrdersTable() {
      let filtered = allOrders;

      if (activeFilter !== 'ALL') {
        filtered = filtered.filter((o) => o.status === activeFilter);
      }

      if (searchQuery.trim()) {
        const q = searchQuery.toLowerCase();
        filtered = filtered.filter(
          (o) =>
            o.orderCode.toLowerCase().includes(q) ||
            o.authorName.toLowerCase().includes(q) ||
            o.bookTitle.toLowerCase().includes(q) ||
            o.authorPhone.toLowerCase().includes(q)
        );
      }

      if (filtered.length === 0) {
        ordersTbody.innerHTML = `
          <tr>
            <td colspan="7" class="px-4 py-8 text-center text-slate-400">
              Tidak ada pesanan sastra yang sesuai filter.
            </td>
          </tr>
        `;
        return;
      }

      ordersTbody.innerHTML = filtered
        .map((o) => {
          let parsedAddons = [];
          try {
            parsedAddons = JSON.parse(o.addons || '[]');
          } catch {
            parsedAddons = [];
          }

          const isRevoked = o.isRevoked === 1 || o.status === 'Ditarik Penulis';

          // Status Badge / Select
          const statusBg =
            o.status === 'Menunggu Verifikasi'
              ? 'bg-amber-50 text-amber-800 border-amber-200'
              : o.status === 'Diproses'
              ? 'bg-blue-50 text-blue-800 border-blue-200'
              : o.status === 'Selesai'
              ? 'bg-emerald-50 text-emerald-800 border-emerald-200'
              : 'bg-rose-50 text-rose-800 border-rose-200';

          // WhatsApp Follow-up URL
          const waPhone = o.authorPhone.startsWith('0') ? '62' + o.authorPhone.slice(1) : o.authorPhone;
          const waMsg = encodeURIComponent(
            `Halo Kak ${o.authorName}, kami dari tim redaksi Novella.id ingin menindaklanjuti pesanan naskah sastra "${o.bookTitle}" (Kode: ${o.orderCode}). Ada yang bisa kami bantu?`
          );
          const waUrl = `https://wa.me/${waPhone}?text=${waMsg}`;

          return `
            <tr class="hover:bg-slate-50/60 transition-colors">
              <td class="px-4 py-3.5 font-mono font-extrabold text-navy whitespace-nowrap">
                ${o.orderCode}
              </td>
              <td class="px-4 py-3.5">
                <p class="font-extrabold text-navy">${o.authorName}</p>
                <p class="text-[11px] text-slate-500">${o.authorPhone}</p>
                <p class="text-[10px] text-slate-400 truncate max-w-[180px]" title="${o.shippingAddress}">${o.shippingAddress}</p>
              </td>
              <td class="px-4 py-3.5">
                <p class="font-extrabold text-navy">${o.bookTitle}</p>
                <p class="text-[11px] text-slate-500">${o.category}</p>
                <p class="font-mono text-[10px] text-slate-400">[${o.fileOriginalName || 'Naskah'}]</p>
              </td>
              <td class="px-4 py-3.5 text-[11px] text-slate-600">
                <p class="font-semibold">${o.pages} hal · ${o.copies} eks · ${o.bookSize}</p>
                <p class="text-slate-400">Add-on: ${parsedAddons.length ? parsedAddons.join(', ') : '–'}</p>
              </td>
              <td class="px-4 py-3.5 font-extrabold text-navy whitespace-nowrap">
                ${formatRp(o.totalPrice)}
              </td>
              <td class="px-4 py-3.5 whitespace-nowrap">
                ${
                  isRevoked
                    ? `<span class="inline-block rounded-lg border border-rose-200 bg-rose-50 px-2.5 py-1 text-[11px] font-extrabold text-rose-700">Ditarik Penulis</span>`
                    : `
                    <select
                      onchange="window.updateOrderStatus('${o.orderCode}', this.value)"
                      class="rounded-lg border px-2.5 py-1 text-xs font-bold focus:outline-none ${statusBg}"
                    >
                      <option value="Menunggu Verifikasi" ${o.status === 'Menunggu Verifikasi' ? 'selected' : ''}>Menunggu Verifikasi</option>
                      <option value="Diproses" ${o.status === 'Diproses' ? 'selected' : ''}>Diproses</option>
                      <option value="Selesai" ${o.status === 'Selesai' ? 'selected' : ''}>Selesai</option>
                      <option value="Ditarik Penulis" ${o.status === 'Ditarik Penulis' ? 'selected' : ''}>Ditarik Penulis</option>
                    </select>
                  `
                }
              </td>
              <td class="px-4 py-3.5 text-right whitespace-nowrap">
                <div class="flex items-center justify-end gap-1.5">
                  ${
                    isRevoked
                      ? `<span class="inline-flex items-center gap-1 text-[11px] text-rose-400 font-bold" title="Akses berkas ditutup permanen karena status pesanan ditarik penulis">
                          <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                          Naskah Terkunci
                        </span>`
                      : `<a
                          href="${API_BASE}/files/${o.fileName}"
                          target="_blank"
                          class="rounded-lg border border-slate-200 bg-white px-2 py-1 text-[11px] font-bold text-slate-700 hover:bg-slate-100 hover:text-navy transition-colors"
                        >
                          Unduh
                        </a>`
                  }
                  <a
                    href="${waUrl}"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="rounded-lg bg-emerald-600 px-2.5 py-1 text-[11px] font-extrabold text-white hover:bg-emerald-700 transition-colors"
                  >
                    WA Penulis
                  </a>
                </div>
              </td>
            </tr>
          `;
        })
        .join('');
    }

    // Expose update order status to global
    window.updateOrderStatus = async function (orderCode, newStatus) {
      try {
        const res = await fetch(`${API_BASE}/orders/${orderCode}/status`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: newStatus }),
        });

        if (res.ok) {
          showAdminToast(`Status pesanan ${orderCode} diperbarui ke "${newStatus}".`);
          fetchKPI();
          fetchOrders();
        } else {
          const err = await res.json();
          alert(err.error || 'Gagal memperbarui status');
          fetchOrders();
        }
      } catch (err) {
        alert('Gagal menghubungi server');
      }
    };

    // Filter tab listeners
    adminTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        adminTabs.forEach((t) => {
          t.classList.remove('bg-navy', 'text-white');
          t.classList.add('bg-white', 'text-slate-600', 'border', 'border-slate-200');
        });
        tab.classList.remove('bg-white', 'text-slate-600', 'border', 'border-slate-200');
        tab.classList.add('bg-navy', 'text-white');

        activeFilter = tab.getAttribute('data-filter') || 'ALL';
        renderOrdersTable();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value;
        renderOrdersTable();
      });
    }

    if (refreshBtn) {
      refreshBtn.addEventListener('click', () => {
        fetchKPI();
        fetchOrders();
        showAdminToast('Data pesanan disinkronkan kembali.');
      });
    }

    // Start by checking admin authorization
    document.addEventListener('DOMContentLoaded', () => {
      checkAdminAuth();
    });
  </script>
</BaseLayout>
