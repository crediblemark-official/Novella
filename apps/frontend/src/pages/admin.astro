---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdminOrdersPanel from '../components/admin/AdminOrdersPanel.astro';
import AdminSettingsPanel from '../components/admin/AdminSettingsPanel.astro';
import AdminBooksPanel from '../components/admin/AdminBooksPanel.astro';
import AdminTestimonialsPanel from '../components/admin/AdminTestimonialsPanel.astro';
import AdminAuthorsPanel from '../components/admin/AdminAuthorsPanel.astro';
---

<BaseLayout title="Dashboard Internal Redaksi — Novella.id" activeNav="admin">
  <!-- Auth Checking Spinner (Initial State) -->
  <div id="admin-loading-screen" class="flex min-h-[calc(100vh-64px)] items-center justify-center bg-[#F1F5F9] px-4 py-12">
    <div class="text-center">
      <div class="mx-auto h-10 w-10 animate-spin rounded-full border-4 border-slate-300 border-t-orange"></div>
      <p class="mt-4 text-xs font-bold text-navy">Memverifikasi hak akses staf redaksi...</p>
    </div>
  </div>

  <!-- Admin Auth Guard (Protected Login Form) -->
  <div id="admin-auth-guard" class="hidden min-h-[calc(100vh-64px)] items-center justify-center bg-[#F1F5F9] px-4 py-12 sm:px-6">
    <div class="w-full max-w-md rounded-3xl border border-slate-200/90 bg-white p-7 sm:p-9 shadow-lg">
      <div class="text-center">
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-navy/10 text-navy shadow-inner">
          <svg class="h-7 w-7 text-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        </div>
        <div class="mt-4 inline-flex items-center gap-1.5 rounded-full border border-orange/30 bg-orange/10 px-3 py-0.5 text-[11px] font-extrabold text-orange">
          <span>Area Khusus Staf Redaksi</span>
        </div>
        <h1 class="mt-2 text-xl font-extrabold text-navy sm:text-2xl">Masuk Portal Redaksi</h1>
        <p class="mt-1.5 text-xs leading-relaxed text-slate-500">
          Dashboard manajemen naskah dilindungi secara ketat. Masuk dengan akun redaksi Novella.id untuk memproses pesanan.
        </p>
      </div>

      <div id="auth-error-banner" class="mt-5 hidden rounded-xl border border-rose-200 bg-rose-50 p-3 text-xs font-bold text-rose-700">
        Email atau kata sandi tidak valid.
      </div>

      <form id="admin-login-form" class="mt-5 space-y-4">
        <div>
          <label for="admin-email" class="block text-xs font-bold text-navy">Email Staf Redaksi</label>
          <input
            id="admin-email"
            type="email"
            required
            autocomplete="username"
            placeholder="nama@novella.id"
            class="mt-1 w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-xs font-semibold text-navy focus:border-navy focus:outline-none"
          />
        </div>

        <div>
          <label for="admin-password" class="block text-xs font-bold text-navy">Kata Sandi Redaksi</label>
          <input
            id="admin-password"
            type="password"
            required
            autocomplete="current-password"
            placeholder="••••••••••••"
            class="mt-1 w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-xs font-semibold text-navy focus:border-navy focus:outline-none"
          />
        </div>

        <button
          id="btn-admin-submit"
          type="submit"
          class="w-full rounded-full bg-navy py-3 text-xs font-extrabold text-white shadow-md transition-all hover:bg-slate-800 active:scale-[0.99] cursor-pointer"
        >
          Masuk ke Dashboard
        </button>
      </form>

      <div class="mt-6 border-t border-slate-100 pt-4 text-center">
        <a href="/" class="text-xs font-bold text-orange hover:underline">
          &larr; Kembali ke Beranda Penulis
        </a>
      </div>
    </div>
  </div>

  <!-- Protected Admin Dashboard Content -->
  <div id="admin-dashboard-content" class="hidden min-h-[calc(100vh-64px)] bg-[#F1F5F9] px-4 py-8 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <!-- Admin Header with Identity & Logout -->
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full bg-emerald-50 border border-emerald-200 px-3 py-1 text-xs font-bold text-emerald-800">
            <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span id="admin-identity-label">Staf Redaksi Aktif</span>
          </div>
          <h1 class="mt-2 text-2xl font-extrabold text-navy sm:text-3xl">Dashboard Manajemen Redaksi</h1>
          <p class="text-xs text-slate-500">Kelola pesanan naskah, rekening pembayaran, buku terbitan, dan CRM penulis.</p>
        </div>

        <div class="flex items-center gap-2.5">
          <button
            id="btn-refresh-admin"
            type="button"
            class="inline-flex items-center gap-2 rounded-full border border-slate-300 bg-white px-4 py-2 text-xs font-bold text-navy shadow-xs hover:bg-slate-50 transition-colors cursor-pointer"
          >
            <svg class="h-3.5 w-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            <span>Segarkan Data</span>
          </button>

          <button
            id="btn-admin-logout"
            type="button"
            class="inline-flex items-center gap-1.5 rounded-full border border-rose-200 bg-rose-50 px-3.5 py-2 text-xs font-extrabold text-rose-700 hover:bg-rose-100 transition-colors cursor-pointer"
          >
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
            </svg>
            <span>Keluar</span>
          </button>
        </div>
      </div>

      <!-- Main Navigation Tabs -->
      <div class="mt-6 border-b border-slate-200">
        <nav class="-mb-px flex flex-wrap gap-6 text-xs font-bold" id="admin-main-tabs">
          <button type="button" data-main-tab="orders" class="admin-main-tab active border-b-2 border-navy pb-3 text-navy cursor-pointer">📦 Pesanan Naskah</button>
          <button type="button" data-main-tab="settings" class="admin-main-tab border-b-2 border-transparent pb-3 text-slate-500 hover:text-navy cursor-pointer">⚙️ Pengaturan & Rekening</button>
          <button type="button" data-main-tab="books" class="admin-main-tab border-b-2 border-transparent pb-3 text-slate-500 hover:text-navy cursor-pointer">📚 Katalog Buku</button>
          <button type="button" data-main-tab="testimonials" class="admin-main-tab border-b-2 border-transparent pb-3 text-slate-500 hover:text-navy cursor-pointer">💬 Testimoni</button>
          <button type="button" data-main-tab="authors" class="admin-main-tab border-b-2 border-transparent pb-3 text-slate-500 hover:text-navy cursor-pointer">👥 Data Penulis</button>
        </nav>
      </div>

      <!-- Tab Panels -->
      <AdminOrdersPanel />
      <AdminSettingsPanel />
      <AdminBooksPanel />
      <AdminTestimonialsPanel />
      <AdminAuthorsPanel />
    </div>
  </div>

  <!-- Toast Notification -->
  <div
    id="admin-toast"
    class="fixed bottom-5 right-5 z-50 hidden rounded-xl bg-navy px-4 py-2.5 text-xs font-bold text-white shadow-lg transition-all"
  >
    Pemberitahuan
  </div>

  <script>
    import { initAdminController } from '../scripts/admin-controller';
    initAdminController();
  </script>
</BaseLayout>
