---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdminAuthGuard from '../components/admin/AdminAuthGuard.astro';
import AdminSidebar from '../components/admin/AdminSidebar.astro';
import AdminOrdersPanel from '../components/admin/AdminOrdersPanel.astro';
import AdminSettingsPanel from '../components/admin/AdminSettingsPanel.astro';
import AdminBooksPanel from '../components/admin/AdminBooksPanel.astro';
import AdminTestimonialsPanel from '../components/admin/AdminTestimonialsPanel.astro';
import AdminAuthorsPanel from '../components/admin/AdminAuthorsPanel.astro';
import AdminDialogs from '../components/admin/AdminDialogs.astro';
---

<BaseLayout title="Redaksi Workspace — Novella.id" activeNav="admin" showNavbar={false} showFooter={false}>
  <!-- Auth Checking Spinner -->
  <div id="admin-loading-screen" class="flex min-h-screen items-center justify-center bg-slate-50 px-4">
    <div class="text-center">
      <div class="mx-auto h-8 w-8 animate-spin rounded-full border-3 border-slate-300 border-t-navy"></div>
      <p class="mt-3 text-xs font-bold text-slate-500">Memverifikasi sesi staf...</p>
    </div>
  </div>

  <!-- Protected Internal Login Form -->
  <AdminAuthGuard />

  <!-- Full-Width Viewport Admin App Shell -->
  <div id="admin-dashboard-content" class="hidden min-h-screen w-full bg-white flex">
    <AdminSidebar />

    <div class="flex-1 min-w-0 flex flex-col bg-white">
      <!-- Sticky Top Workspace Header (h-14) -->
      <header class="sticky top-0 z-30 h-14 border-b border-slate-200 bg-white/95 backdrop-blur px-4 sm:px-6 flex items-center justify-between gap-3">
        <div class="flex items-center gap-2.5 min-w-0">
          <button
            id="btn-admin-drawer"
            type="button"
            class="lg:hidden flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-slate-200 text-navy hover:bg-slate-50 cursor-pointer"
            aria-label="Buka menu navigasi"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
          <h1 id="admin-topbar-title" class="text-sm font-extrabold text-navy tracking-tight truncate">Pesanan</h1>
        </div>

        <div class="flex items-center gap-2 shrink-0">
          <button
            id="btn-refresh-admin"
            type="button"
            class="inline-flex min-h-[34px] items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-bold text-navy hover:bg-slate-50 transition-colors cursor-pointer"
          >
            <svg class="h-3.5 w-3.5 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            <span class="hidden sm:inline">Segarkan</span>
          </button>
          <button
            type="button"
            data-admin-logout
            class="lg:hidden inline-flex min-h-[34px] items-center rounded-lg border border-rose-200 bg-rose-50 px-2.5 py-1.5 text-xs font-bold text-rose-700 hover:bg-rose-100 cursor-pointer"
          >
            Keluar
          </button>
        </div>
      </header>

      <!-- Workspace Content Canvas (True Full-Width Edge-to-Edge) -->
      <div class="flex-1 w-full">
        <AdminOrdersPanel />
        <AdminSettingsPanel />
        <AdminBooksPanel />
        <AdminTestimonialsPanel />
        <AdminAuthorsPanel />
      </div>
    </div>
  </div>

  <!-- Modals & Mobile Bottom-Sheet Dialogs -->
  <AdminDialogs />

  <!-- Toast Notification -->
  <div
    id="admin-toast"
    class="fixed bottom-5 right-5 z-50 hidden rounded-xl bg-navy px-4 py-2.5 text-xs font-bold text-white shadow-lg transition-all"
  >
    Pemberitahuan
  </div>

  <script>
    import { initAdminController } from '../scripts/admin-controller';
    initAdminController();
  </script>
</BaseLayout>
