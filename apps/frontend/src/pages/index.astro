---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Novella.id — Mitra Penerbitan Karya Sastra Nusantara" activeNav="landing">
  <!-- Hero Section -->
  <section class="mx-auto max-w-5xl px-4 pb-14 pt-12 sm:px-6 sm:pb-20 sm:pt-16">
    <div class="grid items-center gap-10 md:grid-cols-12">
      <div class="space-y-6 md:col-span-7">
        <div class="inline-flex items-center gap-2 rounded-full border border-orange/30 bg-orange/10 px-3.5 py-1 text-xs font-extrabold text-orange">
          <span>Mitra Penerbitan Sastra Nusantara</span>
        </div>
        <h1 class="text-3xl font-extrabold tracking-tight text-navy sm:text-5xl sm:leading-[1.15]">
          Wujudkan Naskah Pertamamu Jadi Buku Nyata.
        </h1>
        <p class="text-sm leading-relaxed text-slate-600 sm:text-base">
          Penerbitan inklusif, ramah, dan transparan untuk pelajar, mahasiswa, ibu rumah tangga, hingga masyarakat akar rumput. Mulai dari <strong class="text-navy">Rp 150.000</strong> untuk 5 eksemplar buku.
        </p>
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <a
            href="/portal"
            class="inline-flex items-center justify-center rounded-full bg-orange px-6 py-3 text-sm font-extrabold text-white shadow-md transition-all hover:bg-orange-hover hover:scale-[1.02] active:scale-[0.98]"
          >
            Terbitkan Sekarang
          </a>
          <a
            href="#cara-kerja"
            class="inline-flex items-center justify-center rounded-full border-2 border-navy px-6 py-3 text-sm font-extrabold text-navy transition-colors hover:bg-navy hover:text-white"
          >
            Cara Kerja
          </a>
        </div>
      </div>

      <!-- Visual Customer Service Showcase -->
      <div class="relative md:col-span-5">
        <div class="relative mx-auto max-w-[320px] rounded-3xl border border-slate-200 bg-white p-3.5 shadow-xl sm:max-w-[360px]">
          <div class="relative aspect-[4/5] w-full overflow-hidden rounded-2xl bg-slate-100 shadow-inner">
            <img
              src="/images/cs-novella.jpg"
              alt="Customer Service Novella.id Ramah dan Profesional"
              class="h-full w-full object-cover object-center"
              loading="eager"
            />
            <!-- Online Status Chip -->
            <div class="absolute top-3 left-3 flex items-center gap-1.5 rounded-full bg-white/90 px-3 py-1 text-[11px] font-extrabold text-navy backdrop-blur shadow-sm">
              <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>CS Redaksi Online</span>
            </div>
            <!-- Bottom Overlay Tag -->
            <div class="absolute bottom-3 inset-x-3 rounded-xl bg-navy/90 p-2.5 text-white backdrop-blur">
              <p class="text-xs font-extrabold">Konsultasi Ramah & Sopan</p>
              <p class="text-[10px] text-slate-300">Siap memandu penulis pemula dari naskah hingga cetak.</p>
            </div>
          </div>
          <div class="mt-3 flex items-center justify-between px-1 text-xs">
            <span class="rounded-full bg-orange/15 px-2.5 py-0.5 font-bold text-orange">Paket Mulai Rp 150rb</span>
            <span class="font-bold text-slate-500">Pendampingan Penuh</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section "Bisa Terbitkan Apa Saja di Sini?" (Sesuai Referensi Gambar) -->
  <section class="border-t border-slate-100 bg-white py-14 sm:py-18">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="rounded-3xl border border-slate-200/80 bg-[#FAFAFC] p-6 sm:p-12 shadow-sm">
        <h2 class="text-2xl font-extrabold text-navy sm:text-3xl tracking-tight">
          Bisa Terbitkan Apa Saja di Sini?
        </h2>
        
        <p class="mt-6 text-base sm:text-xl font-medium leading-relaxed sm:leading-[2.2] text-slate-800">
          Di Novella.id, kamu bisa langsung menerbitkan 
          <span class="inline-flex items-center gap-1.5 rounded-md border border-amber-300 bg-[#FEF3C7] px-2 py-0.5 text-xs sm:text-sm font-bold text-[#92400E] align-baseline whitespace-nowrap shadow-xs">
            <svg class="h-4 w-4 text-[#B45309] inline-block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
            <span>Karya Fiksi</span>
          </span> 
          seperti <strong class="font-extrabold text-[#C25E00] tracking-tight"><span id="typewriter-fiksi">Novel & Cerpen</span><span class="animate-pulse font-normal text-slate-400">|</span></strong>, 
          merangkai 
          <span class="inline-flex items-center gap-1.5 rounded-md border border-indigo-200 bg-[#EEF2FF] px-2 py-0.5 text-xs sm:text-sm font-bold text-[#3730A3] align-baseline whitespace-nowrap shadow-xs">
            <svg class="h-4 w-4 text-[#4F46E5] inline-block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
            </svg>
            <span>Sastra Puitis</span>
          </span> 
          mulai dari <strong class="font-extrabold text-[#3B49DF] tracking-tight"><span id="typewriter-puisi">Antologi Puisi & Syair</span><span class="animate-pulse font-normal text-slate-400">|</span></strong>, 
          mencetak 
          <span class="inline-flex items-center gap-1.5 rounded-md border border-emerald-300 bg-[#DCFCE7] px-2 py-0.5 text-xs sm:text-sm font-bold text-[#166534] align-baseline whitespace-nowrap shadow-xs">
            <svg class="h-4 w-4 text-[#15803D] inline-block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2" />
            </svg>
            <span>Non-Fiksi & Riset</span>
          </span> 
          dengan <strong class="font-extrabold text-[#0D7A53] tracking-tight"><span id="typewriter-nonfiksi">Buku Ajar, Esai & Skripsi</span><span class="animate-pulse font-normal text-slate-400">|</span></strong>, 
          hingga mengabadikan 
          <span class="inline-flex items-center gap-1.5 rounded-md border border-yellow-300 bg-[#FEF9C3] px-2 py-0.5 text-xs sm:text-sm font-bold text-[#854D0E] align-baseline whitespace-nowrap shadow-xs">
            <svg class="h-4 w-4 text-[#A16207] inline-block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7" />
            </svg>
            <span>Memoar & Kisah</span>
          </span> 
          seperti <strong class="font-extrabold text-[#8F3985] tracking-tight"><span id="typewriter-memoar">Catatan Hidup & Resep Warisan</span><span class="animate-pulse font-normal text-slate-400">|</span></strong>, 
          lengkap dengan paket 
          <span class="inline-flex items-center gap-1 rounded-md border border-amber-300 bg-[#FEF3C7] px-2 py-0.5 text-xs sm:text-sm font-extrabold text-[#B45309] align-baseline whitespace-nowrap shadow-xs">
            Mulai 5 Eksemplar
          </span> 
          hanya dalam 
          <span class="inline-flex items-center rounded-md border border-rose-200 bg-[#FFE4E6] px-2 py-0.5 text-xs sm:text-sm font-extrabold text-[#9F1239] align-baseline whitespace-nowrap shadow-xs">
            1 kali alur mudah
          </span>.
        </p>
      </div>
    </div>
  </section>

  <!-- Cara Kerja (3 Langkah Ringkas) -->
  <section id="cara-kerja" class="border-y border-slate-100 bg-[#F1F5F9]/60 py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="text-center">
        <h2 class="text-2xl font-extrabold text-navy sm:text-3xl">Penerbitan Mudah dalam 3 Langkah</h2>
        <p class="mt-2 text-xs text-slate-600 sm:text-sm">Tanpa istilah rumit, tanpa beban biaya tersembunyi.</p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-3">
        <div class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-orange text-sm font-extrabold text-white">1</div>
          <h3 class="mt-4 text-base font-extrabold text-navy">Masuk & Hitung</h3>
          <p class="mt-2 text-xs leading-relaxed text-slate-600">
            Login dengan akun Google dan tentukan sendiri jumlah halaman, eksemplar, serta add-on dengan kalkulator biaya transparan.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-navy text-sm font-extrabold text-white">2</div>
          <h3 class="mt-4 text-base font-extrabold text-navy">Unggah Naskah</h3>
          <p class="mt-2 text-xs leading-relaxed text-slate-600">
            Kirimkan berkas naskah (.pdf, .doc, .docx) karyamu secara aman melalui sistem drag-and-drop berkapasitas hingga 50 MB.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-600 text-sm font-extrabold text-white">3</div>
          <h3 class="mt-4 text-base font-extrabold text-navy">Bayar & Konfirmasi</h3>
          <p class="mt-2 text-xs leading-relaxed text-slate-600">
            Transfer biaya bersahabat ke rekening resmi Novella.id, lalu sapa redaksi kami via WhatsApp otomatis untuk verifikasi cepat.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- [SEMENTARA DI-HIDE UNTUK FASE LAUNCHING]
       Section Karya Terbitan Terbaru dinonaktifkan sementara karena penerbit baru akan launching perdana.
       Dapat diaktifkan kembali setelah judul-judul perdana resmi beredar.
  -->
  {false && (
    <section id="buku-terbit" class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
      <div class="flex items-end justify-between">
        <div>
          <h2 class="text-2xl font-extrabold text-navy sm:text-3xl">Karya Terbitan Terbaru</h2>
          <p class="mt-1 text-xs text-slate-600 sm:text-sm">Buku-buku karya penulis Nusantara yang telah beredar luas.</p>
        </div>
        <a href="/portal" class="text-xs font-bold text-orange hover:underline">Terbitkan Karyamu &rarr;</a>
      </div>

      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white p-4 shadow-sm hover:shadow-md transition-shadow">
          <div class="aspect-[3/4] rounded-xl bg-slate-800 p-4 text-white flex flex-col justify-between">
            <span class="text-[9px] font-extrabold text-orange uppercase">Novel</span>
            <p class="font-literary text-lg font-bold italic">Lembayung Jogja</p>
            <span class="text-[10px] text-slate-400">120 Halaman · A5</span>
          </div>
          <div class="mt-3">
            <h3 class="text-sm font-extrabold text-navy">Lembayung Jogja</h3>
            <p class="text-xs text-slate-500">Budi Santoso (Pegiat Komunitas)</p>
          </div>
        </div>

        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white p-4 shadow-sm hover:shadow-md transition-shadow">
          <div class="aspect-[3/4] rounded-xl bg-amber-950 p-4 text-white flex flex-col justify-between">
            <span class="text-[9px] font-extrabold text-orange uppercase">Kumpulan Cerpen</span>
            <p class="font-literary text-lg font-bold italic">Dapur & Cerita</p>
            <span class="text-[10px] text-slate-400">80 Halaman · A5</span>
          </div>
          <div class="mt-3">
            <h3 class="text-sm font-extrabold text-navy">Dapur & Cerita</h3>
            <p class="text-xs text-slate-500">Siti Rahma (Ibu Rumah Tangga)</p>
          </div>
        </div>

        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white p-4 shadow-sm hover:shadow-md transition-shadow">
          <div class="aspect-[3/4] rounded-xl bg-emerald-950 p-4 text-white flex flex-col justify-between">
            <span class="text-[9px] font-extrabold text-orange uppercase">Antologi Puisi</span>
            <p class="font-literary text-lg font-bold italic">Jejak Langkah</p>
            <span class="text-[10px] text-slate-400">200 Halaman · B5</span>
          </div>
          <div class="mt-3">
            <h3 class="text-sm font-extrabold text-navy">Jejak Langkah</h3>
            <p class="text-xs text-slate-500">Ahmad R. (Pelajar SMA)</p>
          </div>
        </div>

        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white p-4 shadow-sm hover:shadow-md transition-shadow">
          <div class="aspect-[3/4] rounded-xl bg-sky-950 p-4 text-white flex flex-col justify-between">
            <span class="text-[9px] font-extrabold text-orange uppercase">Memoar</span>
            <p class="font-literary text-lg font-bold italic">Kidung Senja</p>
            <span class="text-[10px] text-slate-400">150 Halaman · Unesco</span>
          </div>
          <div class="mt-3">
            <h3 class="text-sm font-extrabold text-navy">Kidung Senja</h3>
            <p class="text-xs text-slate-500">Dewi Anggraini (Mahasiswi)</p>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Testimoni Penulis -->
  <section id="testimoni" class="border-t border-slate-100 bg-[#F1F5F9]/60 py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="text-center">
        <h2 class="text-2xl font-extrabold text-navy sm:text-3xl">Cerita Mereka Bersama Novella.id</h2>
        <p class="mt-1 text-xs text-slate-600 sm:text-sm">Keberanian memulai menerbitkan karya sastra Nusantara.</p>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-3">
        <div class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm">
          <p class="font-literary text-xs italic leading-relaxed text-slate-700">
            "Awalnya ragu apakah puisi tugas sekolah bisa jadi buku cetak rapi. Di Novella.id cuma Rp 150 ribu sudah dapat 5 eksemplar, adminnya ramah banget membantu!"
          </p>
          <div class="mt-5 border-t border-slate-100 pt-3">
            <p class="text-xs font-extrabold text-navy">Ahmad R.</p>
            <p class="text-[11px] text-slate-500">Pelajar SMA, Jakarta</p>
          </div>
        </div>

        <div class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm">
          <p class="font-literary text-xs italic leading-relaxed text-slate-700">
            "Proses mandirinya cepat, kalkulatornya transparan dan ada opsi ISBN resmi. Skripsi sastra saya kini jadi buku ber-ISBN yang bisa disimpan di perpustakaan kampus."
          </p>
          <div class="mt-5 border-t border-slate-100 pt-3">
            <p class="text-xs font-extrabold text-navy">Dewi Anggraini</p>
            <p class="text-[11px] text-slate-500">Mahasiswi Sastra, Yogyakarta</p>
          </div>
        </div>

        <div class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm">
          <p class="font-literary text-xs italic leading-relaxed text-slate-700">
            "Saya seorang ibu rumah tangga yang suka menulis cerita dan resep keluarga. Akhirnya bisa menghadiahkan buku cetak berwujud nyata untuk anak cucu."
          </p>
          <div class="mt-5 border-t border-slate-100 pt-3">
            <p class="text-xs font-extrabold text-navy">Siti Rahma</p>
            <p class="text-[11px] text-slate-500">Ibu Rumah Tangga, Surakarta</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Kutipan Sastra Nusantara & CTA Penutup -->
  <section class="bg-navy py-16 text-center text-white">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <blockquote class="font-literary text-lg font-medium italic sm:text-2xl leading-relaxed text-slate-100">
        “Orang boleh pandai setinggi langit, tapi selama ia tidak menulis, ia akan hilang di dalam masyarakat dan dari sejarah. Menulis adalah bekerja untuk keabadian.”
      </blockquote>
      <p class="mt-4 text-xs font-bold tracking-widest uppercase text-orange">— Pramoedya Ananta Toer</p>

      <div class="mt-10">
        <a
          href="/portal"
          class="inline-flex items-center justify-center rounded-full bg-orange px-8 py-3.5 text-sm font-extrabold text-white shadow-lg transition-all hover:bg-orange-hover hover:scale-105 active:scale-95"
        >
          Mulai Terbitkan Naskahmu Sekarang
        </a>
      </div>
    </div>
  </section>

  <!-- Interactive Typewriter / Rotation Script -->
  <script is:inline>
    (function () {
      function setupTypewriter(elementId, phrases, typeSpeed = 90, deleteSpeed = 45, holdTime = 2400) {
        const el = document.getElementById(elementId);
        if (!el) return;

        let phraseIndex = 0;
        let charIndex = phrases[0].length;
        let isDeleting = false;

        function tick() {
          const currentPhrase = phrases[phraseIndex];

          if (isDeleting) {
            charIndex--;
            el.textContent = currentPhrase.substring(0, charIndex);
          } else {
            charIndex++;
            el.textContent = currentPhrase.substring(0, charIndex);
          }

          let delay = isDeleting ? deleteSpeed : typeSpeed;

          if (!isDeleting && charIndex === currentPhrase.length) {
            delay = holdTime;
            isDeleting = true;
          } else if (isDeleting && charIndex === 0) {
            isDeleting = false;
            phraseIndex = (phraseIndex + 1) % phrases.length;
            delay = 400;
          }

          setTimeout(tick, delay);
        }

        // Start cycling after a staggered initial delay
        const stagger = {
          'typewriter-fiksi': 1200,
          'typewriter-puisi': 2200,
          'typewriter-nonfiksi': 3200,
          'typewriter-memoar': 4200,
        }[elementId] || 1500;

        setTimeout(() => {
          isDeleting = true;
          tick();
        }, stagger);
      }

      document.addEventListener('DOMContentLoaded', () => {
        setupTypewriter('typewriter-fiksi', [
          'Novel & Cerpen',
          'Novelet Fantasi',
          'Roman Sejarah',
          'Kumpulan Cerita Silat',
        ]);

        setupTypewriter('typewriter-puisi', [
          'Antologi Puisi & Syair',
          'Geguritan & Pantun',
          'Haiku & Sajak Bebas',
          'Lirik Kidung Senja',
        ]);

        setupTypewriter('typewriter-nonfiksi', [
          'Buku Ajar, Esai & Skripsi',
          'Monograf Akademik',
          'Diktat Pembelajaran',
          'Kritik Sastra & Budaya',
        ]);

        setupTypewriter('typewriter-memoar', [
          'Catatan Hidup & Resep Warisan',
          'Biografi Tokoh Daerah',
          'Jurnal Perjalanan Nusantara',
          'Kisah Pengabdian Desa',
        ]);
      });
    })();
  </script>
</BaseLayout>
