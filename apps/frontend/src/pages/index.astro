---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Novella.id — Mitra Penerbitan Sastra Nusantara" activeNav="landing">
  <!-- 1. Hero & Paket Dasar Utama -->
  <section class="mx-auto max-w-5xl px-4 pt-10 pb-8 sm:px-6">
    <div class="grid items-center gap-8 md:grid-cols-12">
      <div class="space-y-4 md:col-span-7">
        <span class="inline-flex items-center rounded-full border border-orange/30 bg-orange/10 px-3 py-1 text-xs font-extrabold text-orange">
          Mitra Penerbitan Sastra Nusantara
        </span>
        <h1 class="text-3xl font-extrabold tracking-tight text-navy sm:text-4xl sm:leading-tight">
          Cetak Karyamu Mulai <span class="text-orange">Rp 150.000</span> Dapat 5 Eksemplar.
        </h1>
        <p class="text-sm leading-relaxed text-slate-600">
          Paket dasar maksimal 100 halaman berkualitas toko buku: <strong>Soft Cover Ivory 230/260 gr</strong>, lem binding kuat, bookmark, wrapping, dan packing buku aman.
        </p>
        <div class="flex flex-wrap items-center gap-3 pt-1">
          <a href="/portal" class="rounded-full bg-orange px-6 py-2.5 text-xs font-extrabold text-white shadow-md hover:bg-orange-hover transition-all">
            Hitung & Terbitkan Buku &rarr;
          </a>
          <a href="https://wa.me/6281234567890" target="_blank" rel="noopener noreferrer" class="rounded-full border border-slate-300 bg-white px-5 py-2.5 text-xs font-bold text-slate-700 hover:border-navy hover:text-navy transition-colors">
            Hubungi WhatsApp Redaksi
          </a>
        </div>
      </div>
      <div class="relative md:col-span-5">
        <div class="relative mx-auto max-w-[320px] rounded-3xl border border-slate-200 bg-white p-3 shadow-lg">
          <div class="aspect-[4/3] w-full overflow-hidden rounded-2xl bg-slate-100">
            <img src="/images/cs-novella.jpg" alt="CS Redaksi Novella.id" class="h-full w-full object-cover" />
          </div>
          <div class="mt-3 flex items-center justify-between px-1 text-xs">
            <span class="inline-flex items-center gap-1.5 font-bold text-emerald-700">
              <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span> CS Online & Ramah
            </span>
            <span class="font-bold text-slate-500">Jl. Paingan, Sleman</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Tentang Novella.id (Misi & Manusia Akar Rumput) -->
  <section class="border-t border-slate-100 bg-slate-50/60 py-10">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="max-w-3xl">
        <span class="text-xs font-extrabold uppercase tracking-wider text-orange">TENTANG NOVELLA.ID</span>
        <h2 class="mt-1 text-2xl font-extrabold text-navy tracking-tight">
          Menulis Adalah Hak Kemerdekaan Pikiran Seluruh Rakyat
        </h2>
        <p class="mt-3 text-xs sm:text-sm leading-relaxed text-slate-600">
          Novella.id siap menjadi mitra penerbitan karya sastra terbaik di Nusantara. Membina dan mengarahkan karakter manusia agar berani menjadi penulis. 
          <strong>Pelajar, Mahasiswa, dan Ibu Rumah Tangga</strong> adalah mitra terbesar kami. Mereka menulis bukan semata-mata demi materi, melainkan:
        </p>
      </div>

      <div class="mt-5 grid gap-3 sm:grid-cols-2 md:grid-cols-3 text-xs text-slate-700">
        <div class="rounded-xl border border-slate-200 bg-white p-3 shadow-2xs">
          <p class="font-bold text-navy">1. Membuang Sampah Pikiran</p>
          <p class="mt-1 text-slate-500 text-[11px]">Membebaskan beban mental yang menumpuk di kepala.</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-3 shadow-2xs">
          <p class="font-bold text-navy">2. Katarsis Keresahan Hati</p>
          <p class="mt-1 text-slate-500 text-[11px]">Mengeluarkan unek-unek sebelum merenggut kesehatan.</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-3 shadow-2xs">
          <p class="font-bold text-navy">3. Warisan Sejarah Anak-Cucu</p>
          <p class="mt-1 text-slate-500 text-[11px]">Meninggalkan jejak pemikiran nyata bagi generasi penerus.</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-3 shadow-2xs">
          <p class="font-bold text-navy">4. Menularkan Semangat Hidup</p>
          <p class="mt-1 text-slate-500 text-[11px]">Menebar pelajaran dan inspirasi berharga untuk pembaca.</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-3 shadow-2xs sm:col-span-2 md:col-span-2">
          <p class="font-bold text-navy">5. Mengasah Kecerdasan & Pola Pikir</p>
          <p class="mt-1 text-slate-500 text-[11px]">Menajamkan logika, empati, dan kejernihan bertutur.</p>
        </div>
      </div>

      <p class="mt-4 text-xs italic text-slate-600 bg-amber-50/80 border border-amber-200/80 p-3 rounded-xl">
        “Novella.id menjanjikan harga cetakan buku seharga sempol ayam di kawasan Cafe Malioboro. Anda dapat menghitung harga buku Anda sendiri secara mandiri. Kami paling bersahabat dengan isi dompet masyarakat kelas bawah alias manusia akar rumput.”
      </p>
    </div>
  </section>

  <!-- 3. Tabel Harga Orderan Resmi Novella.id -->
  <section class="border-t border-slate-100 bg-white py-10">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-4 pb-6">
        <div>
          <span class="text-xs font-extrabold uppercase tracking-wider text-orange">TABEL BIAYA TRANSPARAN</span>
          <h2 class="mt-1 text-2xl font-extrabold text-navy tracking-tight">Tarif Cetak & Finishing Resmi</h2>
          <p class="text-xs text-slate-500 mt-0.5">Rumus: Jumlah Halaman × Tarif Ukuran = Harga per Eksemplar.</p>
        </div>
        <a href="/portal" class="rounded-full bg-navy px-4 py-1.5 text-xs font-bold text-white hover:bg-slate-800 transition-colors">
          Buka Kalkulator Mandiri &rarr;
        </a>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <!-- Cetak Black & White (BW) -->
        <div class="rounded-2xl border border-slate-200 p-4 shadow-2xs">
          <h3 class="text-xs font-extrabold uppercase tracking-wider text-navy flex items-center gap-1.5">
            <span class="h-2 w-2 rounded-full bg-slate-900"></span> CETAK BLACK & WHITE (BW)
          </h3>
          <div class="mt-3 divide-y divide-slate-100 text-xs">
            <div class="py-2 flex justify-between"><span>A6 (BP 57/72 · HVS 70/80)</span><span class="font-mono font-bold text-navy">Rp 130 / hal</span></div>
            <div class="py-2 flex justify-between font-bold bg-orange/5 px-2 rounded"><span>A5 / Unesco (BP 57 · HVS 70)</span><span class="font-mono text-orange">Rp 250 / hal (Standar)</span></div>
            <div class="py-2 flex justify-between"><span>A5 / Unesco (BP 72 · HVS 80)</span><span class="font-mono font-bold text-navy">Rp 275 / hal</span></div>
            <div class="py-2 flex justify-between"><span>B5 / A4 (BP 57 · HVS 70)</span><span class="font-mono font-bold text-navy">Rp 400 / hal</span></div>
            <div class="py-2 flex justify-between"><span>B5 / A4 (BP 72 · HVS 80)</span><span class="font-mono font-bold text-navy">Rp 420 / hal</span></div>
          </div>
        </div>

        <!-- Cetak Full Color (FC) -->
        <div class="rounded-2xl border border-slate-200 p-4 shadow-2xs">
          <h3 class="text-xs font-extrabold uppercase tracking-wider text-orange flex items-center gap-1.5">
            <span class="h-2 w-2 rounded-full bg-orange"></span> CETAK FULL COLOR (FC)
          </h3>
          <div class="mt-3 divide-y divide-slate-100 text-xs">
            <div class="py-2 flex justify-between"><span>A6 (BP 57/72 · HVS 70/80)</span><span class="font-mono font-bold text-navy">Rp 350 / hal</span></div>
            <div class="py-2 flex justify-between"><span>A5 / Unesco (HVS 70 - 80)</span><span class="font-mono font-bold text-navy">Rp 520 / hal</span></div>
            <div class="py-2 flex justify-between"><span>A5 / Unesco (BP 57 - 72)</span><span class="font-mono font-bold text-navy">Rp 550 / hal</span></div>
            <div class="py-2 flex justify-between"><span>B5 / A4 (HVS 70 - 80)</span><span class="font-mono font-bold text-navy">Rp 1.050 / hal</span></div>
            <div class="py-2 flex justify-between"><span>B5 / A4 (BP 57 - 72)</span><span class="font-mono font-bold text-navy">Rp 1.100 / hal</span></div>
          </div>
        </div>
      </div>

      <!-- Hard Cover & Add-on Grid -->
      <div class="mt-6 rounded-2xl border border-slate-200 bg-slate-50/50 p-4 text-xs">
        <h3 class="font-extrabold text-navy uppercase text-[11px] tracking-wider">Layanan Tambahan & Finishing</h3>
        <div class="mt-3 grid gap-2 sm:grid-cols-2 md:grid-cols-4">
          <div class="bg-white p-2.5 rounded-xl border border-slate-200/80"><p class="text-slate-500 text-[10px]">E-Sertifikat Penulis</p><p class="font-mono font-bold text-navy mt-0.5">Rp 10.000</p></div>
          <div class="bg-white p-2.5 rounded-xl border border-slate-200/80"><p class="text-slate-500 text-[10px]">Revisi Ringan Cover / Layout</p><p class="font-mono font-bold text-navy mt-0.5">Rp 10.000 / sesi</p></div>
          <div class="bg-white p-2.5 rounded-xl border border-slate-200/80"><p class="text-slate-500 text-[10px]">Cetak 2 Dummy</p><p class="font-mono font-bold text-navy mt-0.5">Rp 200.000</p></div>
          <div class="bg-white p-2.5 rounded-xl border border-slate-200/80"><p class="text-slate-500 text-[10px]">Video Promosi Buku</p><p class="font-mono font-bold text-navy mt-0.5">Rp 250.000</p></div>
          <div class="bg-white p-2.5 rounded-xl border border-slate-200/80"><p class="text-slate-500 text-[10px]">Ebook Tanpa Watermark</p><p class="font-mono font-bold text-navy mt-0.5">Rp 250.000 (Gratis dg WM)</p></div>
          <div class="bg-white p-2.5 rounded-xl border border-slate-200/80"><p class="text-slate-500 text-[10px]">Request Cover Khusus</p><p class="font-mono font-bold text-navy mt-0.5">Rp 500.000</p></div>
          <div class="bg-white p-2.5 rounded-xl border border-slate-200/80"><p class="text-slate-500 text-[10px]">Request Layout Khusus</p><p class="font-mono font-bold text-navy mt-0.5">Rp 1.000.000</p></div>
          <div class="bg-white p-2.5 rounded-xl border border-slate-200/80"><p class="text-slate-500 text-[10px]">Hard Cover (A5 / Unesco / B5)</p><p class="font-mono font-bold text-navy mt-0.5">Mulai Rp 25.000/eks</p></div>
        </div>
        <p class="mt-2.5 text-[10px] text-slate-500 italic">* Jika finishing mengambil Hard Cover, harga per halaman BW diskon Rp 10 dan halaman warna diskon Rp 50.</p>
      </div>
    </div>
  </section>

  <!-- 4. Tahukah Anda & Alamat Resmi Redaksi -->
  <section class="border-t border-slate-100 bg-[#0D1C3D] py-10 text-white">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="grid gap-6 md:grid-cols-12 items-center">
        <div class="md:col-span-7 space-y-2">
          <span class="rounded bg-orange px-2 py-0.5 text-[10px] font-extrabold uppercase text-white">Tahukah Anda?</span>
          <p class="text-sm sm:text-base font-semibold leading-relaxed text-slate-200">
            Penerbit Novella.id sangat mengedepankan <strong>keramahan Customer Servis</strong>, <strong>kecepatan dalam membalas chatting</strong>, dan <strong>kesopanan dalam percakapan telepon</strong>.
          </p>
          <p class="text-xs text-slate-400 pt-1">
            Alamat Kantor: Jl. Paingan (Depan Universitas Sanata Dharma), Krodan, Maguwoharjo, Depok, Sleman, D.I. Yogyakarta.
          </p>
        </div>
        <div class="md:col-span-5 flex flex-col sm:flex-row gap-3 md:justify-end">
          <a href="/portal" class="rounded-full bg-orange px-6 py-3 text-xs font-extrabold text-white text-center shadow-md hover:bg-orange-hover transition-all">
            Buka Portal Penerbitan &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
