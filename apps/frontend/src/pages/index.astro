---
import BaseLayout from "../layouts/BaseLayout.astro";
const showPublicShowcase = false;
---

<BaseLayout
  title="Novella.id — Ruang Tumbuh Penulis Nusantara"
  activeNav="landing"
>
  <!-- Hero Section -->
  <section class="mx-auto max-w-[1088px] px-4 pb-14 pt-12 sm:px-6 sm:pb-20 sm:pt-16">
    <div class="grid items-center gap-10 md:grid-cols-12">
      <div class="space-y-6 md:col-span-7">
        <div class="inline-flex items-center gap-2 rounded-full border border-amber-400/70 bg-amber-50 px-3.5 py-1 text-xs sm:text-sm font-extrabold text-[#B45309]">
          <span id="landing-tagline">Ruang Tumbuh Penulis Nusantara</span>
        </div>
        <h1 class="text-2xl font-extrabold tracking-tight text-navy sm:text-3xl lg:text-[32px] leading-[1.25]">
          <span class="block sm:whitespace-nowrap">
            <span class="animate-underline">Wujudkan</span> Naskahmu Jadi{" "}
            <span class="inline-block rounded-lg bg-navy px-2 py-0.5 text-white">
              Buku Cetak
            </span>
          </span>
          <span class="mt-1 block text-[30px] sm:text-[43px] lg:text-[47.5px] sm:whitespace-nowrap">
            di Penerbit Buku Novella<span class="text-orange">.id</span>
          </span>
        </h1>
        <p class="text-base leading-relaxed text-slate-600">
          Terbit dan cetak buku Karya Sastra seharga sempol di area Cafe
          Malioboro. Mulai dari harga diskon{" "}
          <strong class="text-navy">Rp 150.000</strong> untuk 5 eksemplar buku
          dan sudah termasuk ISBN, Layout &amp; Cover Buku. Dengan transaksi
          yang transparan untuk karya pelajar, mahasiswa, ibu rumah tangga
          hingga masyarakat akar rumput. Penerbit Novella memiliki dukungan
          Customer Servis yang ramah lagi penyabar.
        </p>
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <a
            href="https://wa.me/6289629625458?text=Halo%20CS%20Novella.id%2C%20saya%20ingin%20berkonsultasi%20mengenai%20penerbitan%20naskah."
            data-wa-text="Halo CS Novella.id, saya ingin berkonsultasi mengenai penerbitan naskah."
            target="_blank"
            rel="noopener noreferrer"
            class="dynamic-wa-link inline-flex items-center justify-center rounded-full bg-orange px-6 py-3 text-sm font-extrabold text-white shadow-md transition-all hover:bg-orange-hover hover:scale-[1.02] active:scale-[0.98]"
          >
            Hubungi CS
          </a>
          <a
            href="#cara-kerja"
            class="inline-flex items-center justify-center rounded-full border-2 border-navy px-6 py-3 text-sm font-extrabold text-navy transition-colors hover:bg-navy hover:text-white"
          >
            Cara Kerja
          </a>
        </div>
      </div>

      <!-- Visual Customer Service Showcase -->
      <div class="relative md:col-span-5 -mx-4 sm:mx-0">
        <div class="relative overflow-hidden sm:mx-auto sm:max-w-[360px] rounded-none border-y border-slate-200 bg-white sm:rounded-3xl sm:border sm:shadow-xl">
          <div class="relative aspect-[4/5] w-full overflow-hidden bg-slate-100">
            <img
              src="/images/cs-novella.jpg"
              alt="Customer Service Novella.id Ramah dan Profesional"
              class="h-full w-full object-cover object-center"
              loading="eager"
            />
            <!-- Online Status Chip -->
            <div class="absolute top-3 left-3 flex items-center gap-1.5 rounded-full bg-white/95 px-3 py-1 text-xs sm:text-[13px] font-extrabold text-navy backdrop-blur shadow-sm">
              <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>CS Penerbit Novella.id</span>
            </div>
            <!-- Bottom Overlay Tag -->
            <div class="absolute bottom-3 inset-x-3 rounded-xl bg-navy/95 p-3 text-white backdrop-blur">
              <p class="text-sm sm:text-base font-extrabold">
                Konsultasi Ramah &amp; Sopan
              </p>
              <p class="mt-0.5 text-xs sm:text-[13px] text-white/95 leading-snug">
                Siap melayani penerbitan buku dan membimbing penulisan buku.
              </p>
            </div>
          </div>
          <div class="px-4 py-3 flex items-center justify-between text-[13px] sm:text-sm">
            <span class="rounded-full bg-amber-100/90 px-3 py-0.5 font-extrabold text-[#B45309]">
              Paket Mulai Rp 150rb
            </span>
            <span class="font-bold text-slate-800">Pendampingan Penuh</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section "Bisa Terbitkan Apa Saja di Sini?" (Genre Sastra Modern & Kontemporer) -->
  <section
    class="relative overflow-hidden border-y border-slate-200/80 py-12 sm:py-16 bg-cover bg-center"
    style="background-color: #F6F5F1; background-image: linear-gradient(rgba(255, 255, 255, 0.45), rgba(255, 255, 255, 0.45)), url('/images/paper-bg.jpg');"
  >
    <div class="relative mx-auto max-w-[1088px] px-4 sm:px-6">
      <!-- Stempel Logo -->
      <div
        class="pointer-events-none select-none absolute -bottom-2 right-4 sm:right-6 z-0"
        style="opacity: 0.16; transform: rotate(-12deg);"
        aria-hidden="true"
      >
        <div class="rounded-full border-2 border-dashed border-navy px-4 py-2.5 bg-[#FCF9F2]/80">
          <img
            src="/images/logo.png"
            alt=""
            class="object-contain"
            style="height: 44px; width: auto;"
          />
        </div>
      </div>
      <div class="relative z-10">
      <h2 class="text-2xl font-extrabold text-navy sm:text-3xl tracking-tight">
        Bisa Terbitkan Karya Sastra Apa Saja di Sini?
      </h2>

      <p class="mt-5 text-lg font-medium leading-relaxed sm:leading-[2.3] text-slate-800">
        Di Novella.id, kamu bisa langsung menerbitkan
        <span class="inline-flex items-center gap-1.5 rounded-md border border-amber-300 bg-[#FEF3C7] px-2 py-0.5 text-xs sm:text-sm font-bold text-[#92400E] align-baseline whitespace-nowrap shadow-xs">
          <svg
            class="h-4 w-4 text-[#B45309] inline-block"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
            />
          </svg>
          <span>Fiksi Populer</span>
        </span>
        seperti{" "}
        <strong class="font-extrabold text-[#C25E00] tracking-tight">
          Sci-Fi &amp; Urban Fantasy
        </strong>
        , merangkai
        <span class="inline-flex items-center gap-1.5 rounded-md border border-indigo-200 bg-[#EEF2FF] px-2 py-0.5 text-xs sm:text-sm font-bold text-[#3730A3] align-baseline whitespace-nowrap shadow-xs">
          <svg
            class="h-4 w-4 text-[#4F46E5] inline-block"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"
            />
          </svg>
          <span>Prosa &amp; Puisi</span>
        </span>
        mulai dari{" "}
        <strong class="font-extrabold text-[#3B49DF] tracking-tight">
          Sajak Katarsis &amp; Self-Healing
        </strong>
        , menggarap
        <span class="inline-flex items-center gap-1.5 rounded-md border border-emerald-300 bg-[#DCFCE7] px-2 py-0.5 text-xs sm:text-sm font-bold text-[#166534] align-baseline whitespace-nowrap shadow-xs">
          <svg
            class="h-4 w-4 text-[#15803D] inline-block"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z"
            />
          </svg>
          <span>Skenario &amp; Grafis</span>
        </span>
        dengan{" "}
        <strong class="font-extrabold text-[#0D7A53] tracking-tight">
          Naskah Drama Audio / Podcast
        </strong>
        , hingga mengabadikan
        <span class="inline-flex items-center gap-1.5 rounded-md border border-yellow-300 bg-[#FEF9C3] px-2 py-0.5 text-xs sm:text-sm font-bold text-[#854D0E] align-baseline whitespace-nowrap shadow-xs">
          <svg
            class="h-4 w-4 text-[#A16207] inline-block"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"
            />
          </svg>
          <span>Esai &amp; Memoar</span>
        </span>
        seperti{" "}
        <strong class="font-extrabold text-[#8F3985] tracking-tight">
          Antologi Cerita Komunitas
        </strong>
        , lengkap dengan paket
        <span class="inline-flex items-center gap-1 rounded-md border border-amber-300 bg-[#FEF3C7] px-2 py-0.5 text-xs sm:text-sm font-extrabold text-[#B45309] align-baseline whitespace-nowrap shadow-xs">
          Mulai 5 Eksemplar
        </span>
        hanya dalam
        <span class="inline-flex items-center rounded-md border border-rose-200 bg-[#FFE4E6] px-2 py-0.5 text-xs sm:text-sm font-extrabold text-[#9F1239] align-baseline whitespace-nowrap shadow-xs">
          1 kali alur mudah
        </span>
        .
      </p>
      </div>
    </div>
  </section>

  <!-- Section Cara Kerja (3 Langkah Simetris Sesuai Alur Konsultasi WhatsApp) -->
  <section
    id="cara-kerja"
    class="bg-white py-14 sm:py-20 overflow-hidden border-t border-slate-100"
  >
    <div class="mx-auto max-w-[1088px] px-4 sm:px-6">
      <div class="pb-8">
        <div>
          <span class="inline-flex items-center rounded-xl border border-amber-300 bg-[#FFFDF5] px-3.5 py-1.5 text-xs font-extrabold uppercase tracking-wider text-[#B45309]">
            ALUR PENERBITAN
          </span>
          <h2 class="mt-3 text-2xl font-extrabold text-navy sm:text-3xl tracking-tight">
            Penerbitan Mudah dalam 3 Langkah
          </h2>
          <p class="mt-2.5 inline-block rounded-lg bg-blue-600 px-2.5 py-1 text-sm font-bold text-white shadow-xs sm:text-base">
            Tanpa istilah rumit, didampingi admin redaksi hingga buku sampai di
            rumah.
          </p>
        </div>
      </div>

      <!-- 3 Langkah Hairline Grid (Desktop menyamping, Mobile turun ke bawah) -->
      <div
        id="keunggulan-track"
        class="mt-4 grid grid-cols-1 divide-y divide-slate-200/80 md:grid-cols-3 md:divide-y-0 md:divide-x"
      >
        <!-- Langkah 01 -->
        <div class="pb-8 md:pb-0 md:pr-8 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between">
              <span class="font-mono text-3xl sm:text-4xl font-extrabold tracking-tight text-[#0F172A]">
                01
              </span>
              <span class="inline-flex items-center gap-1.5 rounded-full border border-amber-300 bg-amber-50 px-3 py-1 text-[13px] font-bold text-amber-900">
                <svg
                  class="h-3.5 w-3.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"
                  />
                </svg>
                <span>Hitung Biaya</span>
              </span>
            </div>
            <h3 class="mt-5 text-lg sm:text-xl font-extrabold text-[#0F172A] tracking-tight">
              Masuk &amp; Simulasi Biaya
            </h3>
            <p class="mt-2.5 text-[15px] leading-relaxed text-slate-700">
              Silahkan Login dengan gmail. Hitung simulasi biaya anda sendiri
              dengan mengisi judul &amp; halaman buku, jumlah eksemplar, ukuran
              &amp; jenis kertas serta add-on (fasilitas tambahan).
            </p>
          </div>
          <div class="mt-7 inline-flex w-fit items-center rounded-lg border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-xs sm:text-[13px] font-extrabold text-emerald-900 shadow-2xs whitespace-nowrap">
            <span>Transparan tanpa biaya tersembunyi</span>
          </div>
        </div>

        <!-- Langkah 02 -->
        <div class="py-8 md:py-0 md:px-8 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between">
              <span class="font-mono text-3xl sm:text-4xl font-extrabold tracking-tight text-[#0F172A]">
                02
              </span>
              <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-300 bg-emerald-50 px-3 py-1 text-[13px] font-bold text-emerald-900">
                <svg
                  class="h-3.5 w-3.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
                  />
                </svg>
                <span>Konsultasi WA</span>
              </span>
            </div>
            <h3 class="mt-5 text-lg sm:text-xl font-extrabold text-[#0F172A] tracking-tight">
              Konsultasi &amp; Kirim Naskah
            </h3>
            <p class="mt-2.5 text-[15px] leading-relaxed text-slate-700">
              Ajukan pesanan dan ngobrol santai bersama Customer Servis via
              WhatsApp. Lalu kirim berkas naskahmu sekaligus diskusikan desain
              cover dan layoutnya.
            </p>
          </div>
          <div class="mt-7 inline-flex w-fit items-center rounded-lg border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-xs sm:text-[13px] font-extrabold text-emerald-900 shadow-2xs whitespace-nowrap">
            <span>Hak cipta 100% milik penulis</span>
          </div>
        </div>

        <!-- Langkah 03 -->
        <div class="pt-8 md:pt-0 md:pl-8 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between">
              <span class="font-mono text-3xl sm:text-4xl font-extrabold tracking-tight text-[#0F172A]">
                03
              </span>
              <span class="inline-flex items-center gap-1.5 rounded-full border border-slate-300 bg-slate-100 px-3 py-1 text-[13px] font-bold text-navy">
                <svg
                  class="h-3.5 w-3.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
                  />
                </svg>
                <span>Kirim Aman</span>
              </span>
            </div>
            <h3 class="mt-5 text-lg sm:text-xl font-extrabold text-[#0F172A] tracking-tight">
              Cetak &amp; Sampai di Rumah
            </h3>
            <p class="mt-2.5 text-[15px] leading-relaxed text-slate-700">
              Setelah rincian disepakati dan administrasi selesai, buku dicetak
              rapi berstandar toko buku dan dikirim aman ke alamatmu lengkap
              dengan resi.
            </p>
          </div>
          <div class="mt-7 inline-flex w-fit items-center rounded-lg border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-xs sm:text-[13px] font-extrabold text-emerald-900 shadow-2xs whitespace-nowrap">
            <span>Cetakan berkualitas</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  {showPublicShowcase && (
    <>
      <!-- Section Testimoni Penulis (Dinamis dari /api/testimonials) -->
      <section
        id="testimoni"
        class="hidden border-t border-slate-100 bg-[#F1F5F9]/60 py-16"
      >
        <div class="mx-auto max-w-[1088px] px-4 sm:px-6">
          <div class="text-center">
            <h2 class="text-2xl font-extrabold text-navy sm:text-3xl">
              Cerita Mereka Bersama Novella.id
            </h2>
            <p class="mt-1 text-xs text-slate-600 sm:text-sm">
              Keberanian memulai menerbitkan karya sastra Nusantara.
            </p>
          </div>
          <div
            id="testimonials-grid"
            class="mt-10 grid gap-6 sm:grid-cols-3"
          ></div>
        </div>
      </section>
    </>
  )}

  <!-- Kutipan Sastra Nusantara & CTA Penutup -->
  <section class="bg-navy py-16 text-center text-white">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <blockquote class="font-literary text-lg font-medium italic sm:text-2xl leading-relaxed text-slate-100">
        “Orang boleh pandai setinggi langit, tapi selama ia tidak menulis, ia
        akan hilang di dalam masyarakat dan dari sejarah. Menulis adalah bekerja
        untuk keabadian.”
      </blockquote>
      <p class="mt-4 text-xs font-bold tracking-widest uppercase text-orange">
        — Pramoedya Ananta Toer
      </p>

      <div class="mt-10">
        <a
          href="/portal"
          class="inline-flex items-center justify-center rounded-full bg-orange px-8 py-3.5 text-sm font-extrabold text-white shadow-lg transition-all hover:bg-orange-hover hover:scale-105 active:scale-95"
        >
          Mulai Terbitkan Naskahmu Sekarang
        </a>
      </div>
    </div>
  </section>

  <!-- Floating WhatsApp CS Button -->
  <a
    id="landing-wa-fab"
    href="https://wa.me/6289629625458?text=Halo%20CS%20Novella.id%2C%20saya%20ingin%20berkonsultasi%20mengenai%20penerbitan%20naskah."
    data-wa-text="Halo CS Novella.id, saya ingin berkonsultasi mengenai penerbitan naskah."
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Hubungi WhatsApp CS Novella.id"
    title="WhatsApp CS Novella.id"
    class="dynamic-wa-link fixed bottom-5 right-5 z-40 inline-flex items-center gap-2 rounded-full bg-[#25D366] px-4 py-3 text-xs sm:text-sm font-extrabold text-white shadow-lg transition-all hover:bg-[#1EBE5D] hover:scale-105 active:scale-95 focus:outline-none focus:ring-4 focus:ring-[#25D366]/30"
  >
    <svg
      class="h-5 w-5 fill-current shrink-0"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path d="M12.031 2c-5.516 0-9.969 4.453-9.969 9.969 0 1.766.469 3.484 1.344 5l-1.406 5.156 5.281-1.375c1.469.797 3.109 1.219 4.75 1.219 5.516 0 9.969-4.453 9.969-9.969S17.547 2 12.031 2zm5.813 14.125c-.25.703-1.438 1.344-2 1.422-.516.078-1.172.109-1.906-.125-.453-.141-1.031-.328-1.766-.656-3.094-1.344-5.109-4.469-5.266-4.672-.156-.203-1.266-1.688-1.266-3.219s.797-2.281 1.078-2.594c.281-.313.609-.391.813-.391.203 0 .406 0 .578.016.188.016.438-.078.688.531.25.609.859 2.094.938 2.25.078.156.125.344.031.547-.094.203-.156.328-.313.5-.156.172-.328.391-.469.516-.156.156-.313.328-.141.641.172.313.781 1.297 1.672 2.094 1.156 1.031 2.125 1.344 2.438 1.5.313.156.484.125.672-.078.188-.203.766-.891.969-1.203.203-.313.406-.266.688-.156.281.109 1.797.844 2.109 1 .313.156.516.234.594.359.078.125.078.734-.172 1.438z" />
    </svg>
    <span>WA CS</span>
  </a>

  <!-- Dynamic Testimonials Script -->
  <script is:inline>
    (function () {
      document.addEventListener("DOMContentLoaded", () => {
        // Dynamic Testimonials loader (Katalog Buku dipisahkan ke subdomain buku.novella.id)
        (async () => {
          const testiSection = document.getElementById("testimoni");
          if (!testiSection) return;
          const apiBase =
            typeof window !== "undefined" && window.location.port === "4321"
              ? "http://localhost:3001/api"
              : "/api";

          try {
            const tRes = await fetch(`${apiBase}/testimonials`);
            if (tRes.ok) {
              const testimonials = await tRes.json();
              const grid = document.getElementById("testimonials-grid");
              if (grid && testimonials.length > 0) {
                grid.innerHTML = testimonials
                  .map(
                    (t) => `
                  <div class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm">
                    <p class="font-literary text-xs italic leading-relaxed text-slate-700">"${t.quote}"</p>
                    <div class="mt-5 border-t border-slate-100 pt-3">
                      <p class="text-xs font-extrabold text-navy">${t.authorName}</p>
                      <p class="text-[11px] text-slate-500">${t.roleOrCity}</p>
                    </div>
                  </div>
                `,
                  )
                  .join("");
                testiSection.classList.remove("hidden");
              }
            }
          } catch {}
        })();
      });
    })();
  </script>
</BaseLayout>
