---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Masuk Akun Penulis — Novella.id" activeNav="portal">
  <div class="py-12 sm:py-16 bg-[#F1F5F9]/60 min-h-[calc(100vh-140px)] flex items-center justify-center px-4">
    <div class="w-full max-w-md rounded-3xl border border-slate-200/80 bg-white p-7 sm:p-8 shadow-sm">
      <div class="text-center">
        <span class="rounded-full bg-orange/10 px-3 py-1 text-xs font-bold text-orange">Autentikasi Akun</span>
        <h1 class="mt-3 text-2xl font-extrabold text-navy">Masuk ke Novella.id</h1>
        <p class="mt-1.5 text-xs text-slate-500">Lanjutkan penerbitan naskah atau pantau status pesanan bukumu.</p>
      </div>

      <!-- Google OAuth Sign-in -->
      <div class="mt-6">
        <button
          id="btn-google-login"
          type="button"
          class="flex w-full items-center justify-center gap-3 rounded-full border-2 border-slate-200 bg-white py-3 text-sm font-bold text-navy shadow-xs transition-all hover:border-navy hover:bg-slate-50 cursor-pointer"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" />
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
          </svg>
          <span>Masuk dengan Google</span>
        </button>
      </div>

      <div class="relative my-6 flex items-center justify-center">
        <span class="absolute inset-x-0 h-px bg-slate-200"></span>
        <span class="relative bg-white px-3 text-[11px] font-bold text-slate-400 uppercase tracking-wider">atau dengan email</span>
      </div>

      <!-- Regular Email & Password Login Form -->
      <form id="email-login-form" class="space-y-4">
        <div>
          <label class="block text-xs font-bold text-navy">Alamat Email</label>
          <input
            id="input-login-email"
            type="email"
            required
            autocomplete="email"
            placeholder="nama@email.com"
            class="mt-1 w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm font-semibold focus:border-navy focus:outline-none"
          />
        </div>

        <div>
          <div class="flex items-center justify-between">
            <label class="block text-xs font-bold text-navy">Kata Sandi</label>
          </div>
          <input
            id="input-login-password"
            type="password"
            required
            autocomplete="current-password"
            placeholder="••••••••"
            class="mt-1 w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm font-semibold focus:border-navy focus:outline-none"
          />
        </div>

        <div id="login-error-msg" class="hidden rounded-xl bg-rose-50 border border-rose-200 p-3 text-xs font-bold text-rose-700"></div>

        <button
          id="btn-submit-login"
          type="submit"
          class="w-full rounded-full bg-navy py-3 text-sm font-extrabold text-white shadow-sm transition-all hover:bg-slate-800"
        >
          Masuk Sekarang &rarr;
        </button>
      </form>

      <div class="mt-6 border-t border-slate-100 pt-4 text-center text-xs text-slate-500">
        Belum memiliki akun?{' '}
        <a href="/daftar" class="font-extrabold text-orange hover:underline">
          Daftar Penulis Baru
        </a>
      </div>
    </div>
  </div>

  <script is:inline>
    const API_BASE = '/api';
    const AUTH_KEY = 'novella_auth_user';
    const isLoggedOut = typeof window !== 'undefined' && window.location.search.includes('logged_out=1');

    if (isLoggedOut) {
      localStorage.removeItem(AUTH_KEY);
    } else {
      if (localStorage.getItem(AUTH_KEY)) {
        window.location.replace('/portal');
      }

      async function checkExistingSession() {
        try {
          const res = await fetch(`${API_BASE}/auth/get-session`, { credentials: 'include' });
          if (res.ok) {
            const session = await res.json();
            if (session && session.user) {
              localStorage.setItem(AUTH_KEY, JSON.stringify(session.user));
              window.location.replace('/portal');
            }
          }
        } catch {}
      }
      checkExistingSession();
    }

    // Google OAuth Login
    document.getElementById('btn-google-login').addEventListener('click', async () => {
      const callbackUrl = window.location.origin + '/portal';
      try {
        const res = await fetch(`${API_BASE}/auth/sign-in/social`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({
            provider: 'google',
            callbackURL: callbackUrl,
          }),
        });
        const data = await res.json();
        if (data && data.url) {
          window.location.href = data.url;
          return;
        }
      } catch {}
      window.location.href = `${API_BASE}/auth/sign-in/social?provider=google&callbackURL=${encodeURIComponent(callbackUrl)}`;
    });

    // Regular Email Login
    const form = document.getElementById('email-login-form');
    const errorBox = document.getElementById('login-error-msg');
    const submitBtn = document.getElementById('btn-submit-login');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBox.classList.add('hidden');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Memverifikasi...';

      const email = document.getElementById('input-login-email').value.trim();
      const password = document.getElementById('input-login-password').value;

      try {
        const res = await fetch(`${API_BASE}/auth/sign-in/email`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ email, password }),
        });

        const data = await res.json();

        if (res.ok) {
          if (data && data.user) {
            localStorage.setItem(AUTH_KEY, JSON.stringify(data.user));
          }
          window.location.href = '/portal';
        } else {
          errorBox.textContent = data.message || data.error || 'Email atau kata sandi tidak sesuai.';
          errorBox.classList.remove('hidden');
        }
      } catch (err) {
        errorBox.textContent = 'Gagal terhubung ke server. Pastikan koneksi aktif.';
        errorBox.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Masuk Sekarang →';
      }
    });
  </script>
</BaseLayout>
