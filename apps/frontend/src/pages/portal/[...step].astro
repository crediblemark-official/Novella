---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProfileCard from '../../components/portal/ProfileCard.astro';
import OrderHistoryDrawer from '../../components/portal/OrderHistoryDrawer.astro';
import StepCalculator from '../../components/portal/StepCalculator.astro';
import StepManuscript from '../../components/portal/StepManuscript.astro';
import StepPayment from '../../components/portal/StepPayment.astro';

export function getStaticPaths() {
  return [
    { params: { step: undefined } },
    { params: { step: 'kalkulator' } },
    { params: { step: 'naskah' } },
    { params: { step: 'pembayaran' } },
  ];
}
---

<BaseLayout title="Portal Penerbitan Mandiri — Novella.id" activeNav="portal">
  <main class="mx-auto w-full max-w-5xl overflow-x-clip px-4 py-6 sm:px-6 sm:py-8 min-h-[calc(100vh-64px)]">
    <!-- Loading State (visible until session check completes) -->
    <div id="portal-loading" class="flex flex-col items-center justify-center py-24 text-center">
      <div class="h-9 w-9 animate-spin rounded-full border-4 border-navy border-t-orange"></div>
      <p class="mt-4 text-xs font-bold text-slate-500">Memverifikasi akun penulis...</p>
    </div>

    <!-- Main Portal Content (hidden until session verified) -->
    <div id="portal-main-content" class="hidden">
      <!-- 1. Profil Penulis Wajib: Open Editorial Studio (Shows ONLY if profile incomplete) -->
      <ProfileCard />

      <!-- 2. Master Publishing Studio Panel: Flat, Seamless & Unboxed -->
      <div id="wizard-container" class="w-full">
        <OrderHistoryDrawer />
        <StepCalculator />
        <StepManuscript />
        <StepPayment />
      </div>
    </div>
  </main>

  <!-- Portal Confirm Dialog / Mobile Bottom-Sheet -->
  <dialog id="dlg-portal-confirm" class="m-auto w-[calc(100%-2rem)] max-w-sm rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 text-left shadow-2xl backdrop:bg-slate-900/45 backdrop:backdrop-blur-[2px] max-sm:fixed max-sm:inset-x-0 max-sm:bottom-0 max-sm:top-auto max-sm:m-0 max-sm:w-full max-sm:max-w-none max-sm:rounded-b-none max-sm:rounded-t-2xl">
    <div class="mx-auto mb-3 h-1 w-10 rounded-full bg-slate-200 sm:hidden"></div>
    <h3 class="text-sm font-extrabold text-navy">Batalkan Pesanan</h3>
    <p id="dlg-portal-msg" class="mt-1.5 text-xs text-slate-600 leading-relaxed">-</p>
    <div class="mt-4 flex items-center justify-end gap-2 border-t border-slate-100 pt-3">
      <button id="dlg-portal-cancel" type="button" class="min-h-[40px] rounded-xl border border-slate-200 bg-white px-4 py-2 text-xs font-bold text-slate-600 hover:bg-slate-50 cursor-pointer">Kembali</button>
      <button id="dlg-portal-ok" type="button" class="min-h-[40px] rounded-xl bg-rose-600 px-4 py-2 text-xs font-extrabold text-white hover:bg-rose-700 cursor-pointer">Batalkan</button>
    </div>
  </dialog>

  <!-- Toast Notification -->
  <div
    id="toast"
    class="fixed bottom-5 right-5 z-50 hidden rounded-xl bg-navy px-4 py-2.5 text-xs font-bold text-white shadow-lg transition-all"
  >
    Nomor rekening berhasil disalin!
  </div>

  <script>
    import { initPortalController } from '../../scripts/portal-controller';
    initPortalController();
  </script>
</BaseLayout>
