---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProfileCard from '../../components/portal/ProfileCard.astro';
import StepHistory from '../../components/portal/StepHistory.astro';
import StepCalculator from '../../components/portal/StepCalculator.astro';
import StepManuscript from '../../components/portal/StepManuscript.astro';
import StepPayment from '../../components/portal/StepPayment.astro';

export function getStaticPaths() {
  return [
    { params: { step: undefined } },
    { params: { step: 'kalkulator' } },
    { params: { step: 'naskah' } },
    { params: { step: 'pembayaran' } },
    { params: { step: 'riwayat' } },
  ];
}
---

<BaseLayout title="Portal Penerbitan Mandiri — Novella.id" activeNav="portal">
  <main class="mx-auto w-full max-w-5xl overflow-x-clip px-3.5 py-4 sm:px-6 sm:py-6 min-h-[calc(100vh-64px)]">
    <!-- Loading State (visible until session check completes) -->
    <div id="portal-loading" class="flex flex-col items-center justify-center py-24 text-center">
      <div class="h-9 w-9 animate-spin rounded-full border-4 border-navy border-t-orange"></div>
      <p class="mt-4 text-xs font-bold text-slate-500">Memverifikasi akun penulis...</p>
    </div>

    <!-- Main Portal Content (hidden until session verified) -->
    <div id="portal-main-content" class="hidden">
      <!-- 1. Profil Penulis Wajib: Open Editorial Studio (Shows ONLY if profile incomplete) -->
      <ProfileCard />

      <!-- 2. Master Publishing Studio Panel: Flat, Seamless & Unboxed -->
      <div id="wizard-container" class="w-full">
        <StepHistory />
        <StepCalculator />
        <StepManuscript />
        <StepPayment />
      </div>
    </div>
  </main>

  <!-- Portal Confirm Dialog / Mobile Bottom-Sheet -->
  <dialog id="dlg-portal-confirm" class="m-auto w-[calc(100%-2rem)] max-w-sm rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 text-left shadow-2xl backdrop:bg-slate-900/45 backdrop:backdrop-blur-[2px] max-sm:fixed max-sm:inset-x-0 max-sm:bottom-0 max-sm:top-auto max-sm:m-0 max-sm:w-full max-sm:max-w-none max-sm:rounded-b-none max-sm:rounded-t-2xl">
    <div class="mx-auto mb-3 h-1 w-10 rounded-full bg-slate-200 sm:hidden"></div>
    <h3 class="text-sm font-extrabold text-navy">Batalkan Pesanan</h3>
    <p id="dlg-portal-msg" class="mt-1.5 text-xs text-slate-600 leading-relaxed">-</p>
    <div class="mt-4 flex items-center justify-end gap-2 border-t border-slate-100 pt-3">
      <button id="dlg-portal-cancel" type="button" class="min-h-[40px] rounded-xl border border-slate-200 bg-white px-4 py-2 text-xs font-bold text-slate-600 hover:bg-slate-50 cursor-pointer">Kembali</button>
      <button id="dlg-portal-ok" type="button" class="min-h-[40px] rounded-xl bg-rose-600 px-4 py-2 text-xs font-extrabold text-white hover:bg-rose-700 cursor-pointer">Batalkan</button>
    </div>
  </dialog>

  <!-- Author Testimonial Dialog / Mobile Bottom-Sheet -->
  <dialog id="dlg-author-testimonial" class="m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 text-left shadow-2xl backdrop:bg-slate-900/45 backdrop:backdrop-blur-[2px] max-sm:fixed max-sm:inset-x-0 max-sm:bottom-0 max-sm:top-auto max-sm:m-0 max-sm:w-full max-sm:max-w-none max-sm:rounded-b-none max-sm:rounded-t-2xl">
    <div class="mx-auto mb-3 h-1 w-10 rounded-full bg-slate-200 sm:hidden"></div>
    <div class="flex items-center justify-between gap-2">
      <h3 class="text-sm font-extrabold text-navy">Bagikan Pengalaman Menerbitkan</h3>
      <button id="dlg-testi-close" type="button" aria-label="Tutup" class="flex h-8 w-8 items-center justify-center rounded-lg text-slate-400 hover:bg-slate-100 hover:text-navy cursor-pointer">&times;</button>
    </div>
    <p class="mt-1 text-xs text-slate-500">Testimoni Anda akan ditinjau tim redaksi sebelum ditayangkan.</p>
    <form id="portal-testimonial-form" class="mt-4 space-y-3">
      <div class="grid gap-3 sm:grid-cols-2">
        <div>
          <label for="portal-testi-author" class="mb-1 block text-[10px] font-bold uppercase tracking-wider text-slate-500">Nama Penulis *</label>
          <input id="portal-testi-author" type="text" required placeholder="Nama Anda" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-navy focus:border-navy focus:outline-none" />
        </div>
        <div>
          <label for="portal-testi-role" class="mb-1 block text-[10px] font-bold uppercase tracking-wider text-slate-500">Profesi / Kota *</label>
          <input id="portal-testi-role" type="text" required placeholder="Misal: Mahasiswi, Yogyakarta" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-medium text-navy focus:border-navy focus:outline-none" />
        </div>
      </div>
      <div>
        <label class="mb-1 block text-[10px] font-bold uppercase tracking-wider text-slate-500">Penilaian</label>
        <input id="portal-testi-rating" type="hidden" value="5" />
        <div id="portal-testi-stars" class="flex items-center gap-1.5">
          {[1, 2, 3, 4, 5].map((star) => (
            <button type="button" data-star-val={star} aria-label={`${star} bintang`} class="portal-star-btn p-1 rounded-lg hover:bg-slate-100 cursor-pointer transition-colors">
              <svg class="h-5 w-5 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            </button>
          ))}
        </div>
      </div>
      <div>
        <label for="portal-testi-quote" class="mb-1 block text-[10px] font-bold uppercase tracking-wider text-slate-500">Kutipan Testimoni *</label>
        <textarea id="portal-testi-quote" required rows="3" placeholder="Ceritakan pengalaman Anda menerbitkan buku bersama Novella.id..." class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-medium text-navy focus:border-navy focus:outline-none"></textarea>
      </div>
      <div class="flex items-center justify-end gap-2 border-t border-slate-100 pt-3">
        <button id="dlg-testi-cancel" type="button" class="min-h-[38px] rounded-xl border border-slate-200 bg-white px-4 py-2 text-xs font-bold text-slate-600 hover:bg-slate-50 cursor-pointer">Batal</button>
        <button id="portal-testi-submit" type="submit" class="min-h-[38px] rounded-xl bg-orange px-5 py-2 text-xs font-extrabold text-white hover:bg-orange-hover cursor-pointer transition-colors">Kirim</button>
      </div>
    </form>
  </dialog>

  <!-- Floating WhatsApp CS Button -->
  <a
    id="portal-wa-fab"
    href="https://wa.me/6289629625458?text=Halo%20Admin%20Novella.id%2C%20saya%20ingin%20berkonsultasi%20mengenai%20penerbitan%20naskah."
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat WhatsApp Redaksi Novella.id"
    title="Chat WhatsApp Redaksi"
    class="fixed bottom-20 right-4 md:bottom-5 md:right-5 z-40 flex h-12 w-12 md:h-13 md:w-13 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg transition-all hover:bg-[#1EBE5D] hover:scale-105 active:scale-95 focus:outline-none focus:ring-4 focus:ring-[#25D366]/30"
  >
    <svg class="h-6 w-6 fill-current" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12.031 2c-5.516 0-9.969 4.453-9.969 9.969 0 1.766.469 3.484 1.344 5l-1.406 5.156 5.281-1.375c1.469.797 3.109 1.219 4.75 1.219 5.516 0 9.969-4.453 9.969-9.969S17.547 2 12.031 2zm5.813 14.125c-.25.703-1.438 1.344-2 1.422-.516.078-1.172.109-1.906-.125-.453-.141-1.031-.328-1.766-.656-3.094-1.344-5.109-4.469-5.266-4.672-.156-.203-1.266-1.688-1.266-3.219s.797-2.281 1.078-2.594c.281-.313.609-.391.813-.391.203 0 .406 0 .578.016.188.016.438-.078.688.531.25.609.859 2.094.938 2.25.078.156.125.344.031.547-.094.203-.156.328-.313.5-.156.172-.328.391-.469.516-.156.156-.313.328-.141.641.172.313.781 1.297 1.672 2.094 1.156 1.031 2.125 1.344 2.438 1.5.313.156.484.125.672-.078.188-.203.766-.891.969-1.203.203-.313.406-.266.688-.156.281.109 1.797.844 2.109 1 .313.156.516.234.594.359.078.125.078.734-.172 1.438z" />
    </svg>
  </a>

  <!-- Toast Notification -->
  <div
    id="toast"
    class="fixed bottom-20 right-5 z-50 hidden rounded-xl bg-navy px-4 py-2.5 text-xs font-bold text-white shadow-lg transition-all"
  >
    Nomor rekening berhasil disalin!
  </div>

  <script>
    import { initPortalController } from '../../scripts/portal-controller';
    initPortalController();
  </script>
</BaseLayout>
