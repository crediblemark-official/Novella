---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';

interface Props {
  title?: string;
  description?: string;
  activeNav?: 'landing' | 'portal' | 'admin';
  showNavbar?: boolean;
  showFooter?: boolean;
}

const {
  title = 'Novella.id — Ruang Tumbuh Penulis Nusantara',
  description = 'Ruang tumbuh penulis Nusantara yang inklusif, terjangkau, dan profesional bagi penulis pemula, pelajar, dan masyarakat akar rumput.',
  activeNav = 'landing',
  showNavbar = Astro.props.showNavbar ?? (activeNav !== 'admin'),
  showFooter = Astro.props.showFooter ?? (activeNav === 'landing')
} = Astro.props;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen overflow-x-clip bg-white text-navy antialiased flex flex-col justify-between">
    <!-- Top Navbar (Hidden inside dedicated admin app workspace) -->
    {showNavbar && <Navbar activeNav={activeNav} />}

    <!-- Main Content Slot -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer (Hanya muncul di halaman publik / landing luar) -->
    {showFooter && (
      <footer class="border-t border-slate-200/80 bg-white py-8 text-slate-600">
        <div class="mx-auto max-w-[1088px] px-4 sm:px-6">
          <div class="flex flex-col items-center gap-5 md:flex-row md:items-center md:justify-between">
            <nav aria-label="Navigasi Footer" class="flex flex-wrap items-center justify-center md:justify-start gap-x-4 gap-y-2 text-sm sm:text-[15px] font-semibold text-slate-700">
              <a href="/tentang-kami" class="hover:text-navy transition-colors">Tentang Kami</a>
              <span class="text-slate-300 select-none" aria-hidden="true">|</span>
              <a href="/syarat-ketentuan" class="hover:text-navy transition-colors">Syarat &amp; Ketentuan</a>
              <span class="text-slate-300 select-none" aria-hidden="true">|</span>
              <a href="/kebijakan-privasi" class="hover:text-navy transition-colors">Kebijakan Privasi</a>
              <span class="text-slate-300 select-none" aria-hidden="true">|</span>
              <a href="https://wa.me/6289629625458" target="_blank" rel="noopener noreferrer" class="dynamic-wa-link hover:text-navy transition-colors">Kontak</a>
            </nav>

            <div class="flex items-center justify-center gap-3 shrink-0">
              <a
                href="https://buku.novella.id"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Katalog Buku Novella.id"
                title="Katalog Buku"
                class="flex h-11 w-11 items-center justify-center rounded-full bg-blue-600 text-white shadow-sm hover:bg-blue-700 hover:scale-105 transition-all"
              >
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
              </a>
              <a
                href="/portal"
                aria-label="Portal Simulasi Harga"
                title="Portal Penulis"
                class="flex h-11 w-11 items-center justify-center rounded-full bg-orange text-white shadow-sm hover:bg-orange-hover hover:scale-105 transition-all"
              >
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                </svg>
              </a>
              <a
                href="https://wa.me/6289629625458"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="WhatsApp Redaksi Novella.id"
                title="WhatsApp Redaksi (0896-2962-5458)"
                class="dynamic-wa-link flex h-11 w-11 items-center justify-center rounded-full bg-[#25D366] text-white shadow-sm hover:bg-[#1EBE5D] hover:scale-105 transition-all"
              >
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12.031 2c-5.516 0-9.969 4.453-9.969 9.969 0 1.766.469 3.484 1.344 5l-1.406 5.156 5.281-1.375c1.469.797 3.109 1.219 4.75 1.219 5.516 0 9.969-4.453 9.969-9.969S17.547 2 12.031 2zm5.813 14.125c-.25.703-1.438 1.344-2 1.422-.516.078-1.172.109-1.906-.125-.453-.141-1.031-.328-1.766-.656-3.094-1.344-5.109-4.469-5.266-4.672-.156-.203-1.266-1.688-1.266-3.219s.797-2.281 1.078-2.594c.281-.313.609-.391.813-.391.203 0 .406 0 .578.016.188.016.438-.078.688.531.25.609.859 2.094.938 2.25.078.156.125.344.031.547-.094.203-.156.328-.313.5-.156.172-.328.391-.469.516-.156.156-.313.328-.141.641.172.313.781 1.297 1.672 2.094 1.156 1.031 2.125 1.344 2.438 1.5.313.156.484.125.672-.078.188-.203.766-.891.969-1.203.203-.313.406-.266.688-.156.281.109 1.797.844 2.109 1 .313.156.516.234.594.359.078.125.078.734-.172 1.438z" />
                </svg>
              </a>
            </div>
          </div>

          <div class="my-6 border-t border-slate-200/80"></div>

          <div class="flex flex-col items-center gap-3 text-center text-xs md:flex-row md:items-center md:justify-between md:text-left">
            <div class="hidden md:flex flex-wrap items-center gap-2 text-slate-600">
              <span class="font-extrabold tracking-tight text-navy">novella<span class="text-orange">.id</span></span>
              <span class="text-slate-300">&middot;</span>
              <span id="footer-tagline" class="font-bold text-navy uppercase tracking-wide text-[11px]">Penerbit Karya Sastra Nusantara</span>
              <span class="text-slate-300">|</span>
              <span class="inline-flex items-center gap-1.5 text-slate-500">
                <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
                Layanan Aktif
              </span>
            </div>

            <p class="text-xs text-slate-500">
              Copyright &copy; {new Date().getFullYear()} Novella.id. All Rights Reserved.
            </p>
          </div>
        </div>
      </footer>
    )}

    <script>
      (async () => {
        const hasTargets =
          document.getElementById('landing-tagline') ||
          document.getElementById('footer-tagline') ||
          document.getElementById('redaksi-address') ||
          document.getElementById('redaksi-wa-link') ||
          document.querySelector('.dynamic-wa-link');
        if (!hasTargets) return;

        const apiBase = window.location.port === '4321' ? 'http://localhost:3001/api' : '/api';
        try {
          const res = await fetch(`${apiBase}/settings`);
          if (!res.ok) return;
          const data = await res.json();

          if (data.companyTagline) {
            const lt = document.getElementById('landing-tagline');
            const ft = document.getElementById('footer-tagline');
            if (lt) lt.textContent = data.companyTagline;
            if (ft) ft.textContent = data.companyTagline;
          }
          if (data.companyAddress) {
            const addr = document.getElementById('redaksi-address');
            if (addr) addr.textContent = data.companyAddress;
          }
          if (data.adminWa) {
            const waUrl = `https://wa.me/${data.adminWa}`;
            document.querySelectorAll<HTMLAnchorElement>('.dynamic-wa-link').forEach((a) => {
              const waText = a.dataset.waText;
              a.href = waText ? `${waUrl}?text=${encodeURIComponent(waText)}` : waUrl;
            });
            const redWa = document.getElementById('redaksi-wa-link') as HTMLAnchorElement | null;
            if (redWa) {
              redWa.href = waUrl;
              const localWa = data.adminWa.startsWith('62') ? '0' + data.adminWa.slice(2) : data.adminWa;
              redWa.textContent = localWa.replace(/^(\d{4})(\d{4})(\d+)$/, '$1-$2-$3');
            }
          }
        } catch {}
      })();
    </script>
  </body>
</html>
