---
/**
 * AdminAuthorsPanel: Full-Width Edge-to-Edge Direktori Penulis CRM
 */
---

<div id="panel-authors" class="admin-panel hidden w-full">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 bg-slate-50/60 px-4 py-3 sm:px-6">
    <span id="authors-count" class="text-xs font-bold text-slate-600">Memuat penulis...</span>
    <input
      id="authors-search-input"
      type="text"
      placeholder="Cari nama, email, atau alamat..."
      class="w-full sm:w-64 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-navy focus:border-navy focus:outline-none"
    />
  </div>

  <!-- Full-Width Hairline Authors Table (Scrollbar di Atas) -->
  <div id="authors-top-scroll" class="hidden w-full overflow-x-auto border-b border-slate-200 bg-slate-50/60">
    <div id="authors-top-scroll-inner" class="h-px"></div>
  </div>
  <div id="authors-table-wrap" class="w-full overflow-x-auto bg-white [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
    <table class="w-full text-left text-xs">
      <thead class="border-b border-slate-200 bg-slate-50/80 text-[11px] font-extrabold uppercase tracking-wider text-slate-600">
        <tr>
          <th class="px-4 py-3 sm:pl-6">Nama Penulis</th>
          <th class="px-4 py-3">Email</th>
          <th class="px-4 py-3">WhatsApp</th>
          <th class="px-4 py-3">Alamat</th>
          <th class="px-4 py-3">Aktivitas</th>
          <th class="px-4 py-3 sm:pr-6 text-right">Aksi</th>
        </tr>
      </thead>
      <tbody id="authors-tbody" class="divide-y divide-slate-200/80 border-b border-slate-200">
        <tr><td colspan="6" class="px-4 py-8 text-center text-slate-500">Memuat data penulis...</td></tr>
      </tbody>
    </table>
  </div>
</div>
