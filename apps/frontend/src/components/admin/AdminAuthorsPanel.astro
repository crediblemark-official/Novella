---
/**
 * AdminAuthorsPanel: Direktori Penulis Terdaftar (CRM Mini)
 */
---

<div id="panel-authors" class="admin-panel mt-6 hidden">
  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="border-b border-slate-100 pb-4">
      <h2 class="text-base font-extrabold text-navy">Direktori Penulis & Kontak (CRM)</h2>
      <p class="text-xs text-slate-500">Daftar seluruh penulis yang terdaftar, total naskah diterbitkan, dan tombol kontak langsung.</p>
    </div>

    <!-- Authors Table -->
    <div class="mt-4 overflow-hidden rounded-xl border border-slate-100">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-50 text-[11px] font-extrabold uppercase tracking-wider text-slate-500">
            <tr>
              <th class="px-4 py-3">Nama Penulis</th>
              <th class="px-4 py-3">Email</th>
              <th class="px-4 py-3">WhatsApp</th>
              <th class="px-4 py-3">Alamat</th>
              <th class="px-4 py-3">Aktivitas Naskah</th>
              <th class="px-4 py-3 text-right">Aksi Cepat</th>
            </tr>
          </thead>
          <tbody id="authors-tbody" class="divide-y divide-slate-100">
            <tr><td colspan="6" class="px-4 py-6 text-center text-slate-400">Memuat data penulis...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
