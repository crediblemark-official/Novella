---
/**
 * AdminSettingsPanel: Pengaturan Nomor WA Resmi, Alamat Redaksi, dan Rekening Bank Dinamis
 */
---

<div id="panel-settings" class="admin-panel mt-6 hidden">
  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="border-b border-slate-100 pb-4">
      <h2 class="text-base font-extrabold text-navy">Pengaturan Sistem & Rekening Bank</h2>
      <p class="text-xs text-slate-500">Ubah nomor kontak CS resmi dan rekening bank tujuan pembayaran naskah.</p>
    </div>

    <form id="admin-settings-form" class="mt-5 space-y-5">
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label class="block text-xs font-bold text-navy">Nomor WhatsApp CS Resmi Redaksi</label>
          <input
            id="set-admin-wa"
            type="text"
            placeholder="6281995100401"
            class="mt-1 w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-xs font-semibold focus:border-navy focus:outline-none"
          />
          <p class="mt-1 text-[11px] text-slate-400">Gunakan format internasional diawali 62 (tanpa tanda + atau spasi).</p>
        </div>

        <div>
          <label class="block text-xs font-bold text-navy">Tagline / Slogan Redaksi</label>
          <input
            id="set-company-tagline"
            type="text"
            placeholder="Mitra Penerbitan Sastra Nusantara Terpercaya"
            class="mt-1 w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-xs font-semibold focus:border-navy focus:outline-none"
          />
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold text-navy">Alamat Kantor Redaksi Resmi</label>
        <textarea
          id="set-company-address"
          rows="2"
          placeholder="Jl. Paingan, Maguwoharjo, Depok, Sleman, D.I. Yogyakarta"
          class="mt-1 w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-xs font-semibold focus:border-navy focus:outline-none"
        ></textarea>
      </div>

      <!-- Bank Accounts Section -->
      <div class="border-t border-slate-100 pt-5">
        <div class="flex items-center justify-between mb-3">
          <div>
            <h3 class="text-xs font-extrabold text-navy">Daftar Rekening Bank Resmi</h3>
            <p class="text-[11px] text-slate-500">Rekening ini otomatis tampil di halaman pembayaran penulis.</p>
          </div>
        </div>

        <div id="admin-bank-list" class="space-y-2 mb-4">
          <!-- Dynamic bank rows rendered here -->
        </div>

        <!-- Add Bank Form -->
        <div class="grid gap-2.5 sm:grid-cols-4 p-3.5 rounded-xl border border-dashed border-slate-200 bg-slate-50/50">
          <input id="new-bank-name" type="text" placeholder="Nama Bank (misal: BCA)" class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium focus:border-navy focus:outline-none" />
          <input id="new-bank-number" type="text" placeholder="Nomor Rekening" class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-mono font-medium focus:border-navy focus:outline-none" />
          <input id="new-bank-holder" type="text" placeholder="Atas Nama" class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium focus:border-navy focus:outline-none" />
          <button id="btn-add-bank-row" type="button" class="rounded-lg bg-navy px-3 py-1.5 text-xs font-extrabold text-white hover:bg-slate-800 transition-colors cursor-pointer">+ Tambah Bank</button>
        </div>
      </div>

      <div class="border-t border-slate-100 pt-4 flex justify-end">
        <button
          type="submit"
          class="rounded-full bg-orange px-6 py-2.5 text-xs font-extrabold text-white shadow-sm hover:bg-orange-hover transition-colors cursor-pointer"
        >
          Simpan Seluruh Pengaturan
        </button>
      </div>
    </form>
  </div>
</div>
