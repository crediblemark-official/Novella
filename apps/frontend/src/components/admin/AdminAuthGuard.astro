---
/**
 * AdminAuthGuard: Layar Autentikasi Staf Internal Redaksi Novella.id.
 * Desain minimalis netral tanpa elemen promosi situs publik.
 */
---

<div id="admin-auth-guard" class="hidden min-h-screen items-center justify-center bg-slate-50 px-4 py-12">
  <div class="w-full max-w-sm rounded-2xl border border-slate-200 bg-white p-6 sm:p-7 shadow-xs">
    <div class="flex items-center justify-between border-b border-slate-100 pb-4">
      <img src="/images/logo.png" alt="Novella.id" class="h-7 w-auto object-contain" />
      <span class="rounded bg-slate-100 border border-slate-200 px-2 py-0.5 font-mono text-[10px] font-bold tracking-wider text-slate-600">INTERNAL</span>
    </div>

    <div class="mt-5">
      <h1 class="text-lg font-extrabold text-navy tracking-tight">Masuk Redaksi</h1>
      <p class="mt-1 text-xs text-slate-500">Gunakan akun staf untuk mengakses ruang kerja.</p>
    </div>

    <div id="auth-error-banner" class="mt-4 hidden rounded-xl border border-rose-200 bg-rose-50 p-3 text-xs font-bold text-rose-700">
      Email atau kata sandi tidak valid.
    </div>

    <form id="admin-login-form" class="mt-4 space-y-3.5">
      <div>
        <label for="admin-email" class="block text-xs font-bold text-navy">Email Staf</label>
        <input
          id="admin-email"
          type="email"
          required
          autocomplete="username"
          placeholder="nama@novella.id"
          class="mt-1 w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-xs font-semibold text-navy focus:border-navy focus:outline-none"
        />
      </div>

      <div>
        <label for="admin-password" class="block text-xs font-bold text-navy">Kata Sandi</label>
        <input
          id="admin-password"
          type="password"
          required
          autocomplete="current-password"
          placeholder="••••••••••••"
          class="mt-1 w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-xs font-semibold text-navy focus:border-navy focus:outline-none"
        />
      </div>

      <button
        id="btn-admin-submit"
        type="submit"
        class="w-full min-h-[42px] rounded-xl bg-navy py-2.5 text-xs font-extrabold text-white transition-all hover:bg-slate-800 active:scale-[0.99] cursor-pointer"
      >
        Masuk
      </button>
    </form>

    <div class="mt-5 border-t border-slate-100 pt-3 text-center">
      <a href="/" class="text-[11px] font-bold text-slate-500 hover:text-navy">&larr; Situs Publik</a>
    </div>
  </div>
</div>
