---
/**
 * AdminTestimonialsPanel: Manajemen Testimoni Penulis untuk Landing Page
 */
---

<div id="panel-testimonials" class="admin-panel mt-6 hidden">
  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 pb-4">
      <div>
        <h2 class="text-base font-extrabold text-navy">Manajemen Testimoni Penulis</h2>
        <p class="text-xs text-slate-500">Testimoni ini otomatis tampil pada section beranda publik.</p>
      </div>
      <button
        id="btn-toggle-add-testi"
        type="button"
        class="rounded-full bg-navy px-4 py-2 text-xs font-extrabold text-white hover:bg-slate-800 transition-colors cursor-pointer"
      >
        + Tambah Testimoni
      </button>
    </div>

    <!-- Add Testimonial Form -->
    <form id="add-testi-form" class="mt-4 hidden p-4 rounded-xl border border-dashed border-slate-200 bg-slate-50 space-y-3">
      <div class="grid gap-3 sm:grid-cols-2">
        <input id="testi-author-input" type="text" required placeholder="Nama Penulis" class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium focus:border-navy focus:outline-none" />
        <input id="testi-role-input" type="text" required placeholder="Profesi / Asal Kota (misal: Pelajar SMA, Jakarta)" class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium focus:border-navy focus:outline-none" />
      </div>
      <div>
        <textarea id="testi-quote-input" required rows="2" placeholder="Kutipan pengalaman / testimoni..." class="w-full rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium focus:border-navy focus:outline-none"></textarea>
      </div>
      <div class="flex justify-end">
        <button type="submit" class="rounded-lg bg-orange px-4 py-1.5 text-xs font-extrabold text-white hover:bg-orange-hover transition-colors cursor-pointer">Simpan Testimoni</button>
      </div>
    </form>

    <!-- Testimonials Table -->
    <div class="mt-4 overflow-hidden rounded-xl border border-slate-100">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-50 text-[11px] font-extrabold uppercase tracking-wider text-slate-500">
          <tr>
            <th class="px-4 py-3">Nama Penulis</th>
            <th class="px-4 py-3">Profesi / Asal</th>
            <th class="px-4 py-3">Kutipan Testimoni</th>
            <th class="px-4 py-3 text-right">Aksi</th>
          </tr>
        </thead>
        <tbody id="testimonials-tbody" class="divide-y divide-slate-100">
          <tr><td colspan="4" class="px-4 py-6 text-center text-slate-400">Memuat data testimoni...</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
