---
/**
 * AdminTestimonialsPanel: Full-Width Edge-to-Edge Testimoni Workspace
 */
---

<div id="panel-testimonials" class="admin-panel hidden w-full">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 bg-slate-50/60 px-4 py-3 sm:px-6">
    <span id="testimonials-count" class="text-xs font-bold text-slate-600">Memuat testimoni...</span>
    <button
      id="btn-toggle-add-testi"
      type="button"
      class="inline-flex min-h-[34px] items-center gap-1.5 rounded-lg bg-navy px-3.5 py-1.5 text-xs font-bold text-white hover:bg-slate-800 transition-colors cursor-pointer"
    >
      <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
      <span>Tambah</span>
    </button>
  </div>

  <!-- Form Tambah Testimoni (Full-Width Strip) -->
  <form id="add-testi-form" class="hidden border-b border-slate-200 bg-slate-50/40 px-4 py-4 sm:px-6 space-y-3">
    <div class="grid gap-3 sm:grid-cols-2">
      <input id="testi-author-input" type="text" required placeholder="Nama Penulis" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-medium text-navy focus:border-navy focus:outline-none" />
      <input id="testi-role-input" type="text" required placeholder="Profesi / Kota (misal: Pelajar SMA, Jakarta)" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-medium text-navy focus:border-navy focus:outline-none" />
    </div>
    <textarea id="testi-quote-input" required rows="2" placeholder="Kutipan testimoni penulis..." class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-medium text-navy focus:border-navy focus:outline-none"></textarea>
    <div class="flex justify-end">
      <button type="submit" class="min-h-[36px] rounded-lg bg-orange px-5 py-2 text-xs font-extrabold text-white hover:bg-orange-hover transition-colors cursor-pointer">Simpan</button>
    </div>
  </form>

  <!-- Full-Width Hairline Table -->
  <div class="w-full overflow-x-auto bg-white">
    <table class="w-full text-left text-xs">
      <thead class="border-b border-slate-200 bg-slate-50/80 text-[11px] font-extrabold uppercase tracking-wider text-slate-600">
        <tr>
          <th class="px-4 py-3 sm:pl-6">Nama Penulis</th>
          <th class="px-4 py-3">Profesi / Asal</th>
          <th class="px-4 py-3">Kutipan</th>
          <th class="px-4 py-3 sm:pr-6 text-right">Aksi</th>
        </tr>
      </thead>
      <tbody id="testimonials-tbody" class="divide-y divide-slate-200/80 border-b border-slate-200">
        <tr><td colspan="4" class="px-4 py-8 text-center text-slate-500">Memuat data testimoni...</td></tr>
      </tbody>
    </table>
  </div>
</div>
