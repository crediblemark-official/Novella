---
/**
 * AdminBooksPanel: Manajemen Buku Terbitan untuk Showcase Landing Page
 */
---

<div id="panel-books" class="admin-panel mt-6 hidden">
  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 pb-4">
      <div>
        <h2 class="text-base font-extrabold text-navy">Katalog Karya Terbitan Terbaru</h2>
        <p class="text-xs text-slate-500">Buku di sini otomatis tampil pada section beranda publik.</p>
      </div>
      <button
        id="btn-toggle-add-book"
        type="button"
        class="rounded-full bg-navy px-4 py-2 text-xs font-extrabold text-white hover:bg-slate-800 transition-colors cursor-pointer"
      >
        + Tambah Buku Terbit
      </button>
    </div>

    <!-- Add Book Form (Collapsed by default) -->
    <form id="add-book-form" class="mt-4 hidden p-4 rounded-xl border border-dashed border-slate-200 bg-slate-50 space-y-3">
      <div class="grid gap-3 sm:grid-cols-3">
        <input id="book-title-input" type="text" required placeholder="Judul Buku" class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium focus:border-navy focus:outline-none" />
        <input id="book-author-input" type="text" required placeholder="Nama Penulis" class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium focus:border-navy focus:outline-none" />
        <input id="book-category-input" type="text" required placeholder="Kategori (misal: Novel Sastra)" class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium focus:border-navy focus:outline-none" />
      </div>
      <div class="grid gap-3 sm:grid-cols-3">
        <input id="book-pages-input" type="number" required placeholder="Jumlah Halaman (misal: 120)" class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium focus:border-navy focus:outline-none" />
        <input id="book-size-input" type="text" required placeholder="Ukuran Buku (misal: A5)" value="A5" class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium focus:border-navy focus:outline-none" />
        <button type="submit" class="rounded-lg bg-orange px-4 py-1.5 text-xs font-extrabold text-white hover:bg-orange-hover transition-colors cursor-pointer">Simpan Buku</button>
      </div>
    </form>

    <!-- Books Table -->
    <div class="mt-4 overflow-hidden rounded-xl border border-slate-100">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-50 text-[11px] font-extrabold uppercase tracking-wider text-slate-500">
          <tr>
            <th class="px-4 py-3">Judul Buku</th>
            <th class="px-4 py-3">Penulis</th>
            <th class="px-4 py-3">Kategori</th>
            <th class="px-4 py-3">Spesifikasi</th>
            <th class="px-4 py-3 text-right">Aksi</th>
          </tr>
        </thead>
        <tbody id="books-tbody" class="divide-y divide-slate-100">
          <tr><td colspan="5" class="px-4 py-6 text-center text-slate-400">Memuat data buku...</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
