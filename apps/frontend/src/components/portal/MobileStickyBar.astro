---
/**
 * MobileStickyBar: Docked Bottom Bar untuk Pengajuan Naskah di Layar Mobile
 * Menampilkan total harga real-time dan CTA thumb-zone (my-skill mobile standard).
 */
---

<div id="mobile-sticky-bar" class="md:hidden fixed bottom-0 left-0 right-0 z-30 bg-white/95 backdrop-blur-md border-t border-slate-200/90 px-3.5 py-2.5 shadow-[0_-4px_20px_rgba(0,0,0,0.08)] transition-all duration-200">
  <div class="max-w-md mx-auto flex items-center justify-between gap-2.5">
    <div class="min-w-0">
      <div class="flex items-center gap-1.5">
        <span class="text-[11px] font-bold text-slate-600 block tracking-tight">Estimasi Biaya:</span>
        <button id="mobile-suggestion-badge" type="button" class="hidden [&:not(.hidden)]:inline-flex items-center gap-1 text-[10px] font-extrabold text-amber-800 bg-amber-100 hover:bg-amber-200 px-2 py-0.5 rounded-full transition-all cursor-pointer">
          <svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
          <span>Saran Genap</span>
        </button>
      </div>
      <div class="mt-0.5 flex flex-wrap items-baseline gap-x-1.5 gap-y-0">
        <span id="mobile-summary-total" class="whitespace-nowrap font-mono text-base font-black text-navy leading-none">Rp 150.000</span>
        <span id="mobile-summary-original" class="whitespace-nowrap font-mono text-[11px] text-slate-500 line-through">Rp 450.000</span>
      </div>
    </div>
    <button
      id="btn-mobile-submit"
      type="button"
      class="min-h-[44px] shrink-0 whitespace-nowrap flex items-center justify-center gap-1.5 rounded-full bg-emerald-600 px-5 py-2.5 text-xs font-extrabold text-white shadow-md shadow-emerald-600/20 hover:bg-emerald-700 active:scale-[0.97] transition-all cursor-pointer"
    >
      <span>Konsultasi &rarr;</span>
    </button>
  </div>
</div>
