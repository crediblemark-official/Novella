---
/**
 * StepCalculatorAddons: Layanan Tambahan (Add-on) Resmi Novella.id
 * Ringkas tanpa deskripsi panjang, fokus pada nama layanan dan tarif resmi.
 */
---

<div class="border-t border-slate-100 pt-5 space-y-3">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-2">
      <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-navy text-[11px] font-extrabold text-white">5</span>
      <h2 class="text-sm sm:text-[15px] font-extrabold text-navy">Layanan Tambahan Opsional (Add-on)</h2>
    </div>
    <span class="text-[11px] text-slate-600 font-semibold">Pilih sesuai kebutuhan naskah</span>
  </div>

  <div class="grid gap-2.5 sm:grid-cols-2">
    <!-- E-Sertifikat -->
    <button type="button" data-addon="E-Sertifikat Penulis" class="addon-btn flex items-center justify-between rounded-xl border border-slate-200 bg-white p-2.5 text-left hover:border-slate-300 transition-all cursor-pointer shadow-2xs">
      <div>
        <p class="text-[13px] font-extrabold text-navy">E-Sertifikat Penulis</p>
        <p class="text-xs font-mono font-bold text-orange mt-0.5">+ Rp 10.000 / lembar</p>
      </div>
      <span class="addon-check flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-slate-300 text-xs font-bold text-slate-500 bg-white">+</span>
    </button>

    <!-- File Ebook Tanpa Watermark -->
    <button type="button" data-addon="File Ebook Tanpa Watermark" class="addon-btn flex items-center justify-between rounded-xl border border-slate-200 bg-white p-2.5 text-left hover:border-slate-300 transition-all cursor-pointer shadow-2xs">
      <div>
        <p class="text-[13px] font-extrabold text-navy">Ebook Tanpa Watermark</p>
        <p class="text-xs font-mono font-bold text-orange mt-0.5">+ Rp 250.000</p>
      </div>
      <span class="addon-check flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-slate-300 text-xs font-bold text-slate-500 bg-white">+</span>
    </button>

    <!-- Revisi Ringan Cover -->
    <button type="button" data-addon="Revisi Ringan Cover" class="addon-btn flex items-center justify-between rounded-xl border border-slate-200 bg-white p-2.5 text-left hover:border-slate-300 transition-all cursor-pointer shadow-2xs">
      <div>
        <p class="text-[13px] font-extrabold text-navy">Revisi Ringan Cover</p>
        <p class="text-xs font-mono font-bold text-orange mt-0.5">+ Rp 10.000 / kali</p>
      </div>
      <span class="addon-check flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-slate-300 text-xs font-bold text-slate-500 bg-white">+</span>
    </button>

    <!-- Revisi Ringan Layout -->
    <button type="button" data-addon="Revisi Ringan Layout" class="addon-btn flex items-center justify-between rounded-xl border border-slate-200 bg-white p-2.5 text-left hover:border-slate-300 transition-all cursor-pointer shadow-2xs">
      <div>
        <p class="text-[13px] font-extrabold text-navy">Revisi Ringan Layout</p>
        <p class="text-xs font-mono font-bold text-orange mt-0.5">+ Rp 10.000 / kali</p>
      </div>
      <span class="addon-check flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-slate-300 text-xs font-bold text-slate-500 bg-white">+</span>
    </button>

    <!-- Request Model Cover (Sedang) -->
    <button type="button" data-addon="Request Model Cover (Sedang)" class="addon-btn flex items-center justify-between rounded-xl border border-slate-200 bg-white p-2.5 text-left hover:border-slate-300 transition-all cursor-pointer shadow-2xs">
      <div>
        <p class="text-[13px] font-extrabold text-navy">Request Model Cover (Sedang)</p>
        <p class="text-xs font-mono font-bold text-orange mt-0.5">+ Rp 500.000</p>
      </div>
      <span class="addon-check flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-slate-300 text-xs font-bold text-slate-500 bg-white">+</span>
    </button>

    <!-- Request Model Layout (Sedang) -->
    <button type="button" data-addon="Request Model Layout (Sedang)" class="addon-btn flex items-center justify-between rounded-xl border border-slate-200 bg-white p-2.5 text-left hover:border-slate-300 transition-all cursor-pointer shadow-2xs">
      <div>
        <p class="text-[13px] font-extrabold text-navy">Request Model Layout (Sedang)</p>
        <p class="text-xs font-mono font-bold text-orange mt-0.5">+ Rp 1.000.000</p>
      </div>
      <span class="addon-check flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-slate-300 text-xs font-bold text-slate-500 bg-white">+</span>
    </button>

    <!-- Cetak 2 Dummy -->
    <button type="button" data-addon="Cetak 2 Dummy" class="addon-btn flex items-center justify-between rounded-xl border border-slate-200 bg-white p-2.5 text-left hover:border-slate-300 transition-all cursor-pointer shadow-2xs">
      <div>
        <p class="text-[13px] font-extrabold text-navy">Cetak 2 Dummy</p>
        <p class="text-xs font-mono font-bold text-orange mt-0.5">+ Rp 200.000</p>
      </div>
      <span class="addon-check flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-slate-300 text-xs font-bold text-slate-500 bg-white">+</span>
    </button>

    <!-- Pembatas Buku Custom -->
    <button type="button" data-addon="Pembatas Buku Custom" class="addon-btn flex items-center justify-between rounded-xl border border-slate-200 bg-white p-2.5 text-left hover:border-slate-300 transition-all cursor-pointer shadow-2xs">
      <div>
        <p class="text-[13px] font-extrabold text-navy">Pembatas Buku Custom</p>
        <p class="text-xs font-mono font-bold text-orange mt-0.5">+ Rp 25.000 / paket</p>
      </div>
      <span class="addon-check flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-slate-300 text-xs font-bold text-slate-500 bg-white">+</span>
    </button>

    <!-- Penyuntingan (Proofreading) -->
    <button type="button" data-addon="Penyuntingan (Proofreading)" class="addon-btn flex items-center justify-between rounded-xl border border-slate-200 bg-white p-2.5 text-left hover:border-slate-300 transition-all cursor-pointer shadow-2xs">
      <div>
        <p class="text-[13px] font-extrabold text-navy">Penyuntingan (Proofreading)</p>
        <p class="text-xs font-mono font-bold text-orange mt-0.5">+ Rp 100.000</p>
      </div>
      <span class="addon-check flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-slate-300 text-xs font-bold text-slate-500 bg-white">+</span>
    </button>

    <!-- Video Promosi -->
    <button type="button" data-addon="Video Promosi" class="addon-btn flex items-center justify-between rounded-xl border border-slate-200 bg-white p-2.5 text-left hover:border-slate-300 transition-all cursor-pointer shadow-2xs">
      <div>
        <p class="text-[13px] font-extrabold text-navy">Video Promosi</p>
        <p class="text-xs font-mono font-bold text-orange mt-0.5">+ Rp 250.000</p>
      </div>
      <span class="addon-check flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-slate-300 text-xs font-bold text-slate-500 bg-white">+</span>
    </button>
  </div>
</div>
