---
/** StepCalculatorSpecs: Format Ukuran, Kertas, Warna, dan Cover (Compact & Anti-Card-Box) */
---

<div class="border-t border-slate-100 pt-3.5 space-y-3.5">
  <!-- 1. Format Ukuran Buku -->
  <div class="space-y-1.5">
    <div class="flex flex-wrap items-center justify-between gap-x-2 gap-y-0.5">
      <div class="flex items-center gap-2">
        <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-navy text-[11px] font-extrabold text-white">4</span>
        <h2 class="text-sm sm:text-[15px] font-extrabold text-navy">Format Ukuran Buku</h2>
      </div>
      <span class="text-[11px] font-bold text-orange">A5 &amp; Unesco: Paket Dasar</span>
    </div>

    <div class="flex flex-wrap gap-1.5 sm:grid sm:grid-cols-5">
      <!-- A5 -->
      <button type="button" data-size="A5" class="size-card group flex items-center justify-between gap-1.5 rounded-lg border-2 border-navy bg-navy/[0.03] px-2.5 py-1.5 text-left transition-all duration-150 active:scale-[0.98] cursor-pointer">
        <div class="min-w-0">
          <span class="text-xs font-extrabold text-navy block leading-tight">A5</span>
          <span class="text-[10px] font-medium text-slate-600 whitespace-nowrap block">14.8×21 cm</span>
        </div>
        <span class="size-indicator flex h-3.5 w-3.5 shrink-0 items-center justify-center rounded-full bg-navy text-white transition-all duration-150 opacity-100 scale-100"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
      </button>

      <!-- Unesco -->
      <button type="button" data-size="Unesco" class="size-card group flex items-center justify-between gap-1.5 rounded-lg border border-slate-200/90 bg-white px-2.5 py-1.5 text-left transition-all duration-150 hover:border-slate-300 active:scale-[0.98] cursor-pointer">
        <div class="min-w-0">
          <span class="text-xs font-extrabold text-navy block leading-tight">Unesco</span>
          <span class="text-[10px] font-medium text-slate-600 whitespace-nowrap block">15.5×23 cm</span>
        </div>
        <span class="size-indicator flex h-3.5 w-3.5 shrink-0 items-center justify-center rounded-full bg-navy text-white transition-all duration-150 opacity-0 scale-75 group-hover:opacity-40"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
      </button>

      <!-- B5 -->
      <button type="button" data-size="B5" class="size-card group flex items-center justify-between gap-1.5 rounded-lg border border-slate-200/90 bg-white px-2.5 py-1.5 text-left transition-all duration-150 hover:border-slate-300 active:scale-[0.98] cursor-pointer">
        <div class="min-w-0">
          <span class="text-xs font-extrabold text-navy block leading-tight">B5</span>
          <span class="text-[10px] font-medium text-slate-600 whitespace-nowrap block">17.6×25 cm</span>
        </div>
        <span class="size-indicator flex h-3.5 w-3.5 shrink-0 items-center justify-center rounded-full bg-navy text-white transition-all duration-150 opacity-0 scale-75 group-hover:opacity-40"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
      </button>

      <!-- A6 Saku -->
      <button type="button" data-size="A6 Saku" class="size-card group flex items-center justify-between gap-1.5 rounded-lg border border-slate-200/90 bg-white px-2.5 py-1.5 text-left transition-all duration-150 hover:border-slate-300 active:scale-[0.98] cursor-pointer">
        <div class="min-w-0">
          <span class="text-xs font-extrabold text-navy block leading-tight">A6 Saku</span>
          <span class="text-[10px] font-medium text-slate-600 whitespace-nowrap block">10.5×14.8 cm</span>
        </div>
        <span class="size-indicator flex h-3.5 w-3.5 shrink-0 items-center justify-center rounded-full bg-navy text-white transition-all duration-150 opacity-0 scale-75 group-hover:opacity-40"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
      </button>

      <!-- A4 -->
      <button type="button" data-size="A4" class="size-card group flex items-center justify-between gap-1.5 rounded-lg border border-slate-200/90 bg-white px-2.5 py-1.5 text-left transition-all duration-150 hover:border-slate-300 active:scale-[0.98] cursor-pointer">
        <div class="min-w-0">
          <span class="text-xs font-extrabold text-navy block leading-tight">A4</span>
          <span class="text-[10px] font-medium text-slate-600 whitespace-nowrap block">21×29.7 cm</span>
        </div>
        <span class="size-indicator flex h-3.5 w-3.5 shrink-0 items-center justify-center rounded-full bg-navy text-white transition-all duration-150 opacity-0 scale-75 group-hover:opacity-40"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
      </button>
    </div>
  </div>

  <!-- 2. Jenis Kertas Isi -->
  <div class="space-y-1.5">
    <div class="flex flex-wrap items-center justify-between gap-x-2 gap-y-0.5">
      <h3 class="text-xs font-extrabold text-navy">Jenis Kertas Isi</h3>
      <span class="text-[11px] font-bold text-orange">BP 57 &amp; HVS 70: Paket Dasar</span>
    </div>
    <div class="grid grid-cols-2 gap-1.5">
      <button type="button" data-paper="bp57" class="paper-chip group flex items-center justify-between gap-1.5 rounded-lg border-2 border-navy bg-navy/[0.03] px-2.5 py-1.5 text-left transition-all duration-150 active:scale-[0.98] cursor-pointer">
        <div class="min-w-0">
          <span class="text-xs font-extrabold text-navy block truncate leading-tight">Bookpaper 57 gr</span>
          <span class="text-[10px] text-slate-600 block truncate">Krem · Paket Dasar</span>
        </div>
        <span class="paper-indicator flex h-3.5 w-3.5 shrink-0 items-center justify-center rounded-full bg-navy text-white transition-all duration-150 opacity-100 scale-100"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
      </button>

      <button type="button" data-paper="hvs70" class="paper-chip group flex items-center justify-between gap-1.5 rounded-lg border border-slate-200/90 bg-white px-2.5 py-1.5 text-left transition-all duration-150 hover:border-slate-300 active:scale-[0.98] cursor-pointer">
        <div class="min-w-0">
          <span class="text-xs font-extrabold text-navy block truncate leading-tight">HVS 70 gr</span>
          <span class="text-[10px] text-slate-600 block truncate">Putih · Paket Dasar</span>
        </div>
        <span class="paper-indicator flex h-3.5 w-3.5 shrink-0 items-center justify-center rounded-full bg-navy text-white transition-all duration-150 opacity-0 scale-75 group-hover:opacity-40"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
      </button>

      <button type="button" data-paper="bp72" class="paper-chip group flex items-center justify-between gap-1.5 rounded-lg border border-slate-200/90 bg-white px-2.5 py-1.5 text-left transition-all duration-150 hover:border-slate-300 active:scale-[0.98] cursor-pointer">
        <div class="min-w-0">
          <span class="text-xs font-extrabold text-navy block truncate leading-tight">Bookpaper 72 gr</span>
          <span class="text-[10px] text-slate-600 block truncate">Krem Tebal · Premium</span>
        </div>
        <span class="paper-indicator flex h-3.5 w-3.5 shrink-0 items-center justify-center rounded-full bg-navy text-white transition-all duration-150 opacity-0 scale-75 group-hover:opacity-40"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
      </button>

      <button type="button" data-paper="hvs80" class="paper-chip group flex items-center justify-between gap-1.5 rounded-lg border border-slate-200/90 bg-white px-2.5 py-1.5 text-left transition-all duration-150 hover:border-slate-300 active:scale-[0.98] cursor-pointer">
        <div class="min-w-0">
          <span class="text-xs font-extrabold text-navy block truncate leading-tight">HVS 80 gr</span>
          <span class="text-[10px] text-slate-600 block truncate">Putih Padat · Premium</span>
        </div>
        <span class="paper-indicator flex h-3.5 w-3.5 shrink-0 items-center justify-center rounded-full bg-navy text-white transition-all duration-150 opacity-0 scale-75 group-hover:opacity-40"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
      </button>
    </div>
  </div>

  <!-- 3. Warna Cetak & Finishing Cover (2 Kolom Ringkas) -->
  <div class="grid sm:grid-cols-2 gap-3">
    <div class="space-y-1.5">
      <h3 class="text-xs font-extrabold text-navy">Warna Cetak Isi</h3>
      <div class="grid grid-cols-2 gap-1.5">
        <button type="button" data-print="BW" class="print-chip group flex items-center justify-between gap-1.5 rounded-lg border-2 border-navy bg-navy/[0.03] px-2.5 py-1.5 text-left transition-all duration-150 active:scale-[0.98] cursor-pointer">
          <div class="min-w-0">
            <span class="text-xs font-extrabold text-navy block truncate leading-tight">Hitam Putih</span>
            <span class="text-[10px] text-slate-600 block truncate">Standar BW</span>
          </div>
          <span class="print-indicator flex h-3.5 w-3.5 shrink-0 items-center justify-center rounded-full bg-navy text-white transition-all duration-150 opacity-100 scale-100"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
        </button>

        <button type="button" data-print="FC" class="print-chip group flex items-center justify-between gap-1.5 rounded-lg border border-slate-200/90 bg-white px-2.5 py-1.5 text-left transition-all duration-150 hover:border-slate-300 active:scale-[0.98] cursor-pointer">
          <div class="min-w-0">
            <span class="text-xs font-extrabold text-navy block truncate leading-tight">Full Color</span>
            <span class="text-[10px] text-slate-600 block truncate">Berwarna</span>
          </div>
          <span class="print-indicator flex h-3.5 w-3.5 shrink-0 items-center justify-center rounded-full bg-navy text-white transition-all duration-150 opacity-0 scale-75 group-hover:opacity-40"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
        </button>
      </div>
    </div>

    <div class="space-y-1.5">
      <h3 class="text-xs font-extrabold text-navy">Finishing Cover</h3>
      <div class="grid grid-cols-2 gap-1.5">
        <button type="button" data-cover="Soft Cover" class="cover-chip group flex items-center justify-between gap-1.5 rounded-lg border-2 border-navy bg-navy/[0.03] px-2.5 py-1.5 text-left transition-all duration-150 active:scale-[0.98] cursor-pointer">
          <div class="min-w-0">
            <span class="text-xs font-extrabold text-navy block truncate leading-tight">Soft Cover</span>
            <span class="text-[10px] text-slate-600 block truncate">Ivory 230/260</span>
          </div>
          <span class="cover-indicator flex h-3.5 w-3.5 shrink-0 items-center justify-center rounded-full bg-navy text-white transition-all duration-150 opacity-100 scale-100"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
        </button>

        <button type="button" data-cover="Hard Cover" class="cover-chip group flex items-center justify-between gap-1.5 rounded-lg border border-slate-200/90 bg-white px-2.5 py-1.5 text-left transition-all duration-150 hover:border-slate-300 active:scale-[0.98] cursor-pointer">
          <div class="min-w-0">
            <span class="text-xs font-extrabold text-navy block truncate leading-tight">Hard Cover</span>
            <span class="text-[10px] text-slate-600 block truncate">+Pita &amp; Laminasi</span>
          </div>
          <span class="cover-indicator flex h-3.5 w-3.5 shrink-0 items-center justify-center rounded-full bg-navy text-white transition-all duration-150 opacity-0 scale-75 group-hover:opacity-40"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
        </button>
      </div>
    </div>
  </div>
</div>
