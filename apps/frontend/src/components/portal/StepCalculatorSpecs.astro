---
/** StepCalculatorSpecs: Ukuran, Kertas, Warna, dan Cover (Teks Padat & Jejer 1 di Mobile) */
---

<div class="border-t border-slate-100 pt-3 space-y-3">
  <!-- Ukuran (Jejer 1 di Mobile, 5 Kolom di Desktop) -->
  <div class="space-y-1.5">
    <div class="flex flex-wrap items-center justify-between gap-x-2 gap-y-0.5">
      <h2 class="text-base font-extrabold text-navy">Ukuran</h2>
    </div>

    <div class="grid grid-cols-1 gap-1.5 sm:grid-cols-2">
      <!-- A5 -->
      <button type="button" data-size="A5" class="size-card group flex items-center justify-between gap-2 rounded-xl border-2 border-navy bg-navy/[0.03] px-3 py-2 text-left transition-all duration-150 active:scale-[0.98] cursor-pointer">
        <div class="min-w-0 flex flex-wrap items-baseline gap-x-2">
          <span class="text-[15px] font-extrabold text-navy leading-tight">A5</span>
          <span class="text-xs font-semibold text-slate-600 whitespace-nowrap">14.8 × 21 cm</span>
        </div>
        <span class="size-indicator flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-navy text-white transition-all duration-150 opacity-100 scale-100"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
      </button>

      <!-- Unesco -->
      <button type="button" data-size="Unesco" class="size-card group flex items-center justify-between gap-2 rounded-xl border border-slate-200/90 bg-white px-3 py-2 text-left transition-all duration-150 hover:border-slate-300 active:scale-[0.98] cursor-pointer">
        <div class="min-w-0 flex flex-wrap items-baseline gap-x-2">
          <span class="text-[15px] font-extrabold text-navy leading-tight">Unesco</span>
          <span class="text-xs font-semibold text-slate-600 whitespace-nowrap">15.5 × 23 cm</span>
        </div>
        <span class="size-indicator flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-navy text-white transition-all duration-150 opacity-0 scale-75 group-hover:opacity-40"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
      </button>

      <!-- B5 -->
      <button type="button" data-size="B5" class="size-card group flex items-center justify-between gap-2 rounded-xl border border-slate-200/90 bg-white px-3 py-2 text-left transition-all duration-150 hover:border-slate-300 active:scale-[0.98] cursor-pointer">
        <div class="min-w-0 flex flex-wrap items-baseline gap-x-2">
          <span class="text-[15px] font-extrabold text-navy leading-tight">B5</span>
          <span class="text-xs font-semibold text-slate-600 whitespace-nowrap">17.6 × 25 cm</span>
        </div>
        <span class="size-indicator flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-navy text-white transition-all duration-150 opacity-0 scale-75 group-hover:opacity-40"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
      </button>

      <!-- A6 -->
      <button type="button" data-size="A6 Saku" class="size-card group flex items-center justify-between gap-2 rounded-xl border border-slate-200/90 bg-white px-3 py-2 text-left transition-all duration-150 hover:border-slate-300 active:scale-[0.98] cursor-pointer">
        <div class="min-w-0 flex flex-wrap items-baseline gap-x-2">
          <span class="text-[15px] font-extrabold text-navy leading-tight">A6</span>
          <span class="text-xs font-semibold text-slate-600 whitespace-nowrap">10.5 × 14.8 cm</span>
        </div>
        <span class="size-indicator flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-navy text-white transition-all duration-150 opacity-0 scale-75 group-hover:opacity-40"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
      </button>

      <!-- A4 -->
      <button type="button" data-size="A4" class="size-card group flex items-center justify-between gap-2 rounded-xl border border-slate-200/90 bg-white px-3 py-2 text-left transition-all duration-150 hover:border-slate-300 active:scale-[0.98] cursor-pointer">
        <div class="min-w-0 flex flex-wrap items-baseline gap-x-2">
          <span class="text-[15px] font-extrabold text-navy leading-tight">A4</span>
          <span class="text-xs font-semibold text-slate-600 whitespace-nowrap">21 × 29.7 cm</span>
        </div>
        <span class="size-indicator flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-navy text-white transition-all duration-150 opacity-0 scale-75 group-hover:opacity-40"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
      </button>
    </div>
  </div>

  <!-- Kertas (Jejer 1 di Mobile, 2 Kolom di Desktop) -->
  <div class="space-y-1.5">
    <div class="flex flex-wrap items-center justify-between gap-x-2 gap-y-0.5">
      <h3 class="text-base font-extrabold text-navy">Kertas</h3>
    </div>
    <div class="grid grid-cols-1 gap-1.5 sm:grid-cols-2">
      <button type="button" data-paper="bp57" class="paper-chip group flex items-center justify-between gap-2 rounded-xl border-2 border-navy bg-navy/[0.03] px-3 py-2 text-left transition-all duration-150 active:scale-[0.98] cursor-pointer">
        <div class="min-w-0 flex items-baseline gap-x-1.5 whitespace-nowrap">
          <span class="text-sm font-extrabold text-navy leading-tight">Bookpaper 57 gr</span>
          <span class="text-[11px] font-semibold text-slate-600">Kertas warna Krem</span>
        </div>
        <span class="paper-indicator flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-navy text-white transition-all duration-150 opacity-100 scale-100"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
      </button>

      <button type="button" data-paper="hvs70" class="paper-chip group flex items-center justify-between gap-2 rounded-xl border border-slate-200/90 bg-white px-3 py-2 text-left transition-all duration-150 hover:border-slate-300 active:scale-[0.98] cursor-pointer">
        <div class="min-w-0 flex items-baseline gap-x-1.5 whitespace-nowrap">
          <span class="text-sm font-extrabold text-navy leading-tight">HVS 70 gr</span>
          <span class="text-[11px] font-semibold text-slate-600">Kertas warna Putih</span>
        </div>
        <span class="paper-indicator flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-navy text-white transition-all duration-150 opacity-0 scale-75 group-hover:opacity-40"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
      </button>

      <button type="button" data-paper="bp72" class="paper-chip group flex items-center justify-between gap-2 rounded-xl border border-slate-200/90 bg-white px-3 py-2 text-left transition-all duration-150 hover:border-slate-300 active:scale-[0.98] cursor-pointer">
        <div class="min-w-0 flex items-baseline gap-x-1.5 whitespace-nowrap">
          <span class="text-sm font-extrabold text-navy leading-tight">Bookpaper 72 gr</span>
          <span class="text-[11px] font-bold text-orange">Best seller</span>
        </div>
        <span class="paper-indicator flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-navy text-white transition-all duration-150 opacity-0 scale-75 group-hover:opacity-40"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
      </button>

      <button type="button" data-paper="hvs80" class="paper-chip group flex items-center justify-between gap-2 rounded-xl border border-slate-200/90 bg-white px-3 py-2 text-left transition-all duration-150 hover:border-slate-300 active:scale-[0.98] cursor-pointer">
        <div class="min-w-0 flex items-baseline gap-x-1.5 whitespace-nowrap">
          <span class="text-sm font-extrabold text-navy leading-tight">HVS 80 gr</span>
          <span class="text-[11px] font-bold text-orange">Best seller</span>
        </div>
        <span class="paper-indicator flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-navy text-white transition-all duration-150 opacity-0 scale-75 group-hover:opacity-40"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
      </button>
    </div>
  </div>

  <!-- Warna & Cover (Masing-masing 2 Kolom Grid) -->
  <div class="space-y-3">
    <div class="space-y-1.5">
      <h3 class="text-base font-extrabold text-navy">Warna</h3>
      <div class="grid grid-cols-2 gap-1.5">
        <button type="button" data-print="BW" class="print-chip group flex items-center justify-between gap-2 rounded-xl border-2 border-navy bg-navy/[0.03] px-3 py-2 text-left transition-all duration-150 active:scale-[0.98] cursor-pointer">
          <div class="min-w-0 flex items-baseline gap-x-1.5 whitespace-nowrap">
            <span class="text-sm font-extrabold text-navy leading-tight">Hitam Putih</span>
            <span class="text-xs font-semibold text-slate-600">BW</span>
          </div>
          <span class="print-indicator flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-navy text-white transition-all duration-150 opacity-100 scale-100"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
        </button>

        <button type="button" data-print="FC" class="print-chip group flex items-center justify-between gap-2 rounded-xl border border-slate-200/90 bg-white px-3 py-2 text-left transition-all duration-150 hover:border-slate-300 active:scale-[0.98] cursor-pointer">
          <div class="min-w-0 flex items-baseline gap-x-1.5 whitespace-nowrap">
            <span class="text-sm font-extrabold text-navy leading-tight">Full Color</span>
            <span class="text-xs font-semibold text-slate-600">Berwarna</span>
          </div>
          <span class="print-indicator flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-navy text-white transition-all duration-150 opacity-0 scale-75 group-hover:opacity-40"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
        </button>
      </div>
    </div>

    <div class="space-y-1.5">
      <h3 class="text-base font-extrabold text-navy">Cover</h3>
      <div class="grid grid-cols-2 gap-1.5">
        <button type="button" data-cover="Soft Cover" class="cover-chip group flex items-center justify-between gap-2 rounded-xl border-2 border-navy bg-navy/[0.03] px-3 py-2 text-left transition-all duration-150 active:scale-[0.98] cursor-pointer">
          <div class="min-w-0 flex items-baseline gap-x-1.5 whitespace-nowrap">
            <span class="text-sm font-extrabold text-navy leading-tight">Soft Cover</span>
            <span class="text-[11px] font-semibold text-slate-600">Ivory 230/260</span>
          </div>
          <span class="cover-indicator flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-navy text-white transition-all duration-150 opacity-100 scale-100"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
        </button>

        <button type="button" data-cover="Hard Cover" class="cover-chip group flex items-center justify-between gap-2 rounded-xl border border-slate-200/90 bg-white px-3 py-2 text-left transition-all duration-150 hover:border-slate-300 active:scale-[0.98] cursor-pointer">
          <div class="min-w-0 flex items-baseline gap-x-1.5 whitespace-nowrap">
            <span class="text-sm font-extrabold text-navy leading-tight">Hard Cover</span>
            <span class="text-[11px] font-semibold text-slate-600">+Pita &amp; Laminasi</span>
          </div>
          <span class="cover-indicator flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-navy text-white transition-all duration-150 opacity-0 scale-75 group-hover:opacity-40"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
        </button>
      </div>
    </div>
  </div>
</div>
