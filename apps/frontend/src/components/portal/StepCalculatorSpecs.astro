---
/** StepCalculatorSpecs: Format Ukuran, Kertas, Warna, dan Cover (Jejer 1 di Mobile, Jelas & Mudah Diklik) */
---

<div class="border-t border-slate-100 pt-4 space-y-4">
  <!-- 1. Format Ukuran Buku (Jejer 1 di Mobile, 5 Kolom di Desktop) -->
  <div class="space-y-2">
    <div class="flex flex-wrap items-center justify-between gap-x-2 gap-y-0.5">
      <div class="flex items-center gap-2">
        <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-navy text-xs font-extrabold text-white">4</span>
        <h2 class="text-base font-extrabold text-navy">Format Ukuran Buku</h2>
      </div>
      <span class="text-xs font-bold text-orange">A5 &amp; Unesco: Paket Dasar</span>
    </div>

    <div class="grid grid-cols-1 gap-2 sm:grid-cols-5">
      <!-- A5 -->
      <button type="button" data-size="A5" class="size-card group flex items-center justify-between gap-2 sm:flex-col sm:items-start rounded-xl border-2 border-navy bg-navy/[0.03] px-3.5 py-2.5 sm:p-2.5 text-left transition-all duration-150 active:scale-[0.98] cursor-pointer">
        <div class="flex items-center gap-2 sm:block min-w-0">
          <span class="text-sm font-extrabold text-navy leading-tight">A5</span>
          <span class="text-xs font-medium text-slate-600 whitespace-nowrap sm:block sm:mt-0.5">14.8 × 21 cm</span>
          <span class="inline-flex items-center rounded bg-amber-50 border border-amber-200/60 px-1.5 py-0.5 text-xs font-bold text-amber-800 sm:mt-1">Paket Dasar</span>
        </div>
        <span class="size-indicator flex h-5 w-5 sm:h-4 sm:w-4 shrink-0 items-center justify-center rounded-full bg-navy text-white transition-all duration-150 opacity-100 scale-100 sm:self-end"><svg class="h-3 w-3 sm:h-2.5 sm:w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
      </button>

      <!-- Unesco -->
      <button type="button" data-size="Unesco" class="size-card group flex items-center justify-between gap-2 sm:flex-col sm:items-start rounded-xl border border-slate-200/90 bg-white px-3.5 py-2.5 sm:p-2.5 text-left transition-all duration-150 hover:border-slate-300 active:scale-[0.98] cursor-pointer">
        <div class="flex items-center gap-2 sm:block min-w-0">
          <span class="text-sm font-extrabold text-navy leading-tight">Unesco</span>
          <span class="text-xs font-medium text-slate-600 whitespace-nowrap sm:block sm:mt-0.5">15.5 × 23 cm</span>
          <span class="inline-flex items-center rounded bg-amber-50 border border-amber-200/60 px-1.5 py-0.5 text-xs font-bold text-amber-800 sm:mt-1">Paket Dasar</span>
        </div>
        <span class="size-indicator flex h-5 w-5 sm:h-4 sm:w-4 shrink-0 items-center justify-center rounded-full bg-navy text-white transition-all duration-150 opacity-0 scale-75 group-hover:opacity-40 sm:self-end"><svg class="h-3 w-3 sm:h-2.5 sm:w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
      </button>

      <!-- B5 -->
      <button type="button" data-size="B5" class="size-card group flex items-center justify-between gap-2 sm:flex-col sm:items-start rounded-xl border border-slate-200/90 bg-white px-3.5 py-2.5 sm:p-2.5 text-left transition-all duration-150 hover:border-slate-300 active:scale-[0.98] cursor-pointer">
        <div class="flex items-center gap-2 sm:block min-w-0">
          <span class="text-sm font-extrabold text-navy leading-tight">B5</span>
          <span class="text-xs font-medium text-slate-600 whitespace-nowrap sm:block sm:mt-0.5">17.6 × 25 cm</span>
          <span class="inline-flex items-center rounded bg-slate-100 border border-slate-200/60 px-1.5 py-0.5 text-xs font-semibold text-slate-700 sm:mt-1">Buku Ilmiah</span>
        </div>
        <span class="size-indicator flex h-5 w-5 sm:h-4 sm:w-4 shrink-0 items-center justify-center rounded-full bg-navy text-white transition-all duration-150 opacity-0 scale-75 group-hover:opacity-40 sm:self-end"><svg class="h-3 w-3 sm:h-2.5 sm:w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
      </button>

      <!-- A6 Saku -->
      <button type="button" data-size="A6 Saku" class="size-card group flex items-center justify-between gap-2 sm:flex-col sm:items-start rounded-xl border border-slate-200/90 bg-white px-3.5 py-2.5 sm:p-2.5 text-left transition-all duration-150 hover:border-slate-300 active:scale-[0.98] cursor-pointer">
        <div class="flex items-center gap-2 sm:block min-w-0">
          <span class="text-sm font-extrabold text-navy leading-tight">A6 Saku</span>
          <span class="text-xs font-medium text-slate-600 whitespace-nowrap sm:block sm:mt-0.5">10.5 × 14.8 cm</span>
          <span class="inline-flex items-center rounded bg-slate-100 border border-slate-200/60 px-1.5 py-0.5 text-xs font-semibold text-slate-700 sm:mt-1">Buku Saku</span>
        </div>
        <span class="size-indicator flex h-5 w-5 sm:h-4 sm:w-4 shrink-0 items-center justify-center rounded-full bg-navy text-white transition-all duration-150 opacity-0 scale-75 group-hover:opacity-40 sm:self-end"><svg class="h-3 w-3 sm:h-2.5 sm:w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
      </button>

      <!-- A4 -->
      <button type="button" data-size="A4" class="size-card group flex items-center justify-between gap-2 sm:flex-col sm:items-start rounded-xl border border-slate-200/90 bg-white px-3.5 py-2.5 sm:p-2.5 text-left transition-all duration-150 hover:border-slate-300 active:scale-[0.98] cursor-pointer">
        <div class="flex items-center gap-2 sm:block min-w-0">
          <span class="text-sm font-extrabold text-navy leading-tight">A4</span>
          <span class="text-xs font-medium text-slate-600 whitespace-nowrap sm:block sm:mt-0.5">21 × 29.7 cm</span>
          <span class="inline-flex items-center rounded bg-slate-100 border border-slate-200/60 px-1.5 py-0.5 text-xs font-semibold text-slate-700 sm:mt-1">Modul / Majalah</span>
        </div>
        <span class="size-indicator flex h-5 w-5 sm:h-4 sm:w-4 shrink-0 items-center justify-center rounded-full bg-navy text-white transition-all duration-150 opacity-0 scale-75 group-hover:opacity-40 sm:self-end"><svg class="h-3 w-3 sm:h-2.5 sm:w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
      </button>
    </div>
  </div>

  <!-- 2. Jenis Kertas Isi (Jejer 1 di Mobile, 2 Kolom di Desktop) -->
  <div class="space-y-2">
    <div class="flex flex-wrap items-center justify-between gap-x-2 gap-y-0.5">
      <h3 class="text-sm font-extrabold text-navy">Jenis Kertas Isi</h3>
      <span class="text-xs font-bold text-orange">BP 57 &amp; HVS 70: Paket Dasar</span>
    </div>
    <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
      <button type="button" data-paper="bp57" class="paper-chip group flex items-center justify-between gap-2 rounded-xl border-2 border-navy bg-navy/[0.03] px-3.5 py-2.5 text-left transition-all duration-150 active:scale-[0.98] cursor-pointer">
        <div class="min-w-0">
          <span class="text-sm font-extrabold text-navy block truncate leading-tight">Bookpaper 57 gr</span>
          <span class="text-xs text-slate-600 block truncate mt-0.5">Krem Lembut · Paket Dasar</span>
        </div>
        <span class="paper-indicator flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-navy text-white transition-all duration-150 opacity-100 scale-100"><svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
      </button>

      <button type="button" data-paper="hvs70" class="paper-chip group flex items-center justify-between gap-2 rounded-xl border border-slate-200/90 bg-white px-3.5 py-2.5 text-left transition-all duration-150 hover:border-slate-300 active:scale-[0.98] cursor-pointer">
        <div class="min-w-0">
          <span class="text-sm font-extrabold text-navy block truncate leading-tight">HVS 70 gr</span>
          <span class="text-xs text-slate-600 block truncate mt-0.5">Putih Bersih · Paket Dasar</span>
        </div>
        <span class="paper-indicator flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-navy text-white transition-all duration-150 opacity-0 scale-75 group-hover:opacity-40"><svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
      </button>

      <button type="button" data-paper="bp72" class="paper-chip group flex items-center justify-between gap-2 rounded-xl border border-slate-200/90 bg-white px-3.5 py-2.5 text-left transition-all duration-150 hover:border-slate-300 active:scale-[0.98] cursor-pointer">
        <div class="min-w-0">
          <span class="text-sm font-extrabold text-navy block truncate leading-tight">Bookpaper 72 gr</span>
          <span class="text-xs text-slate-600 block truncate mt-0.5">Krem Tebal · Premium</span>
        </div>
        <span class="paper-indicator flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-navy text-white transition-all duration-150 opacity-0 scale-75 group-hover:opacity-40"><svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
      </button>

      <button type="button" data-paper="hvs80" class="paper-chip group flex items-center justify-between gap-2 rounded-xl border border-slate-200/90 bg-white px-3.5 py-2.5 text-left transition-all duration-150 hover:border-slate-300 active:scale-[0.98] cursor-pointer">
        <div class="min-w-0">
          <span class="text-sm font-extrabold text-navy block truncate leading-tight">HVS 80 gr</span>
          <span class="text-xs text-slate-600 block truncate mt-0.5">Putih Padat · Premium</span>
        </div>
        <span class="paper-indicator flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-navy text-white transition-all duration-150 opacity-0 scale-75 group-hover:opacity-40"><svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
      </button>
    </div>
  </div>

  <!-- 3. Warna Cetak & Finishing Cover -->
  <div class="grid sm:grid-cols-2 gap-3.5">
    <div class="space-y-2">
      <h3 class="text-sm font-extrabold text-navy">Warna Cetak Isi</h3>
      <div class="grid grid-cols-2 gap-2">
        <button type="button" data-print="BW" class="print-chip group flex items-center justify-between gap-2 rounded-xl border-2 border-navy bg-navy/[0.03] px-3 py-2.5 text-left transition-all duration-150 active:scale-[0.98] cursor-pointer">
          <div class="min-w-0">
            <span class="text-sm font-extrabold text-navy block truncate leading-tight">Hitam Putih</span>
            <span class="text-xs text-slate-600 block truncate mt-0.5">Standar BW</span>
          </div>
          <span class="print-indicator flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-navy text-white transition-all duration-150 opacity-100 scale-100"><svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
        </button>

        <button type="button" data-print="FC" class="print-chip group flex items-center justify-between gap-2 rounded-xl border border-slate-200/90 bg-white px-3 py-2.5 text-left transition-all duration-150 hover:border-slate-300 active:scale-[0.98] cursor-pointer">
          <div class="min-w-0">
            <span class="text-sm font-extrabold text-navy block truncate leading-tight">Full Color</span>
            <span class="text-xs text-slate-600 block truncate mt-0.5">Berwarna</span>
          </div>
          <span class="print-indicator flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-navy text-white transition-all duration-150 opacity-0 scale-75 group-hover:opacity-40"><svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
        </button>
      </div>
    </div>

    <div class="space-y-2">
      <h3 class="text-sm font-extrabold text-navy">Finishing Cover</h3>
      <div class="grid grid-cols-2 gap-2">
        <button type="button" data-cover="Soft Cover" class="cover-chip group flex items-center justify-between gap-2 rounded-xl border-2 border-navy bg-navy/[0.03] px-3 py-2.5 text-left transition-all duration-150 active:scale-[0.98] cursor-pointer">
          <div class="min-w-0">
            <span class="text-sm font-extrabold text-navy block truncate leading-tight">Soft Cover</span>
            <span class="text-xs text-slate-600 block truncate mt-0.5">Ivory 230/260</span>
          </div>
          <span class="cover-indicator flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-navy text-white transition-all duration-150 opacity-100 scale-100"><svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
        </button>

        <button type="button" data-cover="Hard Cover" class="cover-chip group flex items-center justify-between gap-2 rounded-xl border border-slate-200/90 bg-white px-3 py-2.5 text-left transition-all duration-150 hover:border-slate-300 active:scale-[0.98] cursor-pointer">
          <div class="min-w-0">
            <span class="text-sm font-extrabold text-navy block truncate leading-tight">Hard Cover</span>
            <span class="text-xs text-slate-600 block truncate mt-0.5">+Pita &amp; Laminasi</span>
          </div>
          <span class="cover-indicator flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-navy text-white transition-all duration-150 opacity-0 scale-75 group-hover:opacity-40"><svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
        </button>
      </div>
    </div>
  </div>
</div>
