---
/** StepCalculatorSpecs: Format Ukuran, Kertas, Warna, dan Cover (Editorial Anti-Slop) */
---

<div class="border-t border-slate-100 pt-5 space-y-6">
  <!-- 1. Format Ukuran Buku (5 Kolom Seimbang, Elegan, Anti-Hollow Radio) -->
  <div class="space-y-2.5">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-navy text-[11px] font-extrabold text-white">4</span>
        <h2 class="text-sm sm:text-[15px] font-extrabold text-navy">Format Ukuran Buku</h2>
      </div>
      <span class="text-xs font-bold text-orange">A5 & Unesco Termasuk Paket Dasar</span>
    </div>

    <!-- 5 Ukuran: Horizontal Rail di Mobile, 5 Kolom Proporsional di Desktop -->
    <div class="flex max-w-full overflow-x-auto snap-x snap-mandatory gap-2.5 pb-1.5 sm:grid sm:grid-cols-5 sm:overflow-visible sm:pb-0">
      <!-- A5 -->
      <button type="button" data-size="A5" class="size-card shrink-0 w-[132px] sm:w-auto snap-start group relative flex flex-col justify-between rounded-xl border-2 border-navy bg-navy/[0.03] p-2.5 text-left transition-all duration-150 hover:-translate-y-0.5 active:translate-y-0 shadow-xs cursor-pointer min-h-[86px]">
        <div class="flex items-center justify-between">
          <span class="text-sm font-extrabold text-navy group-hover:text-orange transition-colors">A5</span>
          <span class="size-indicator flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-navy text-white text-[9px] shadow-2xs transition-all duration-150 opacity-100 scale-100"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
        </div>
        <div class="mt-2 space-y-1">
          <span class="text-xs font-medium text-slate-700 whitespace-nowrap block">14.8 × 21 cm</span>
          <span class="inline-flex items-center rounded-md bg-amber-50 border border-amber-200/60 px-1.5 py-0.5 text-[10px] font-bold text-amber-800">Paket Dasar</span>
        </div>
      </button>

      <!-- Unesco -->
      <button type="button" data-size="Unesco" class="size-card shrink-0 w-[132px] sm:w-auto snap-start group relative flex flex-col justify-between rounded-xl border border-slate-200/90 bg-white p-2.5 text-left transition-all duration-150 hover:border-slate-300 hover:-translate-y-0.5 active:translate-y-0 shadow-2xs cursor-pointer min-h-[86px]">
        <div class="flex items-center justify-between">
          <span class="text-sm font-extrabold text-navy group-hover:text-orange transition-colors">Unesco</span>
          <span class="size-indicator flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-navy text-white text-[9px] shadow-2xs transition-all duration-150 opacity-0 scale-75 group-hover:opacity-40"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
        </div>
        <div class="mt-2 space-y-1">
          <span class="text-xs font-medium text-slate-700 whitespace-nowrap block">15.5 × 23 cm</span>
          <span class="inline-flex items-center rounded-md bg-amber-50 border border-amber-200/60 px-1.5 py-0.5 text-[10px] font-bold text-amber-800">Paket Dasar</span>
        </div>
      </button>

      <!-- B5 -->
      <button type="button" data-size="B5" class="size-card shrink-0 w-[132px] sm:w-auto snap-start group relative flex flex-col justify-between rounded-xl border border-slate-200/90 bg-white p-2.5 text-left transition-all duration-150 hover:border-slate-300 hover:-translate-y-0.5 active:translate-y-0 shadow-2xs cursor-pointer min-h-[86px]">
        <div class="flex items-center justify-between">
          <span class="text-sm font-extrabold text-navy group-hover:text-orange transition-colors">B5</span>
          <span class="size-indicator flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-navy text-white text-[9px] shadow-2xs transition-all duration-150 opacity-0 scale-75 group-hover:opacity-40"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
        </div>
        <div class="mt-2 space-y-1">
          <span class="text-xs font-medium text-slate-700 whitespace-nowrap block">17.6 × 25 cm</span>
          <span class="inline-flex items-center rounded-md bg-slate-100 border border-slate-200/60 px-1.5 py-0.5 text-[10px] font-semibold text-slate-700">Buku Ilmiah</span>
        </div>
      </button>

      <!-- A6 Saku -->
      <button type="button" data-size="A6 Saku" class="size-card shrink-0 w-[132px] sm:w-auto snap-start group relative flex flex-col justify-between rounded-xl border border-slate-200/90 bg-white p-2.5 text-left transition-all duration-150 hover:border-slate-300 hover:-translate-y-0.5 active:translate-y-0 shadow-2xs cursor-pointer min-h-[86px]">
        <div class="flex items-center justify-between">
          <span class="text-sm font-extrabold text-navy group-hover:text-orange transition-colors">A6</span>
          <span class="size-indicator flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-navy text-white text-[9px] shadow-2xs transition-all duration-150 opacity-0 scale-75 group-hover:opacity-40"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
        </div>
        <div class="mt-2 space-y-1">
          <span class="text-xs font-medium text-slate-700 whitespace-nowrap block">10.5 × 14.8 cm</span>
          <span class="inline-flex items-center rounded-md bg-slate-100 border border-slate-200/60 px-1.5 py-0.5 text-[10px] font-semibold text-slate-700">Buku Saku</span>
        </div>
      </button>

      <!-- A4 -->
      <button type="button" data-size="A4" class="size-card shrink-0 w-[132px] sm:w-auto snap-start group relative flex flex-col justify-between rounded-xl border border-slate-200/90 bg-white p-2.5 text-left transition-all duration-150 hover:border-slate-300 hover:-translate-y-0.5 active:translate-y-0 shadow-2xs cursor-pointer min-h-[86px]">
        <div class="flex items-center justify-between">
          <span class="text-sm font-extrabold text-navy group-hover:text-orange transition-colors">A4</span>
          <span class="size-indicator flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-navy text-white text-[9px] shadow-2xs transition-all duration-150 opacity-0 scale-75 group-hover:opacity-40"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
        </div>
        <div class="mt-2 space-y-1">
          <span class="text-xs font-medium text-slate-700 whitespace-nowrap block">21 × 29.7 cm</span>
          <span class="inline-flex items-center rounded-md bg-slate-100 border border-slate-200/60 px-1.5 py-0.5 text-[10px] font-semibold text-slate-700">Modul / Majalah</span>
        </div>
      </button>
    </div>
  </div>

  <!-- 2. Jenis Kertas Isi (Simetris: 2x2 Grid) -->
  <div class="space-y-2.5">
    <div class="flex items-center justify-between">
      <h3 class="text-[13px] font-extrabold text-navy">Jenis Kertas Isi</h3>
      <span class="text-[11px] font-bold text-orange">BP 57 & HVS 70 Termasuk Paket Dasar</span>
    </div>
    <div class="grid grid-cols-2 gap-2.5">
      <button type="button" data-paper="bp57" class="paper-chip group relative flex items-center justify-between rounded-xl border-2 border-navy bg-navy/[0.03] p-2.5 text-left transition-all duration-150 hover:scale-[1.01] active:scale-[0.98] shadow-xs cursor-pointer">
        <div class="flex items-center gap-2.5 min-w-0">
          <span class="h-8 w-8 rounded-lg bg-[#FAF4E6] border border-amber-300 flex items-center justify-center shrink-0 shadow-2xs text-[11px] font-black text-amber-800">BP</span>
          <div class="min-w-0">
            <span class="text-[13px] font-extrabold text-navy block truncate">Bookpaper 57 gr</span>
            <div class="flex items-center gap-1 mt-0.5">
              <span class="rounded bg-amber-50 border border-amber-200/60 px-1 py-0.2 text-[10px] font-extrabold text-amber-800 shrink-0">Paket Dasar</span>
              <span class="text-[11px] text-slate-600 truncate">Krem Lembut</span>
            </div>
          </div>
        </div>
        <span class="paper-indicator flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-navy text-white text-[9px] shadow-2xs transition-all duration-150 opacity-100 scale-100"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
      </button>

      <button type="button" data-paper="hvs70" class="paper-chip group relative flex items-center justify-between rounded-xl border border-slate-200/90 bg-white p-2.5 text-left transition-all duration-150 hover:border-slate-300 hover:scale-[1.01] active:scale-[0.98] cursor-pointer">
        <div class="flex items-center gap-2.5 min-w-0">
          <span class="h-8 w-8 rounded-lg bg-white border border-slate-300 flex items-center justify-center shrink-0 shadow-2xs text-[11px] font-black text-slate-700">HVS</span>
          <div class="min-w-0">
            <span class="text-[13px] font-extrabold text-navy block truncate">HVS 70 gr</span>
            <div class="flex items-center gap-1 mt-0.5">
              <span class="rounded bg-amber-50 border border-amber-200/60 px-1 py-0.2 text-[10px] font-extrabold text-amber-800 shrink-0">Paket Dasar</span>
              <span class="text-[11px] text-slate-600 truncate">Putih Bersih</span>
            </div>
          </div>
        </div>
        <span class="paper-indicator flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-navy text-white text-[9px] shadow-2xs transition-all duration-150 opacity-0 scale-75 group-hover:opacity-40"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
      </button>

      <button type="button" data-paper="bp72" class="paper-chip group relative flex items-center justify-between rounded-xl border border-slate-200/90 bg-white p-2.5 text-left transition-all duration-150 hover:border-slate-300 hover:scale-[1.01] active:scale-[0.98] cursor-pointer">
        <div class="flex items-center gap-2.5 min-w-0">
          <span class="h-8 w-8 rounded-lg bg-[#F2E7D0] border border-amber-300 flex items-center justify-center shrink-0 shadow-2xs text-[11px] font-black text-amber-900">BP+</span>
          <div class="min-w-0">
            <span class="text-[13px] font-extrabold text-navy block truncate">Bookpaper 72 gr</span>
            <div class="flex items-center gap-1 mt-0.5">
              <span class="rounded bg-slate-100 border border-slate-200/60 px-1 py-0.2 text-[10px] font-bold text-slate-700 shrink-0">Premium</span>
              <span class="text-[11px] text-slate-600 truncate">Krem Tebal</span>
            </div>
          </div>
        </div>
        <span class="paper-indicator flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-navy text-white text-[9px] shadow-2xs transition-all duration-150 opacity-0 scale-75 group-hover:opacity-40"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
      </button>

      <button type="button" data-paper="hvs80" class="paper-chip group relative flex items-center justify-between rounded-xl border border-slate-200/90 bg-white p-2.5 text-left transition-all duration-150 hover:border-slate-300 hover:scale-[1.01] active:scale-[0.98] cursor-pointer">
        <div class="flex items-center gap-2.5 min-w-0">
          <span class="h-8 w-8 rounded-lg bg-slate-50 border border-slate-300 flex items-center justify-center shrink-0 shadow-2xs text-[11px] font-black text-slate-700">HVS+</span>
          <div class="min-w-0">
            <span class="text-[13px] font-extrabold text-navy block truncate">HVS 80 gr</span>
            <div class="flex items-center gap-1 mt-0.5">
              <span class="rounded bg-slate-100 border border-slate-200/60 px-1 py-0.2 text-[10px] font-bold text-slate-700 shrink-0">Premium</span>
              <span class="text-[11px] text-slate-600 truncate">Putih Padat</span>
            </div>
          </div>
        </div>
        <span class="paper-indicator flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-navy text-white text-[9px] shadow-2xs transition-all duration-150 opacity-0 scale-75 group-hover:opacity-40"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
      </button>
    </div>
  </div>

  <!-- 3. Warna Cetak Isi (Simetris: 2 Kolom) -->
  <div class="space-y-2.5">
    <h3 class="text-[13px] font-extrabold text-navy">Warna Cetak Isi</h3>
    <div class="grid grid-cols-2 gap-2.5">
      <button type="button" data-print="BW" class="print-chip group relative flex items-center justify-between rounded-xl border-2 border-navy bg-navy/[0.03] p-2.5 text-left transition-all duration-150 hover:scale-[1.01] active:scale-[0.98] shadow-xs cursor-pointer">
        <div class="flex items-center gap-2.5 min-w-0">
          <span class="h-8 w-8 rounded-lg bg-slate-900 text-white flex items-center justify-center text-[11px] font-black shrink-0 shadow-2xs">BW</span>
          <div class="min-w-0">
            <span class="text-[13px] font-extrabold text-navy block truncate">Hitam Putih</span>
            <span class="text-xs text-slate-700 block truncate">Standar Naskah</span>
          </div>
        </div>
        <span class="print-indicator flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-navy text-white text-[9px] shadow-2xs transition-all duration-150 opacity-100 scale-100"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
      </button>

      <button type="button" data-print="FC" class="print-chip group relative flex items-center justify-between rounded-xl border border-slate-200/90 bg-white p-2.5 text-left transition-all duration-150 hover:border-slate-300 hover:scale-[1.01] active:scale-[0.98] cursor-pointer">
        <div class="flex items-center gap-2.5 min-w-0">
          <span class="h-8 w-8 rounded-lg bg-gradient-to-tr from-pink-500 via-amber-400 to-cyan-500 text-white flex items-center justify-center text-[11px] font-black shrink-0 shadow-2xs">FC</span>
          <div class="min-w-0">
            <span class="text-[13px] font-extrabold text-navy block truncate">Full Color</span>
            <span class="text-xs text-slate-700 block truncate">Cetak Berwarna</span>
          </div>
        </div>
        <span class="print-indicator flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-navy text-white text-[9px] shadow-2xs transition-all duration-150 opacity-0 scale-75 group-hover:opacity-40"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
      </button>
    </div>
  </div>

  <!-- 4. Finishing Cover (Simetris: 2 Kolom) -->
  <div class="space-y-2.5">
    <h3 class="text-[13px] font-extrabold text-navy">Finishing Cover</h3>
    <div class="grid grid-cols-2 gap-2.5">
      <button type="button" data-cover="Soft Cover" class="cover-chip group relative flex items-center justify-between rounded-xl border-2 border-navy bg-navy/[0.03] p-2.5 text-left transition-all duration-150 hover:scale-[1.01] active:scale-[0.98] shadow-xs cursor-pointer">
        <div class="flex items-center gap-2.5 min-w-0">
          <span class="h-8 w-8 rounded-lg bg-amber-50 border border-amber-200 flex items-center justify-center shrink-0 shadow-2xs text-amber-700">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          </span>
          <div class="min-w-0">
            <span class="text-[13px] font-extrabold text-navy block truncate">Soft Cover</span>
            <span class="text-xs text-slate-700 block truncate">Ivory 230/260 gr</span>
          </div>
        </div>
        <span class="cover-indicator flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-navy text-white text-[9px] shadow-2xs transition-all duration-150 opacity-100 scale-100"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
      </button>

      <button type="button" data-cover="Hard Cover" class="cover-chip group relative flex items-center justify-between rounded-xl border border-slate-200/90 bg-white p-2.5 text-left transition-all duration-150 hover:border-slate-300 hover:scale-[1.01] active:scale-[0.98] cursor-pointer">
        <div class="flex items-center gap-2.5 min-w-0">
          <span class="h-8 w-8 rounded-lg bg-slate-900 border border-slate-700 flex items-center justify-center shrink-0 shadow-2xs text-amber-400">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M6 2v20"/></svg>
          </span>
          <div class="min-w-0">
            <span class="text-[13px] font-extrabold text-navy block truncate">Hard Cover</span>
            <span class="text-xs text-slate-700 block truncate">+Pita & Laminasi</span>
          </div>
        </div>
        <span class="cover-indicator flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-navy text-white text-[9px] shadow-2xs transition-all duration-150 opacity-0 scale-75 group-hover:opacity-40"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
      </button>
    </div>
  </div>
</div>
