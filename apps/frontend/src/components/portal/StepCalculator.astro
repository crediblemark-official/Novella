---
/**
 * StepCalculator: Simulasi Biaya Cetak & Pengajuan Naskah
 * Perhitungan estimasi biaya transparan dengan standar penerbitan Novella.id.
 */
import StepCalculatorSpecs from './StepCalculatorSpecs.astro';
import StepCalculatorAddons from './StepCalculatorAddons.astro';
import MobileStickyBar from './MobileStickyBar.astro';
---

<div id="step-calc" class="pb-20 md:pb-0">
  <div class="grid lg:grid-cols-12 gap-8 lg:gap-12">
    <!-- Sisi Kiri: Spesifikasi Naskah & Pilihan Buku (7 Kolom) -->
    <div class="lg:col-span-7 min-w-0 space-y-6">
      
      <!-- 0. Informasi Naskah Buku -->
      <div class="space-y-3">
        <div class="flex items-center gap-2">
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-navy text-[10px] font-extrabold text-white">1</span>
          <h2 class="text-sm font-extrabold text-navy">Informasi Naskah Buku</h2>
        </div>
        <div class="grid sm:grid-cols-2 gap-3 pt-0.5">
          <div>
            <label for="input-book-title" class="block text-[11px] font-bold text-navy mb-1">Judul Buku / Judul Kerja <span class="text-rose-500">*</span></label>
            <input id="input-book-title" type="text" required placeholder="Contoh: Lembayung Jogja" class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-xs font-semibold text-navy focus:border-navy focus:outline-none focus:ring-2 focus:ring-navy/5 shadow-2xs" />
          </div>
          <div>
            <label for="select-book-category" class="block text-[11px] font-bold text-navy mb-1">Kategori / Genre Sastra <span class="text-rose-500">*</span></label>
            <select id="select-book-category" class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-navy focus:border-navy focus:outline-none shadow-2xs cursor-pointer">
              <option value="Novel Sastra" selected>Novel Sastra & Populer</option>
              <option value="Kumpulan Cerpen">Kumpulan Cerpen</option>
              <option value="Antologi Puisi">Antologi Puisi</option>
              <option value="Memoar & Biografi">Memoar & Biografi</option>
              <option value="Esai & Karya Ilmiah">Esai & Non-Fiksi</option>
              <option value="Karya Sastra Lainnya">Karya Sastra Lainnya</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Banner Paket Dasar Penerbitan Rp 150.000 (Simetris Seimbang) -->
      <div class="rounded-2xl border border-amber-200/90 bg-amber-50/60 p-4 text-xs text-amber-950 space-y-2">
        <div class="flex items-center justify-between gap-2">
          <div class="flex items-center gap-2 min-w-0">
            <span class="text-amber-600 shrink-0">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
            </span>
            <p class="font-extrabold text-amber-950 text-xs sm:text-sm truncate">Paket Dasar Penerbitan Novella</p>
          </div>
          <span class="shrink-0 rounded-full bg-orange/15 px-2.5 py-0.5 text-[10px] font-extrabold text-orange">Hemat Rp 300.000</span>
        </div>
        <p class="text-[11px] leading-relaxed text-amber-900/90">
          Hanya <strong>Rp 150.000</strong> (<span class="line-through text-slate-500 font-semibold">Rp 450.000</span>) mendapatkan <strong>5 eksemplar</strong> buku fisik hingga <strong>100 halaman</strong> (format <strong>A5 / Unesco</strong>). Kertas isi: <strong>Bookpaper 57 gr</strong> atau <strong>HVS 70 gr</strong>.
        </p>
        <div class="grid grid-cols-3 gap-2 pt-2 border-t border-amber-200/60 text-center text-[10px] font-bold text-emerald-800">
          <span class="rounded bg-emerald-50/80 py-1">✓ ISBN Resmi</span>
          <span class="rounded bg-emerald-50/80 py-1">✓ Desain Cover</span>
          <span class="rounded bg-emerald-50/80 py-1">✓ Layout Naskah</span>
        </div>
      </div>

      <!-- 1. Estimasi Ketebalan Halaman (Header Seimbang & 4 Grid Simetris) -->
      <div class="border-t border-slate-100 pt-5 space-y-3">
        <div class="flex items-center justify-between gap-2">
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-navy text-[10px] font-extrabold text-white">2</span>
              <h2 class="text-xs sm:text-sm font-extrabold text-navy truncate">Estimasi Halaman Naskah</h2>
            </div>
            <p class="text-[10px] sm:text-[11px] text-slate-500 mt-0.5 truncate">Maksimal 100 halaman pada Paket Dasar.</p>
          </div>
          <div class="inline-flex items-center rounded-xl border border-slate-200 bg-slate-50/80 p-0.5 shadow-2xs shrink-0">
            <button id="btn-page-minus" type="button" class="flex h-8 w-8 items-center justify-center rounded-lg bg-white text-sm font-extrabold text-navy shadow-xs hover:bg-slate-100 cursor-pointer active:scale-95 transition-all" aria-label="Kurangi halaman">−</button>
            <div class="flex items-center px-2">
              <input id="input-pages" type="number" min="24" max="600" value="100" class="h-8 w-11 bg-transparent text-center font-mono text-xs sm:text-sm font-extrabold text-navy focus:outline-none" />
              <span class="text-[10px] sm:text-[11px] font-bold text-slate-400">hal</span>
            </div>
            <button id="btn-page-plus" type="button" class="flex h-8 w-8 items-center justify-center rounded-lg bg-white text-sm font-extrabold text-navy shadow-xs hover:bg-slate-100 cursor-pointer active:scale-95 transition-all" aria-label="Tambah halaman">+</button>
          </div>
        </div>
        <div class="grid grid-cols-4 gap-2 pt-0.5">
          <button type="button" data-val="60" class="page-chip rounded-xl border border-slate-200 bg-white py-2 text-center text-xs font-semibold text-slate-600 hover:bg-slate-50 cursor-pointer transition-all duration-150 hover:scale-[1.01] active:scale-[0.98]">60 hal</button>
          <button type="button" data-val="100" class="page-chip rounded-xl border-2 border-navy bg-navy py-2 text-center text-xs font-bold text-white shadow-xs cursor-pointer transition-all duration-150 hover:scale-[1.01] active:scale-[0.98]">100 hal ★</button>
          <button type="button" data-val="150" class="page-chip rounded-xl border border-slate-200 bg-white py-2 text-center text-xs font-semibold text-slate-600 hover:bg-slate-50 cursor-pointer transition-all duration-150 hover:scale-[1.01] active:scale-[0.98]">150 hal</button>
          <button type="button" data-val="200" class="page-chip rounded-xl border border-slate-200 bg-white py-2 text-center text-xs font-semibold text-slate-600 hover:bg-slate-50 cursor-pointer transition-all duration-150 hover:scale-[1.01] active:scale-[0.98]">200 hal</button>
        </div>
      </div>

      <!-- 2. Jumlah Eksemplar Cetak (Header Seimbang & 5 Grid Simetris) -->
      <div class="border-t border-slate-100 pt-5 space-y-3">
        <div class="flex items-center justify-between gap-2">
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-navy text-[10px] font-extrabold text-white">3</span>
              <h2 class="text-xs sm:text-sm font-extrabold text-navy truncate">Jumlah Cetak Buku Fisik</h2>
            </div>
            <p class="text-[10px] sm:text-[11px] text-slate-500 mt-0.5 truncate">Minimal 5 eksemplar per pesanan.</p>
          </div>
          <div class="inline-flex items-center rounded-xl border border-slate-200 bg-slate-50/80 p-0.5 shadow-2xs shrink-0">
            <button id="btn-copy-minus" type="button" class="flex h-8 w-8 items-center justify-center rounded-lg bg-white text-sm font-extrabold text-navy shadow-xs hover:bg-slate-100 cursor-pointer active:scale-95 transition-all" aria-label="Kurangi eksemplar">−</button>
            <div class="flex items-center px-2">
              <input id="input-copies" type="number" min="5" max="1000" value="5" class="h-8 w-11 bg-transparent text-center font-mono text-xs sm:text-sm font-extrabold text-navy focus:outline-none" />
              <span class="text-[10px] sm:text-[11px] font-bold text-slate-400">eks</span>
            </div>
            <button id="btn-copy-plus" type="button" class="flex h-8 w-8 items-center justify-center rounded-lg bg-white text-sm font-extrabold text-navy shadow-xs hover:bg-slate-100 cursor-pointer active:scale-95 transition-all" aria-label="Tambah eksemplar">+</button>
          </div>
        </div>
        <div class="grid grid-cols-5 gap-1.5 pt-0.5">
          <button type="button" data-val="5" class="copy-chip rounded-xl border-2 border-navy bg-navy py-2 text-center text-xs font-bold text-white shadow-xs cursor-pointer transition-all duration-150 hover:scale-[1.01] active:scale-[0.98]">5 eks ★</button>
          <button type="button" data-val="10" class="copy-chip rounded-xl border border-slate-200 bg-white py-2 text-center text-xs font-semibold text-slate-600 hover:bg-slate-50 cursor-pointer transition-all duration-150 hover:scale-[1.01] active:scale-[0.98]">10 eks</button>
          <button type="button" data-val="25" class="copy-chip rounded-xl border border-slate-200 bg-white py-2 text-center text-xs font-semibold text-slate-600 hover:bg-slate-50 cursor-pointer transition-all duration-150 hover:scale-[1.01] active:scale-[0.98]">25 eks</button>
          <button type="button" data-val="50" class="copy-chip rounded-xl border border-slate-200 bg-white py-2 text-center text-xs font-semibold text-slate-600 hover:bg-slate-50 cursor-pointer transition-all duration-150 hover:scale-[1.01] active:scale-[0.98]">50 eks</button>
          <button type="button" data-val="100" class="copy-chip rounded-xl border border-slate-200 bg-white py-2 text-center text-xs font-semibold text-slate-600 hover:bg-slate-50 cursor-pointer transition-all duration-150 hover:scale-[1.01] active:scale-[0.98]">100 eks</button>
        </div>
      </div>

      <!-- 3. Format Ukuran, Kertas & Cover -->
      <StepCalculatorSpecs />

      <!-- 4. Layanan Tambahan / Addon -->
      <StepCalculatorAddons />
    </div>

    <!-- Sisi Kanan: Tiket Estimasi (5 Kolom Docked) -->
    <div class="lg:col-span-5 min-w-0 border-t lg:border-t-0 lg:border-l border-slate-200/80 lg:pl-10 pt-6 lg:pt-0 self-stretch">
      <div class="sticky top-20 space-y-5">
        <div>
          <div class="flex items-center justify-between">
            <span class="rounded-full bg-orange/10 px-3 py-1 text-xs font-bold text-orange">Paket Terbit Spesial</span>
            <span class="text-[11px] font-bold text-emerald-700 flex items-center gap-1.5">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              Real-time
            </span>
          </div>
          <div class="mt-3 flex items-baseline gap-2.5">
            <p id="summary-total" class="font-mono text-3xl sm:text-4xl font-black text-navy tracking-tight">Rp 150.000</p>
            <span id="summary-original" class="font-mono text-base sm:text-lg font-bold text-slate-400 line-through">Rp 450.000</span>
          </div>
          <p id="summary-perbook" class="mt-0.5 text-xs font-semibold text-slate-500">Sekitar Rp 30.000 / buku (5 eksemplar)</p>

          <!-- Card Saran Genap / Upsell Cerdas (Tampil jika harga ganjil) -->
          <div id="suggestion-box" class="hidden mt-3.5 rounded-2xl border border-amber-300/80 bg-gradient-to-br from-amber-50/90 to-orange/5 p-3.5 space-y-2.5 shadow-xs transition-all">
            <div class="flex items-center justify-between gap-1">
              <div class="flex items-center gap-1.5 text-amber-900 font-extrabold text-xs">
                <span class="text-sm">💡</span>
                <span>Saran Biar Harga Pas & Genap:</span>
              </div>
              <span class="rounded-full bg-amber-200/70 px-2 py-0.5 text-[9px] font-black text-amber-900">Tips Hemat</span>
            </div>
            <p class="text-[11px] text-amber-950/80 leading-snug">
              Total biaya saat ini bernilai nanggung/ganjil. Pilih opsi di bawah agar biayanya pas sekaligus lebih menguntungkan:
            </p>
            <div id="suggestion-items" class="space-y-2 pt-0.5">
              <!-- Dynamically populated suggestions -->
            </div>
          </div>
        </div>

        <div class="divide-y divide-slate-100 text-xs text-slate-600 border-t border-b border-slate-100">
          <div class="py-2.5 flex justify-between font-semibold text-slate-800">
            <div>
              <p>Paket Dasar (5 eks / 100 hal · A5/Unesco)</p>
              <p class="text-[10px] text-emerald-600 font-bold">✓ Sudah Termasuk: ISBN, Cover, & Layout</p>
            </div>
            <div class="text-right">
              <span class="font-mono font-bold text-navy">Rp 150.000</span>
              <span class="block text-[10px] text-slate-400 line-through">Rp 450.000</span>
            </div>
          </div>
          <div id="row-summary-copies" class="py-2.5 hidden justify-between">
            <span id="label-summary-copies">Tambahan cetak</span>
            <span id="val-summary-copies" class="font-mono font-bold text-orange">+ Rp 0</span>
          </div>
          <div id="row-summary-pages" class="py-2.5 hidden justify-between">
            <span id="label-summary-pages">Tambahan halaman</span>
            <span id="val-summary-pages" class="font-mono font-bold text-orange">+ Rp 0</span>
          </div>
          <div class="py-2.5 space-y-1">
            <div class="flex justify-between items-center text-xs">
              <span class="text-slate-600 font-semibold">Format Buku:</span>
              <span id="val-summary-size" class="shrink-0 whitespace-nowrap rounded bg-orange/15 px-2 py-0.5 text-[10px] font-bold text-orange">Paket Dasar</span>
            </div>
            <p id="label-summary-size" class="text-[11px] font-medium text-slate-700">A5 · Hitam Putih (BW) · Bookpaper 57 gr · Soft Cover</p>
          </div>
          <div id="row-summary-addons" class="py-2.5 hidden space-y-1">
            <p class="text-[11px] font-bold text-slate-400">Add-on Terpilih:</p>
            <div id="list-summary-addons" class="space-y-1 font-mono text-[11px]"></div>
          </div>
        </div>

        <div class="rounded-xl border border-amber-200/80 bg-amber-50/50 p-3 text-[11px] text-amber-950 leading-relaxed space-y-1">
          <p class="font-bold text-amber-900 flex items-center gap-1.5">
            <svg class="h-4 w-4 text-amber-700 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8h1a4 4 0 1 1 0 8h-1"/><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/><line x1="6" x2="6" y1="2" y2="4"/><line x1="10" x2="10" y1="2" y2="4"/></svg>
            <span>Ngobrol Santai Seperti Sahabat Sendiri</span>
          </p>
          <p class="text-[11px] text-amber-900/90">
            Di Novella.id, konsultasi naskah dengan admin redaksi rasanya hangat dan akrab seperti mengobrol dengan sahabat sendiri — bebas bertanya dan berdiskusi tanpa canggung.
          </p>
        </div>

        <div class="pt-1">
          <button
            id="btn-submit-consultation"
            type="button"
            class="group flex w-full items-center justify-center gap-2 rounded-full bg-emerald-600 py-3.5 text-sm font-extrabold text-white shadow-md shadow-emerald-600/20 transition-all duration-150 hover:bg-emerald-700 hover:scale-[1.01] active:scale-[0.98] cursor-pointer"
          >
            <span>Konsultasi Naskah ke Admin &rarr;</span>
          </button>
          <p class="text-center text-[10px] text-slate-400 mt-2">Rincian pesanan akan dikonfirmasikan langsung ke WhatsApp Admin Novella</p>
        </div>
      </div>
    </div>
  </div>

  <MobileStickyBar />
</div>
