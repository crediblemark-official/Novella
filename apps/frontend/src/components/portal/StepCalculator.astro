---
/**
 * StepCalculator: Simulasi Biaya Cetak & Pengajuan Naskah
 * Perhitungan estimasi biaya transparan dengan standar penerbitan Novella.id.
 */
import StepCalculatorSpecs from './StepCalculatorSpecs.astro';
import StepCalculatorAddons from './StepCalculatorAddons.astro';
import MobileStickyBar from './MobileStickyBar.astro';
---

<div id="step-calc" class="pb-20 md:pb-0">
  <div class="grid lg:grid-cols-12 gap-6">
    <!-- Sisi Kiri: Spesifikasi Naskah & Pilihan Buku (7 Kolom) -->
    <div class="lg:col-span-7 min-w-0 space-y-3">
      
      <!-- Naskah -->
      <div class="space-y-1.5">
        <h2 class="text-base font-extrabold text-navy">Naskah</h2>
        <div class="grid sm:grid-cols-2 gap-2">
          <div>
            <label for="input-book-title" class="block text-[15px] font-bold text-navy mb-1">Judul <span class="text-rose-500">*</span></label>
            <input id="input-book-title" type="text" required placeholder="Contoh: Lembayung Jogja" class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-[15px] font-semibold text-navy placeholder:text-slate-500 focus:border-navy focus:outline-none focus:ring-2 focus:ring-navy/5 shadow-2xs" />
          </div>
          <div>
            <label for="select-book-category" class="block text-[15px] font-bold text-navy mb-1">Genre <span class="text-rose-500">*</span></label>
            <select id="select-book-category" class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-[15px] font-semibold text-navy focus:border-navy focus:outline-none shadow-2xs cursor-pointer">
              <option value="Novel Sastra" selected>Novel Sastra & Populer</option>
              <option value="Kumpulan Cerpen">Kumpulan Cerpen</option>
              <option value="Antologi Puisi">Antologi Puisi</option>
              <option value="Memoar & Biografi">Memoar & Biografi</option>
              <option value="Esai & Karya Ilmiah">Esai & Non-Fiksi</option>
              <option value="Karya Sastra Lainnya">Karya Sastra Lainnya</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Info Paket Dasar Penerbitan Rp 150.000 (Tanpa Box) -->
      <div class="border-y border-slate-200/80 py-2 text-sm text-slate-700 space-y-1">
        <div class="flex items-center justify-between gap-2">
          <div class="flex items-center gap-1.5 min-w-0">
            <span class="text-orange shrink-0">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
            </span>
            <p class="font-extrabold text-navy text-[15px] truncate">Paket Dasar</p>
          </div>
          <span class="shrink-0 rounded-full bg-orange/15 px-2.5 py-0.5 text-xs font-extrabold text-orange">Hemat Rp 300rb</span>
        </div>
        <p class="text-sm leading-snug text-slate-700">
          <strong class="text-navy">Rp 150.000</strong> (<span class="line-through text-slate-500">Rp 450.000</span>) · <strong class="text-navy">5 eks</strong> · <strong class="text-navy">100 hal</strong> · <strong class="text-navy">A5/Unesco</strong> · <strong class="text-navy">BP 57 / HVS 70</strong>.
        </p>
      </div>

      <!-- Halaman -->
      <div class="space-y-1.5">
        <div class="flex items-center justify-between gap-2">
          <div class="flex items-baseline gap-2 min-w-0">
            <h2 class="text-base font-extrabold text-navy shrink-0">Halaman</h2>
            <span class="text-sm text-slate-500 truncate">Maks. 100 hal (Dasar)</span>
          </div>
          <div class="inline-flex items-center rounded-lg border border-slate-200 bg-slate-50/80 p-0.5 shadow-2xs shrink-0">
            <button id="btn-page-minus" type="button" class="flex h-8 w-8 items-center justify-center rounded-md bg-white text-base font-extrabold text-navy shadow-xs hover:bg-slate-100 cursor-pointer active:scale-95 transition-all" aria-label="Kurangi halaman">−</button>
            <div class="flex items-center px-1.5">
              <input id="input-pages" type="number" min="24" max="600" value="100" class="h-8 w-11 bg-transparent text-center font-mono text-[15px] font-extrabold text-navy focus:outline-none" />
              <span class="text-sm font-bold text-slate-600">hal</span>
            </div>
            <button id="btn-page-plus" type="button" class="flex h-8 w-8 items-center justify-center rounded-md bg-white text-base font-extrabold text-navy shadow-xs hover:bg-slate-100 cursor-pointer active:scale-95 transition-all" aria-label="Tambah halaman">+</button>
          </div>
        </div>
        <div class="flex flex-wrap gap-1.5">
          <button type="button" data-val="60" class="page-chip inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-2.5 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-50 cursor-pointer transition-all duration-150 active:scale-[0.98]">60 hal</button>
          <button type="button" data-val="100" class="page-chip inline-flex items-center justify-center gap-1 rounded-lg border-2 border-navy bg-navy px-2.5 py-1 text-xs font-bold text-white shadow-xs cursor-pointer transition-all duration-150 active:scale-[0.98]">
            <span>100 hal</span>
            <svg class="h-3 w-3 text-amber-400 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          </button>
          <button type="button" data-val="150" class="page-chip inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-2.5 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-50 cursor-pointer transition-all duration-150 active:scale-[0.98]">150 hal</button>
          <button type="button" data-val="200" class="page-chip inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-2.5 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-50 cursor-pointer transition-all duration-150 active:scale-[0.98]">200 hal</button>
        </div>
      </div>

      <!-- Cetak -->
      <div class="border-t border-slate-100 pt-3 space-y-1.5">
        <div class="flex items-center justify-between gap-2">
          <div class="flex items-baseline gap-2 min-w-0">
            <h2 class="text-base font-extrabold text-navy shrink-0">Cetak</h2>
            <span class="text-sm text-slate-500 truncate">Min. 5 eks</span>
          </div>
          <div class="inline-flex items-center rounded-lg border border-slate-200 bg-slate-50/80 p-0.5 shadow-2xs shrink-0">
            <button id="btn-copy-minus" type="button" class="flex h-8 w-8 items-center justify-center rounded-md bg-white text-base font-extrabold text-navy shadow-xs hover:bg-slate-100 cursor-pointer active:scale-95 transition-all" aria-label="Kurangi eksemplar">−</button>
            <div class="flex items-center px-1.5">
              <input id="input-copies" type="number" min="5" max="1000" value="5" class="h-8 w-11 bg-transparent text-center font-mono text-[15px] font-extrabold text-navy focus:outline-none" />
              <span class="text-sm font-bold text-slate-600">eks</span>
            </div>
            <button id="btn-copy-plus" type="button" class="flex h-8 w-8 items-center justify-center rounded-md bg-white text-base font-extrabold text-navy shadow-xs hover:bg-slate-100 cursor-pointer active:scale-95 transition-all" aria-label="Tambah eksemplar">+</button>
          </div>
        </div>
        <div class="flex flex-wrap gap-1.5">
          <button type="button" data-val="5" class="copy-chip inline-flex items-center justify-center gap-1 rounded-lg border-2 border-navy bg-navy px-2.5 py-1 text-xs font-bold text-white shadow-xs cursor-pointer transition-all duration-150 active:scale-[0.98]">
            <span>5 eks</span>
            <svg class="h-3 w-3 text-amber-400 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          </button>
          <button type="button" data-val="10" class="copy-chip inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-2.5 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-50 cursor-pointer transition-all duration-150 active:scale-[0.98]">10 eks</button>
          <button type="button" data-val="25" class="copy-chip inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-2.5 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-50 cursor-pointer transition-all duration-150 active:scale-[0.98]">25 eks</button>
          <button type="button" data-val="50" class="copy-chip inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-2.5 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-50 cursor-pointer transition-all duration-150 active:scale-[0.98]">50 eks</button>
          <button type="button" data-val="100" class="copy-chip inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-2.5 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-50 cursor-pointer transition-all duration-150 active:scale-[0.98]">100 eks</button>
        </div>
      </div>

      <!-- 3. Format Ukuran, Kertas & Cover -->
      <StepCalculatorSpecs />

      <!-- 4. Layanan Tambahan / Addon -->
      <StepCalculatorAddons />
    </div>

    <!-- Sisi Kanan: Tiket Estimasi (5 Kolom Docked) -->
    <div class="lg:col-span-5 min-w-0 border-t lg:border-t-0 lg:border-l border-slate-200/80 lg:pl-6 pt-5 lg:pt-0 self-stretch">
      <div class="sticky top-20 space-y-5">
        <div>
          <div class="flex items-center justify-between">
            <span class="rounded-full bg-orange/10 px-3 py-1 text-xs font-bold text-orange">Paket Terbit Spesial</span>
            <span class="text-xs font-bold text-emerald-700 flex items-center gap-1.5">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              Real-time
            </span>
          </div>
          <div class="mt-3 flex flex-wrap items-baseline gap-x-2.5 gap-y-0.5">
            <p id="summary-total" class="whitespace-nowrap font-mono text-2xl sm:text-3xl font-black text-navy tracking-tight">Rp 150.000</p>
            <span id="summary-original" class="whitespace-nowrap font-mono text-sm sm:text-base font-bold text-slate-500 line-through">Rp 450.000</span>
          </div>
          <p id="summary-perbook" class="mt-0.5 text-[13px] font-semibold text-slate-700">Sekitar Rp 30.000 / buku (5 eksemplar)</p>

          <!-- Saran Genap / Upsell Cerdas (Borderless Hairline Strip) -->
          <div id="suggestion-box" class="hidden mt-4 border-l-2 border-orange pl-3.5 space-y-2">
            <div class="flex items-center justify-between gap-2">
              <span class="text-xs font-extrabold uppercase tracking-wider text-navy">Saran Harga Pas &amp; Genap</span>
              <span class="text-[11px] font-bold text-orange">Tips Hemat</span>
            </div>
            <div id="suggestion-items" class="divide-y divide-slate-100">
              <!-- Dynamically populated suggestions -->
            </div>
          </div>
        </div>

        <div class="divide-y divide-slate-100 text-sm text-slate-700 border-t border-b border-slate-100">
          <div class="py-2.5 flex justify-between font-semibold text-slate-800">
            <div>
              <p>Paket Dasar (5 eks / 100 hal)</p>
              <p class="mt-0.5 flex items-center gap-1 text-xs text-emerald-700 font-bold">
                <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                <span>Termasuk ISBN, Cover, Layout</span>
              </p>
            </div>
            <div class="text-right">
              <span class="font-mono font-bold text-navy">Rp 150.000</span>
              <span class="block text-xs text-slate-500 line-through">Rp 450.000</span>
            </div>
          </div>
          <div id="row-summary-copies" class="py-2.5 hidden justify-between">
            <span id="label-summary-copies">Tambahan cetak</span>
            <span id="val-summary-copies" class="font-mono font-bold text-orange">+ Rp 0</span>
          </div>
          <div id="row-summary-pages" class="py-2.5 hidden justify-between">
            <span id="label-summary-pages">Tambahan halaman</span>
            <span id="val-summary-pages" class="font-mono font-bold text-orange">+ Rp 0</span>
          </div>
          <div class="py-2.5 space-y-1">
            <div class="flex justify-between items-center text-sm">
              <span class="text-slate-700 font-semibold">Format Buku:</span>
              <span id="val-summary-size" class="shrink-0 whitespace-nowrap rounded bg-orange/15 px-2 py-0.5 text-xs font-bold text-orange">Paket Dasar</span>
            </div>
            <p id="label-summary-size" class="text-xs font-medium text-slate-700">A5 · Hitam Putih (BW) · Bookpaper 57 gr · Soft Cover</p>
          </div>
          <div id="row-summary-addons" class="py-2.5 hidden space-y-1">
            <p class="text-xs font-bold text-slate-600">Add-on Terpilih:</p>
            <div id="list-summary-addons" class="space-y-1 font-mono text-xs"></div>
          </div>
        </div>

        <div class="rounded-xl border border-amber-200/80 bg-amber-50/50 p-3 text-xs text-amber-950 leading-relaxed space-y-1">
          <p class="font-bold text-amber-900 flex items-center gap-1.5 text-sm">
            <svg class="h-4 w-4 text-amber-700 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8h1a4 4 0 1 1 0 8h-1"/><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/><line x1="6" x2="6" y1="2" y2="4"/><line x1="10" x2="10" y1="2" y2="4"/></svg>
            <span>Konsultasi Akrab &amp; Gratis</span>
          </p>
          <p class="text-xs text-amber-900/95">
            Diskusi santai langsung bersama tim redaksi Novella.id.
          </p>
        </div>

        <div class="pt-1">
          <button
            id="btn-submit-consultation"
            type="button"
            class="group flex w-full items-center justify-center gap-2 rounded-full bg-emerald-600 py-3.5 text-sm font-extrabold text-white shadow-md shadow-emerald-600/20 transition-all duration-150 hover:bg-emerald-700 hover:scale-[1.01] active:scale-[0.98] cursor-pointer"
          >
            <span>Konsultasi &rarr;</span>
          </button>
          <p class="text-center text-xs text-slate-600 mt-2">Rincian dikirim ke WhatsApp Admin.</p>
        </div>
      </div>
    </div>
  </div>

  <MobileStickyBar />
</div>
