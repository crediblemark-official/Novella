---
/**
 * StepManuscript: Step 2 (Detail Buku & Berkas Naskah) — Unboxed Flat Studio
 * Open, breathable 12-column layout matching Step 1:
 * - Left (7 cols): Book title input, genre selector, and drag-and-drop uploader
 * - Right (5 cols): Sticky package summary + CTA & back button
 */
---

<div id="step-book" class="hidden">
  <form id="book-meta-form" class="grid lg:grid-cols-12 gap-8 lg:gap-12">
    <!-- Sisi Kiri: Detail Naskah & Unggah Berkas (7 Kolom / ~60%) -->
    <div class="lg:col-span-7 space-y-7">
      
      <!-- 1. Metadata Naskah Buku -->
      <div class="space-y-4">
        <div>
          <div class="flex items-center gap-2">
            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-navy text-[10px] font-extrabold text-white">1</span>
            <h2 class="text-sm font-extrabold text-navy">Informasi Naskah Buku</h2>
          </div>
          <p class="text-xs text-slate-500 mt-0.5 ml-7">Masukkan judul karya dan kategori sastra yang sesuai.</p>
        </div>

        <div class="ml-7 space-y-4">
          <div>
            <label for="input-book-title" class="block text-xs font-bold text-navy mb-1.5">
              Judul Buku / Judul Kerja <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
              </span>
              <input
                id="input-book-title"
                type="text"
                required
                placeholder="Contoh: Lembayung Jogja"
                class="w-full rounded-xl border border-slate-300 bg-white pl-10 pr-4 py-2.5 text-xs font-semibold text-navy focus:border-navy focus:outline-none focus:ring-2 focus:ring-navy/5 shadow-2xs transition-all"
              />
            </div>
            <p class="mt-1 text-[11px] text-slate-400">Judul ini akan dicantumkan pada sampul dan halaman judul buku.</p>
          </div>

          <div>
            <label for="select-book-category" class="block text-xs font-bold text-navy mb-1.5">
              Kategori / Genre Sastra <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
              <select
                id="select-book-category"
                class="w-full appearance-none rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-xs font-semibold text-navy focus:border-navy focus:outline-none focus:ring-2 focus:ring-navy/5 shadow-2xs transition-all pr-10 cursor-pointer"
              >
                <option value="Novel Populer">Novel Populer (Metropop, Romance, Fantasi)</option>
                <option value="Teenlit & Young Adult">Teenlit & Young Adult (YA)</option>
                <option value="Kumpulan Cerpen Modern">Kumpulan Cerpen Modern & Flash Fiction</option>
                <option value="Prosa Liris & Puisi Estetik">Prosa Liris & Puisi Estetik</option>
                <option value="Novelet Grafis & Komik">Novelet Grafis, Komik & Webtoon</option>
                <option value="Naskah Skenario">Naskah Skenario (Film & Web Series)</option>
                <option value="Esai Personal & Memoar">Esai Personal & Memoar Modern</option>
                <option value="Karya Sastra Lainnya">Karya Sastra Lainnya</option>
              </select>
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3.5 text-slate-400">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 2. Unggah Berkas Naskah Digital -->
      <div class="border-t border-slate-100/90 pt-6 space-y-4">
        <div>
          <div class="flex items-center gap-2">
            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-navy text-[10px] font-extrabold text-white">2</span>
            <h2 class="text-sm font-extrabold text-navy">Unggah Berkas Naskah Digital</h2>
          </div>
          <p class="text-xs text-slate-500 mt-0.5 ml-7">Unggah naskah lengkap Anda dalam format digital.</p>
        </div>

        <div class="ml-7 space-y-3">
          <div
            id="dropzone"
            class="group flex flex-col items-center justify-center rounded-2xl border-2 border-dashed border-slate-300 bg-slate-50/60 p-8 text-center transition-all hover:border-orange hover:bg-orange/5 cursor-pointer"
          >
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-white border border-slate-200 text-orange shadow-xs group-hover:scale-105 transition-transform">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" /></svg>
            </div>
            <p class="mt-3 text-xs font-bold text-navy">
              Seret & letakkan berkas naskah ke sini, atau <span class="text-orange underline font-extrabold">Pilih Berkas</span>
            </p>
            <div class="mt-2 flex flex-wrap items-center justify-center gap-1.5 text-[10px] font-mono text-slate-500">
              <span class="rounded bg-white px-1.5 py-0.5 border border-slate-200">.PDF</span>
              <span class="rounded bg-white px-1.5 py-0.5 border border-slate-200">.DOCX</span>
              <span class="rounded bg-white px-1.5 py-0.5 border border-slate-200">.DOC</span>
              <span class="rounded bg-white px-1.5 py-0.5 border border-slate-200">.TXT</span>
              <span class="text-slate-400 font-sans ml-1">· Maksimal 50 MB</span>
            </div>
            <input id="file-input" type="file" accept=".pdf,.doc,.docx,.txt" class="hidden" />
          </div>

          <!-- File Upload Progress Card -->
          <div id="file-status-box" class="hidden rounded-2xl bg-white p-4 border border-slate-200 shadow-2xs">
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-orange/10 text-orange">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
              </div>
              <div class="min-w-0 flex-1">
                <div class="flex items-center justify-between text-xs">
                  <span id="file-name-label" class="font-extrabold text-navy truncate">naskah.docx</span>
                  <span id="file-size-label" class="font-mono text-slate-400 text-[11px]">0 KB</span>
                </div>
                <div id="upload-progress-bar-wrap" class="mt-2 hidden h-1.5 w-full rounded-full bg-slate-100 overflow-hidden">
                  <div id="upload-progress-bar" class="h-full bg-orange w-0 transition-all duration-300"></div>
                </div>
                <p id="file-upload-msg" class="mt-1 text-[11px] font-bold text-emerald-600">Siap diunggah</p>
              </div>
            </div>
          </div>

          <!-- Jaminan Hak Cipta & Keamanan -->
          <div class="flex items-start gap-2.5 text-[11px] leading-relaxed text-slate-500 pt-1">
            <svg class="h-4 w-4 shrink-0 text-orange mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <p>
              <strong class="text-navy font-bold">100% Hak Cipta Milik Anda:</strong> Berkas naskah otomatis terkunci secara aman. Jika Anda menarik naskah sebelum verifikasi, berkas akan terhapus permanen dari server.
            </p>
          </div>
        </div>
      </div>

      <!-- 3. Panduan Naskah Standar Novella -->
      <div class="border-t border-slate-100/90 pt-6 space-y-3">
        <div>
          <div class="flex items-center gap-2">
            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-navy text-[10px] font-extrabold text-white">3</span>
            <h2 class="text-sm font-extrabold text-navy">Panduan Format Berkas Naskah</h2>
          </div>
          <p class="text-xs text-slate-500 mt-0.5 ml-7">Tips persiapan naskah sebelum dicetak oleh tim redaksi.</p>
        </div>

        <div class="ml-7 grid gap-2.5 sm:grid-cols-2 text-xs">
          <div class="rounded-xl border border-slate-200 bg-slate-50/50 p-3">
            <p class="font-bold text-navy text-[11px]">Format Tipografi Sastra</p>
            <p class="text-[10px] text-slate-500 mt-1">Disarankan menggunakan font Garamond, Times New Roman, atau Book Antiqua (11-12 pt, spasi 1.15-1.5).</p>
          </div>
          <div class="rounded-xl border border-slate-200 bg-slate-50/50 p-3">
            <p class="font-bold text-navy text-[11px]">Kelengkapan Naskah</p>
            <p class="text-[10px] text-slate-500 mt-1">Pastikan naskah memuat Judul, Prakata/Pengantar, Daftar Isi, Isi Karya, dan Biodata Singkat Penulis.</p>
          </div>
        </div>
      </div>

      <p id="book-form-error" class="ml-7 text-xs font-bold text-rose-600 hidden"></p>
    </div>

    <!-- Sisi Kanan: Sticky Ringkasan Paket & CTA (5 Kolom / ~40%) -->
    <div class="lg:col-span-5 border-t lg:border-t-0 lg:border-l border-slate-200/80 lg:pl-10 pt-6 lg:pt-0 self-stretch">
      <div class="sticky top-20 space-y-5">
        <div>
          <span class="rounded-full bg-navy/10 px-3 py-1 text-xs font-bold text-navy">Ringkasan Paket Anda</span>
          <p id="book-summary-total" class="mt-4 font-serif text-3xl sm:text-4xl font-extrabold text-navy tracking-tight">Rp 150.000</p>
          <p id="book-summary-specs" class="mt-1 text-xs font-semibold text-slate-500">100 hal · 5 eks · A5</p>
        </div>

        <div class="divide-y divide-slate-100 text-xs text-slate-600 border-t border-b border-slate-100">
          <div class="py-2.5 flex justify-between font-semibold text-slate-800">
            <span>Standar Kualitas:</span>
            <span class="text-navy font-bold">Soft Cover Ivory 230/260</span>
          </div>
          <div class="py-2.5 flex justify-between font-semibold text-slate-800">
            <span>Layanan Tambahan:</span>
            <span id="book-summary-addons" class="text-orange font-bold truncate max-w-[170px] text-right">Standar</span>
          </div>
        </div>

        <div class="rounded-xl bg-slate-50 p-3 text-[11px] text-slate-600 leading-relaxed border border-slate-200/80">
          <p class="font-bold text-navy mb-0.5">Langkah Redaksi Berikutnya:</p>
          <p>Setelah berkas diunggah dan pesanan dikonfirmasi via WhatsApp, tim redaksi akan memeriksa tata letak dan memulai persiapan cetak.</p>
        </div>

        <div class="space-y-2 pt-2">
          <button
            type="submit"
            class="group flex w-full items-center justify-center gap-2 rounded-full bg-orange py-3.5 text-sm font-extrabold text-white shadow-md shadow-orange/20 transition-all hover:bg-orange-hover hover:scale-[1.01] active:scale-[0.99] cursor-pointer"
          >
            <span>Lanjut: Rincian Pembayaran</span>
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>

          <button
            id="btn-back-to-calc"
            type="button"
            class="w-full rounded-full border border-slate-200 bg-white py-2.5 text-xs font-bold text-slate-600 hover:border-slate-300 hover:bg-slate-50 transition-colors cursor-pointer text-center"
          >
            &larr; Ubah Format / Hitung Ulang
          </button>
        </div>
      </div>
    </div>
  </form>
</div>
