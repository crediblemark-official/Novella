---
/**
 * StudioStepper: Open Stepper Navigation Rail (Unboxed)
 * Features identifiable URLs for each publishing stage:
 * 1. /portal/kalkulator (Hitung Biaya & Format)
 * 2. /portal/naskah (Detail Buku & Berkas)
 * 3. /portal/pembayaran (Pembayaran & WA)
 */
---

<div id="wizard-stepper" class="border-b border-slate-200/80 pb-4 mb-8">
  <nav aria-label="Tahapan Penerbitan" class="flex items-center gap-2 sm:gap-6 text-xs font-bold overflow-x-auto">
    <a href="/portal/kalkulator" class="step-pill flex items-center gap-2 py-1 text-navy font-extrabold cursor-pointer transition-colors" data-step="1">
      <span class="flex h-5 w-5 items-center justify-center rounded-full bg-navy text-[10px] text-white">1</span>
      <span>Hitung Biaya & Format</span>
    </a>
    <span class="text-slate-300" aria-hidden="true">──</span>
    <a href="/portal/naskah" class="step-pill flex items-center gap-2 py-1 text-slate-400 cursor-pointer transition-colors" data-step="2">
      <span class="flex h-5 w-5 items-center justify-center rounded-full bg-slate-200 text-[10px] text-slate-600">2</span>
      <span>Detail Buku & Berkas</span>
    </a>
    <span class="text-slate-300" aria-hidden="true">──</span>
    <a href="/portal/pembayaran" class="step-pill flex items-center gap-2 py-1 text-slate-400 cursor-pointer transition-colors" data-step="3">
      <span class="flex h-5 w-5 items-center justify-center rounded-full bg-slate-200 text-[10px] text-slate-600">3</span>
      <span>Pembayaran & WA</span>
    </a>
  </nav>
</div>
