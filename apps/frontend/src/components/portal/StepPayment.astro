---
/**
 * StepPayment: Konfirmasi & Tindak Lanjut WhatsApp (Anti-Slop Editorial Split)
 * Flat hairline dividers, 44px touch targets, 1-2 word concise actions, zero box-in-box.
 */
---

<div id="step-pay" class="hidden w-full py-2">
  <div class="grid lg:grid-cols-12 gap-8 lg:gap-12">
    <!-- Sisi Kiri: Rincian & Aksi Konfirmasi (7 Kolom) -->
    <div class="lg:col-span-7 min-w-0 space-y-6">
      <div class="space-y-2">
        <div class="flex items-center justify-between gap-2">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 border border-emerald-200/70 px-2.5 py-0.5 text-[11px] font-bold text-emerald-700">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
            Pesanan Tercatat
          </span>
          <span id="pay-order-code" class="font-mono text-xs font-extrabold tracking-wider text-navy rounded-md bg-slate-100 px-2.5 py-1 border border-slate-200/80">Memuat...</span>
        </div>
        <h2 class="text-xl sm:text-2xl font-extrabold text-navy tracking-tight">Kirim Rincian ke Admin</h2>
        <p class="text-xs text-slate-500 leading-relaxed">Lanjutkan ke WhatsApp redaksi untuk pemeriksaan naskah dan penyesuaian akhir.</p>
      </div>

      <!-- Flat Hairline Rincian Pesanan (Anti-Box-in-Box) -->
      <div class="divide-y divide-slate-100 border-y border-slate-200/80 text-xs">
        <div class="py-3 flex items-center justify-between gap-4">
          <span class="font-semibold text-slate-500 shrink-0">Judul Naskah</span>
          <span id="pay-book-title" class="font-extrabold text-navy text-right truncate">-</span>
        </div>
        <div class="py-3 flex items-center justify-between gap-4">
          <span class="font-semibold text-slate-500 shrink-0">Spesifikasi</span>
          <span id="pay-specs" class="font-semibold text-slate-700 text-right truncate">100 hal · 5 eks · A5</span>
        </div>
        <div class="py-3.5 flex items-center justify-between gap-4">
          <span class="font-extrabold text-navy shrink-0">Estimasi Biaya</span>
          <div class="flex items-baseline gap-2">
            <span id="pay-total-badge" class="font-mono text-xl font-black tracking-wider text-orange">Rp 150.000</span>
            <span class="font-mono text-xs font-semibold text-slate-400 line-through">Rp 450.000</span>
          </div>
        </div>
      </div>

      <!-- Aksi Utama & Sekunder (44px Touch Targets, Zero Orphan Wrap) -->
      <div class="space-y-2.5 pt-1">
        <a
          id="btn-open-wa-consultation"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="flex w-full min-h-[48px] items-center justify-center gap-2 rounded-full bg-emerald-600 py-3.5 px-5 text-sm font-extrabold text-white shadow-md shadow-emerald-600/20 hover:bg-emerald-700 transition-all duration-150 hover:scale-[1.01] active:scale-[0.98] cursor-pointer"
        >
          <svg class="h-4.5 w-4.5 shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z" />
          </svg>
          <span>Kirim ke WhatsApp</span>
        </a>

        <div class="grid grid-cols-2 gap-2.5">
          <button
            id="btn-back-to-calc"
            type="button"
            class="flex min-h-[44px] items-center justify-center gap-1.5 rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-xs font-bold text-slate-600 hover:border-slate-300 hover:text-navy transition-all active:scale-[0.98] whitespace-nowrap cursor-pointer"
          >
            <svg class="h-3.5 w-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
            <span>Ubah Rincian</span>
          </button>
          <button
            id="btn-view-author-history"
            type="button"
            class="flex min-h-[44px] items-center justify-center gap-1.5 rounded-xl border border-orange/30 bg-orange/5 px-3 py-2.5 text-xs font-bold text-orange hover:bg-orange/10 transition-all active:scale-[0.98] whitespace-nowrap cursor-pointer"
          >
            <span>Riwayat</span>
            <svg class="h-3.5 w-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Sisi Kanan: Rekening Resmi Penerbit (5 Kolom Hairline Docked) -->
    <div class="lg:col-span-5 min-w-0 border-t lg:border-t-0 lg:border-l border-slate-200/80 lg:pl-10 pt-6 lg:pt-0 space-y-3">
      <div>
        <h3 class="text-sm font-extrabold text-navy tracking-tight">Rekening Resmi Penerbit</h3>
        <p class="text-[11px] text-slate-500 mt-0.5 leading-relaxed">Transfer administrasi dilakukan hanya setelah rincian disepakati bersama admin.</p>
      </div>
      <div id="payment-bank-accounts" class="divide-y divide-slate-100 border-y border-slate-200/80">
        <div class="text-center text-xs text-slate-400 py-4">Memuat data rekening...</div>
      </div>
    </div>
  </div>
</div>
