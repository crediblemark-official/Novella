# Novella.id Backend Configuration
PORT=3001

# Database PostgreSQL Eksternal (Dokploy / Managed Postgres)
DATABASE_URL=postgres://postgres:password@host:5432/novella

# Better Auth
BETTER_AUTH_SECRET=novella_super_secret_auth_key_2026_at_least_32_chars
BETTER_AUTH_URL=http://localhost:3001

# Google OAuth 2.0 Credentials (Dapatkan dari Google Cloud Console: APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GDriveS3 Object Storage
S3_ENDPOINT=https://s3.novella.id
S3_BUCKET=novella-manuscripts
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key

# ImageKit (Book Cover CDN)
IMAGEKIT_PUBLIC_KEY=your-imagekit-public-key
IMAGEKIT_PRIVATE_KEY=your-imagekit-private-key
